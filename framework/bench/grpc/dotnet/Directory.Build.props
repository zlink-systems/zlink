<Project>
    <Import Project="../../../languages/dotnet/Directory.Build.props" />

    <PropertyGroup>
        <_ZLinkGrpcBenchFrameworkProjects>;WithGrpcBench.Client;WithGrpcBench.ZLinkServer;</_ZLinkGrpcBenchFrameworkProjects>
        <DefineConstants Condition="'$(ZLinkDotnetLadderLevel)' == 'L0'">$(DefineConstants);ZLINK_DOTNET_LADDER_L0</DefineConstants>
        <DefineConstants Condition="'$(ZLinkDotnetLadderLevel)' == 'L1'">$(DefineConstants);ZLINK_DOTNET_LADDER_L1</DefineConstants>
        <DefineConstants Condition="'$(ZLinkDotnetLadderLevel)' == 'L2'">$(DefineConstants);ZLINK_DOTNET_LADDER_L2</DefineConstants>
        <DefineConstants Condition="'$(ZLinkDotnetLadderLevel)' == 'L3'">$(DefineConstants);ZLINK_DOTNET_LADDER_L3</DefineConstants>
        <DefineConstants Condition="'$(ZLinkDotnetLadderLevel)' == 'L4'">$(DefineConstants);ZLINK_DOTNET_LADDER_L4</DefineConstants>
        <DefineConstants Condition="'$(ZLinkDotnetLadderLevel)' == 'L5_7'">$(DefineConstants);ZLINK_DOTNET_LADDER_L1;ZLINK_DOTNET_LADDER_L2;ZLINK_DOTNET_LADDER_L3;ZLINK_DOTNET_LADDER_L4;ZLINK_DOTNET_LADDER_L5_7</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ZLinkFrameworkReference Include="Zlink.Framework" Condition="$(_ZLinkGrpcBenchFrameworkProjects.Contains(';$(MSBuildProjectName);'))" />
        <ZLinkFrameworkReference Include="Zlink.Framework.AspNetCore" Condition="$(_ZLinkGrpcBenchFrameworkProjects.Contains(';$(MSBuildProjectName);'))" />
        <ZLinkFrameworkReference Include="Zlink.Framework.Codecs.Protobuf" Condition="$(_ZLinkGrpcBenchFrameworkProjects.Contains(';$(MSBuildProjectName);'))" />
    </ItemGroup>

    <Import Project="../../../languages/dotnet/props/ZLink.FrameworkReference.props" />
</Project>
