<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>12.0</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../../../../languages/dotnet/src/Shared/ZLinkJsonSerializerOptions.cs" Link="Codec/ZLinkJsonSerializerOptions.cs"/>
        <Compile Include="../../../../languages/dotnet/src/Shared/ZLinkFrameworkJsonDocument.cs" Link="Codec/ZLinkFrameworkJsonDocument.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf"/>
        <PackageReference Include="Grpc.Core.Api"/>
        <PackageReference Include="Grpc.Tools" PrivateAssets="all"/>
        <Protobuf Include="..\..\proto\bench.proto" Link="Protos\bench.proto" GrpcServices="Both"/>
    </ItemGroup>
</Project>
