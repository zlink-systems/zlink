<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="Java benchmark compilation" provider="zlink">
  <event name="jdk.Compilation">
    <setting name="enabled">true</setting>
    <setting name="threshold">0 ns</setting>
  </event>
  <event name="jdk.DataLoss"><setting name="enabled">true</setting></event>
  <event name="jdk.ActiveSetting"><setting name="enabled">true</setting></event>
  <event name="jdk.Deoptimization">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
  </event>
  <event name="measure.MonotonicAnchor">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">false</setting>
  </event>
  <event name="measure.Phase">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">false</setting>
  </event>
</configuration>
