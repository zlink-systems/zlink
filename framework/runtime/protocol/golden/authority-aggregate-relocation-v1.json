  "spec": "framework/doc/framework/common/spec/server/05-location-relocation/01-location-runtime.ko.md \u00a73.4 aggregate, aggregate.relocation (#4995, #5041, #5379)",
  "notes": {
    "shape": "value of the authority record's `aggregate` JSON field. Writers must produce JSON that parses to exactly this value (member order free); readers must accept 'accept' cases preserving every field on re-write and reject 'reject' cases.",
    "integers": "64-bit integers are decimal strings; marker.index is a JSON number",
    "matrix": "cross-language test: each language's real provider writer produces these accept values, every other language's reader reads them back and re-writes them unchanged (4x4)",
    "completion": "aggregate.relocation has no completion field since #5379; captured-request replies live in per-request Location Store rows (01-location-runtime \u00a79.3). Readers reject a relocation object carrying completion or any other unknown field."
  },
