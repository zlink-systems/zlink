{
  "format": "relocation-completion-record-v1",
  "consumers": [
    "cpp",
    "dotnet",
    "jvm",
    "node"
  ],
  "spec": "framework/doc/framework/common/spec/server/05-location-relocation/01-location-runtime.ko.md §9.3 (PR #5041)",
  "notes": {
    "encoding": "RFC 8785 canonical JSON, UTF-8. Writers must produce bytesBase64 exactly for accept cases; readers must accept accept cases and reject reject cases.",
    "integers": "decimal strings, no sign, no leading zeros",
    "operationId": "big-endian 16 bytes as 32 lowercase hex, non-zero",
    "replyRouteId": "non-zero u64 as decimal string",
    "reply": "RFC 4648 section 4 standard base64 with padding, no line breaks",
    "order": "entries in UTF-8 authority-key byte order of objectKey, then source acceptance order within one object",
    "authorityCounts": "completedResults = entries length, pendingDeliveries = entries with delivery pending; compare with aggregate.relocation.completion, mismatch is DataLost"
  },
  "cases": [
