{
  "fixture": "zlink.framework.route-mesh-placement",
  "version": 1,
  "rules": {
    "activeCountSource": "reportingMeshNodeActivationRecords",
    "locationStoreProjectionIsActiveCountSource": false,
    "hostWideDrainRemainderIsSeparateFact": true,
    "limitZeroMeansUnlimited": true,
    "capacityCountsActivePlusReserved": true,
    "isAvailableCapacity": "activationConcurrencyAndActorOrSpotHeadroom",
    "isAvailableRequiresRelocationCapability": false,
    "isAvailableRequiresPositivePlacementWeight": true,
    "activationAdmissionOperations": [
      "actorCreate",
      "userSpotCreate",
      "instanceSpotColdActivation",
      "relocationTargetRestore"
    ],
    "activationAdmissionExcludes": [
      "entrySpot",
      "actorJoin"
    ]
  },
  "ownerLease": {
    "renewIntervalMs": 50,
    "renewTimeoutMs": 100,
    "ttlMs": 1000,
    "fencingMarginMs": 200
  },
  "scenarios": [
    {
      "name": "user-spot-on-first-mesh-node",
      "locationStore": "available",
      "meshNodes": [
        {
          "meshName": "game",
          "placementWeightAfterStartup": 100,
          "actorLimit": 0,
          "spotLimit": 1,
          "actorFactory": false,
          "spotRelocation": "disabled",
          "activationConcurrency": 128,
          "instanceSpotFactory": false
        },
        {
          "meshName": "lobby",
          "placementWeightAfterStartup": 100,
          "actorLimit": 0,
          "spotLimit": 1,
          "actorFactory": false,
          "spotRelocation": "disabled",
          "activationConcurrency": 128,
          "instanceSpotFactory": false
        }
      ],
      "objects": [
        {
          "kind": "userSpot",
          "meshName": "game",
          "count": 1,
          "hold": false
        }
      ],
      "expected": [
        {
          "meshName": "game",
          "activeActorCount": 0,
          "activeSpotCount": 1,
          "isAvailable": true,
          "state": "ready"
        },
        {
          "meshName": "lobby",
          "activeActorCount": 0,
          "activeSpotCount": 0,
          "isAvailable": true,
          "state": "ready"
        }
      ]
    },
