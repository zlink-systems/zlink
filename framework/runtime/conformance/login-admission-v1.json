{
  "fixture": "zlink.framework.login-admission",
  "version": 1,
  "status": "approved-design-fixture-runtime-not-yet-implemented",
  "contract": {
    "settings": {
      "AuthenticationPacketName": null,
      "MaxConcurrentAuthentications": "effectiveCpuCores * 8",
      "AuthenticationRetryDelay": 500
    },
    "retryMetadataKey": "$zlink.admission.retryAfter",
    "retryValueFormat": "utcUnixEpochMillisecondsDecimalString",
    "errorBody": {
      "code": "unavailable",
      "message": "Authentication admission is full."
    },
    "connector": {
      "maxAdmissionWaitDefault": "effectiveRequestTimeout",
      "jitterMinMs": 0,
      "jitterMaxMs": 50,
      "correlation": "preserved",
      "requestSequence": "newPerAttempt",
      "waitingCallback": "OnAdmissionWaiting",
      "deadline": "min(originalRequestDeadline, firstWaitingAt + maxAdmissionWait)"
    },
    "serviceWireChanges": false
  },
  "terminalReasons": [
    "replySuccess",
    "replyFailure",
    "handlerException",
    "cancellation",
    "enqueueRejected",
    "callbackWithoutReply",
    "shutdown"
  ],
