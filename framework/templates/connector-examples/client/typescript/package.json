{
  "name": "connector-example-typescript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "browser": "npm run build && esbuild dist/browser.js --bundle --outfile=dist/browser.bundle.js --servedir=. --serve=127.0.0.1:8000",
