    },
    {
      "id": "l7",
      "type": "external",
      "label": "L7 LB",
      "row": 1,
      "col": 0,
      "sublabel": "HTTP"
    },
    {
      "id": "api",
      "type": "frontend",
      "label": "api node ×N",
