flowchart LR
    %% 명시적 Protobuf 응답 타입
    %% 응답 bytes를 받은 뒤 Pong 클래스로 디코딩
    request["client request<br/>Ping instance"]:::app
    server["server<br/>Pong bytes"]:::infra
    encoded["submitEncoded()<br/>encoded reply"]:::spot
    decode["fromProto()<br/>Pong instance"]:::app
    request -->|"request: Ping"| server
    server -->|"response: Pong"| encoded
    encoded -->|"type: Pong"| decode
    classDef infra fill:#edf0f5,stroke:#6b7c99,color:#253247;
    classDef spot fill:#d9faec,stroke:#0eb989,color:#253247;
    classDef app fill:#dff8ff,stroke:#0eafd0,color:#253247;
