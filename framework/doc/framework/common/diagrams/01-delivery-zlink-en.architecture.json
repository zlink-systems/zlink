{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "ZLink approach — web service + real-time",
    "subtitle": "HTTP orders and live delivery status",
    "output": "01-delivery-zlink-en.html",
    "legend": {
      "mode": "hidden"
    }
  },
  "layout": {
    "mode": "grid",
    "origin": [
      50,
      150
    ],
    "cols": 4,
    "gapX": 72,
    "gapY": 100,
    "cellW": 132,
    "cellH": 60
  },
  "components": [
    {
      "id": "client",
      "type": "external",
      "label": "Client app",
      "row": 0,
      "col": 0
    },
    {
      "id": "l4",
      "type": "external",
      "label": "L4",
      "row": 0,
      "col": 1
    },
    {
      "id": "session",
      "type": "database",
      "label": "session node ×N",
      "row": 0,
      "col": 2,
      "sublabel": "WebSocket"
    },
    {
      "id": "play",
      "type": "backend",
      "label": "play node ×N",
      "row": 0,
      "col": 3,
      "sublabel": "Instance Spot"
    },
    {
      "id": "l7",
      "type": "external",
      "label": "L7 LB",
      "row": 1,
      "col": 0,
      "sublabel": "HTTP"
    },
    {
      "id": "api",
      "type": "frontend",
      "label": "api node ×N",
      "row": 1,
      "col": 3,
      "sublabel": "orders · reads"
    },
    {
      "id": "store",
      "type": "external",
      "label": "location store",
      "row": 1,
      "col": 2
    }
  ],
  "connections": [
    {
      "from": "client",
      "to": "l4"
    },
    {
      "from": "l4",
      "to": "session"
    },
    {
      "from": "session",
      "to": "play",
      "label": "relay · push"
    },
    {
      "from": "client",
      "to": "l7"
    },
    {
      "from": "l7",
      "to": "api",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "from": "api",
      "to": "play"
    },
    {
      "from": "play",
      "to": "api",
      "fromSide": "right",
      "toSide": "right",
      "label": "client/server"
    },
    {
      "from": "session",
      "to": "store",
      "variant": "dashed"
    },
    {
      "from": "api",
      "to": "store",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Delivery requests and status updates",
      "items": [
        "HTTP order and read requests reach the api node through L7. The Instance Spot that owns order state runs on a play node.",
        "WebSocket connections reach a session node through L4. The session node delivers status changes from the play node to its clients.",
        "The play node can request reads and writes from the api node. The location store resolves server addresses.",
        "The play node is the Client that calls the api node, which is the Server on the ZLink ClientServer Channel."
      ]
    }
  ]
}
