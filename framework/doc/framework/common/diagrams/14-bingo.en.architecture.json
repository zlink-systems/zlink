{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Bingo — a typical online game server configuration",
    "subtitle": "split into a connection gateway · auth/matching · room servers",
    "output": "14-bingo.en.html",
    "legend": { "mode": "hidden" }
  },
  "layout": { "mode": "grid", "origin": [50, 150], "cols": 5, "gapX": 80, "gapY": 92, "cellW": 120, "cellH": 60 },
  "components": [
    { "id": "P", "type": "backend", "label": "Play ×2", "sublabel": "player actor · room Spot", "row": 0, "col": 2 },
    { "id": "LS", "type": "external", "label": "Location Store", "row": 1, "col": 2 },
    { "id": "R", "type": "database", "label": "Redis", "sublabel": "waiting-room reservation", "row": 1, "col": 4 },
    { "id": "C", "type": "frontend", "label": "client", "row": 2, "col": 0 },
    { "id": "S", "type": "external", "label": "Session ×2", "sublabel": "endpoint · actor bind", "row": 2, "col": 1 },
    { "id": "A", "type": "external", "label": "Api ×2", "sublabel": "auth · matching requests", "row": 2, "col": 3 },
    { "id": "M", "type": "backend", "label": "Matchmaking", "sublabel": "Matchmaker Instance Spot", "row": 2, "col": 4 }
  ],
  "connections": [
    { "from": "C", "to": "S", "label": "1 STREAM", "variant": "emphasis" },
    { "from": "S", "to": "A", "label": "auth/matching request", "variant": "default", "labelDy": 40 },
    { "from": "A", "to": "M", "label": "level bucket matching", "variant": "default", "labelDy": -40 },
    { "from": "M", "to": "R", "variant": "default" },
    { "from": "S", "to": "P", "label": "packet relay", "variant": "default", "labelDx": -18 },
    { "from": "P", "to": "S", "label": "session push", "variant": "default", "labelDx": 18, "fromSide": "left", "toSide": "top" },
    { "from": "A", "to": "P", "label": "room GetOrCreate", "variant": "default", "labelDx": 18 },
    { "from": "S", "to": "LS", "variant": "dashed" },
    { "from": "A", "to": "LS", "variant": "dashed" },
    { "from": "P", "to": "LS", "label": "peer auto-connect", "variant": "dashed", "labelDx": 48, "labelDy": 34 }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "gateway configuration",
      "items": [
        "client ↔ Session is one STREAM connection (bidirectional, emphasis) — client keeps only one, to Session",
        "Session·Api·Play each scale out ×2, server-to-server connections resolved by Location Store",
        "Session→Api matching request → Api matches a Matchmaker Instance Spot by level bucket"
      ]
    },
    {
      "dot": "emerald",
      "title": "matching · room · push",
      "items": [
        "Matchmaker Instance Spot atomically decides waiting-room reservations against Redis",
        "Api room GetOrCreate → Session packet relay, Play pushes to the bound session",
        "even when player actor and room Spot live on different Play servers the framework does a remote Spot join, location by LS auto-connect (dashed)"
      ]
    }
  ]
}
