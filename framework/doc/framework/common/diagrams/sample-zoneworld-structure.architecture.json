  "meta": {
    "title": "구현 구조 — Client · Shared · Server",
    "subtitle": "모든 언어가 같은 logical component를 같은 책임으로 구현한다 (Gateway=session·relay, ZoneNode=zone Spot·Player Actor, Ops=node watch·fanout)",
    "output": "sample-zoneworld-structure.html",
    "legend": { "mode": "hidden" }
  },
  "layout": { "mode": "grid", "origin": [50, 160], "cols": 4, "gapX": 84, "gapY": 84, "cellW": 120, "cellH": 60 },
  "components": [
    { "id": "cl-prog", "type": "frontend", "label": "Program", "row": 0, "col": 0 },
    { "id": "cl-scen", "type": "frontend", "label": "HeadlessScenario", "row": 0, "col": 1 },
    { "id": "cl-game", "type": "frontend", "label": "BrowserGame", "row": 0, "col": 2 },
    { "id": "cl-ops", "type": "frontend", "label": "BrowserOps", "row": 0, "col": 3 },

    { "id": "sh-conf", "type": "external", "label": "Configuration", "row": 1, "col": 0 },
    { "id": "sh-json", "type": "external", "label": "JSON Contracts", "row": 1, "col": 1 },
    { "id": "sh-rules", "type": "external", "label": "WorldRules", "row": 1, "col": 2 },

    { "id": "gw-prog", "type": "external", "label": "Program", "row": 2, "col": 0 },
    { "id": "gw-app", "type": "external", "label": "Application", "sublabel": "PlayerBinding·PlayerRelay", "row": 2, "col": 1 },
    { "id": "gw-infra", "type": "external", "label": "Infrastructure", "sublabel": "StreamSession·Handlers", "row": 2, "col": 2 },

    { "id": "zn-prog", "type": "backend", "label": "Program", "row": 3, "col": 0 },
    { "id": "zn-dom", "type": "backend", "label": "Domain", "sublabel": "ZoneState·PlayerView·Border", "row": 3, "col": 1 },
    { "id": "zn-app", "type": "backend", "label": "Application", "sublabel": "Movement·Admission·BotTick", "row": 3, "col": 2 },
    { "id": "zn-infra", "type": "backend", "label": "Infrastructure", "sublabel": "EntrySpot·ZoneSpot·+4 more", "row": 3, "col": 3 },

    { "id": "ops-prog", "type": "external", "label": "Program", "row": 4, "col": 0 },
    { "id": "ops-app", "type": "external", "label": "Application", "sublabel": "NodeWatch·Announce·+2 more", "row": 4, "col": 1 },
    { "id": "ops-infra", "type": "external", "label": "Infrastructure", "sublabel": "OpsStream·+3 more", "row": 4, "col": 2 }
  ],
  "boundaries": [
    { "kind": "region", "label": "Client", "wraps": ["cl-prog", "cl-scen", "cl-game", "cl-ops"] },
    { "kind": "region", "label": "Shared", "wraps": ["sh-conf", "sh-json", "sh-rules"] },
    { "kind": "region", "label": "Server / Gateway — session·relay", "wraps": ["gw-prog", "gw-app", "gw-infra"] },
    { "kind": "region", "label": "Server / ZoneNode — zone Spot·Player Actor", "wraps": ["zn-prog", "zn-dom", "zn-app", "zn-infra"] },
    { "kind": "region", "label": "Server / Ops — node watch·fanout·maintenance", "wraps": ["ops-prog", "ops-app", "ops-infra"] }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "전체 트리 경로와 색",
      "items": [
        "루트 ZoneWorld의 top-level 3개: Client { Program, HeadlessScenario, BrowserGame, BrowserOps } · Shared { Configuration, JSON Contracts, WorldRules } · Server { Gateway, ZoneNode, Ops }.",
        "색: Client=파랑(frontend, browser·headless adapter), Shared·Gateway·Ops=회색(external, 공통 자산과 session·relay·control-plane plumbing), ZoneNode=초록(backend, zone Spot·Player Actor를 제공하는 계층)."
      ]
    },
    {
      "dot": "slate",
      "title": "Server / Gateway·Ops 하위 전체 경로",
      "items": [
        "Gateway { Program, Application { PlayerBinding, PlayerRelay }, Infrastructure { StreamSession, GatewayHandlers } }.",
        "Ops { Program, Application { NodeWatch, AnnounceWorld, Maintenance, Diagnostics }, Infrastructure { OpsStream, RuntimeEventCollector, FanoutPublisher, MaintenanceStoreAdapter } }."
      ]
    },
    {
      "dot": "slate",
      "title": "Server / ZoneNode 하위 전체 경로",
      "items": [
        "ZoneNode { Program, Domain { ZoneState, PlayerStateView, BorderPolicy }, Application { Movement, ZoneAdmission, BotTick }, Infrastructure { EntrySpot, ZoneSpot, PlayerActorAdapter, RelocationAdapter, BorderPublisher, LocalReportHandler } }."
      ]
    }
  ]
}
