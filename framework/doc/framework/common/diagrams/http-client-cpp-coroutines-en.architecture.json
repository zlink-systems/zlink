{"schema_version":1,"diagram_type":"architecture","meta":{"title":"C++ coroutine execution and resumption","subtitle":"Separate the HTTP-work scheduler from the continuation scheduler","output":"http-client-cpp-coroutines-en.html","legend":{"mode":"hidden"}},"layout":{"mode":"grid","origin":[50,150],"cols":5,"gapX":90,"gapY":82,"cellW":120,"cellH":60},"components":[{"id":"request","type":"frontend","label":"terminator","sublabel":"request builder","row":0,"col":0},{"id":"execute","type":"backend","label":"execute scheduler","sublabel":"HTTP work","row":0,"col":1},{"id":"response","type":"external","label":"HTTP response","row":0,"col":2},{"id":"resume","type":"backend","label":"resume scheduler","sublabel":"continuation","row":0,"col":3},{"id":"caller","type":"frontend","label":"co_await caller","row":0,"col":4}],"connections":[{"from":"request","to":"execute","variant":"default"},{"from":"execute","to":"response","variant":"default"},{"from":"response","to":"resume","variant":"default"},{"from":"resume","to":"caller","variant":"default"}],"cards":[{"dot":"cyan","title":"Roles of the two schedulers","items":["The request-builder terminator registers HTTP work on the execute scheduler; once the response is ready, the resume scheduler resumes the co_await caller's continuation."]}]}
