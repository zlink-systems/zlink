  "cards": [
    {
      "dot": "cyan",
      "title": "Client and Shared",
      "items": [
        "Client/Program configures the HTTP client and stream connector and starts the scenario; Client/Scenario creates the room, authenticates, joins, moves, observes, leaves, and self-checks.",
        "Shared/Configuration fixes the Api/Play role, manual endpoint, Channel, and runner marker; Shared/JSON Contracts owns the HTTP, stream, room, milestone, and state wire declarations."
      ]
    },
    {
      "dot": "violet",
      "title": "Server / Api (full names)",
      "items": [
        "Api/Program; Api/Application → CreateGame, AuthenticatePlayer; Api/Infrastructure → HttpHandlers, UserSourceAdapter, SpotManagerAdapter, HandlerRegistration.",
        "Api owns HTTP and the user source and doesn't change board, turn, or room membership."
      ]
    },
    {
      "dot": "emerald",
      "title": "Server / Play (full names)",
      "items": [
        "Play/Program; Play/Domain → Board, Match, TurnPolicy; Play/Application → JoinGame, PlaceMark, LeaveGame, MilestonePublisher.",
        "Play/Infrastructure → StreamSession, EntrySpot, PlayerActorRelocationAdapter, RoomSpot, MulticastHandlers, StoreProviders, HandlerRegistration.",
        "Domain computes board and winner and doesn't reference ZLink types, the stream connector, or a Redis client; Infrastructure wires stream, actor, Spot, both Stores, and Logical Multicast."
      ]
    }
  ]
}
