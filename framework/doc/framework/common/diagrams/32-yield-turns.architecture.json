    { "id": "async-wait", "type": "backend", "label": "turn A 대기", "sublabel": "gate 유지", "row": 1, "col": 1 },
    { "id": "async-next", "type": "messagebus", "label": "turn B", "sublabel": "queue에서 대기", "row": 1, "col": 2 },
    { "id": "yield-turn", "type": "backend", "label": "turn A", "sublabel": "Yield로 요청", "row": 3, "col": 0 },
    { "id": "yield-next", "type": "messagebus", "label": "turn B", "sublabel": "gate를 받아 실행", "row": 3, "col": 1 },
    { "id": "yield-resume", "type": "backend", "label": "turn A 재개", "sublabel": "queue 끝의 새 turn", "row": 3, "col": 2 },
