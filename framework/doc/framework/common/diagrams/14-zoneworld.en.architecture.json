    { "id": "Z1", "type": "backend", "label": "A — zone Spot", "sublabel": "player actor", "row": 2, "col": 0 },
    { "id": "Z2", "type": "backend", "label": "B — zone Spot", "sublabel": "player actor", "row": 2, "col": 2 },
    { "id": "OPS", "type": "external", "label": "Ops", "sublabel": "runtime event · fanout", "row": 3, "col": 1 },
    { "id": "BO", "type": "frontend", "label": "ops screen", "sublabel": "browser", "row": 4, "col": 1 }
