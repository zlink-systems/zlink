    { "id": "S", "type": "external", "label": "Session" },
    { "id": "OA", "type": "backend", "label": "Obs Actor" },
    { "id": "OR", "type": "backend", "label": "Observer Room" },
    { "id": "GR", "type": "backend", "label": "Game Room" },
    {"id": "O2", "type": "frontend", "label": "Late Observer"},
    {"id": "S2", "type": "external", "label": "Session 2"},
    {"id": "OA2", "type": "backend", "label": "Obs Actor 2"}
  ],
  "messages": [
    { "from": "O", "to": "S", "y": 160, "label": "ObserveBingoEventsReq", "variant": "default" },
    { "from": "S", "to": "OA", "y": 208, "label": "Relay through binding", "variant": "default" },
    { "from": "OA", "to": "OR", "y": 256, "label": "Join observed RoomId", "variant": "default" },
    { "from": "OR", "to": "OA", "y": 304, "label": "Subscribed", "variant": "return" },
    { "from": "OA", "to": "S", "y": 352, "label": "ObserveBingoEventsRes", "variant": "return" },
    { "from": "S", "to": "O", "y": 400, "label": "ObserveBingoEventsRes", "variant": "return" },
    { "from": "GR", "to": "OR", "y": 448, "label": "BingoRewardAcquiredEvent (publish to bingo.room.reward)", "variant": "return" },
    { "from": "OR", "to": "OA", "y": 496, "label": "BingoRewardAnnouncedNotify", "variant": "return" },
    { "from": "OA", "to": "S", "y": 544, "label": "BingoRewardAnnouncedNotify", "variant": "return" },
    { "from": "S", "to": "O", "y": 592, "label": "BingoRewardAnnouncedNotify", "variant": "return" },
    { "from": "O", "to": "S", "y": 640, "label": "StopObservingBingoEventsReq", "variant": "default" },
    { "from": "S", "to": "OA", "y": 688, "label": "Relay through binding", "variant": "default" },
