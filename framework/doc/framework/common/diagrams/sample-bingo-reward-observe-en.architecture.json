  "meta": {
    "title": "Reward observation",
    "subtitle": "the game room publishes the reward · the observer's local room forwards it as a bound push, then the observer stops",
    "output": "sample-bingo-reward-observe-en.html",
    "column_fit": "spread",
    "viewBox": [1040, 1280],
    "legend": { "mode": "hidden" }
  },
  "participants": [
