  "cards": [
    {
      "dot": "cyan",
      "title": "api node",
      "items": [
        "The HTTP endpoint (for example, POST /games) receives requests. A channel client calls a node handler over a ClientServer channel or an Instance Spot over a RouteMesh channel.",
        "Spot and Actor clients address a Spot or Actor by ID.",
        "The play node is the Client that calls the api node, which is the Server on the ZLink ClientServer Channel."
      ]
    },
    {
      "dot": "emerald",
      "title": "play node",
      "items": [
        "An Entry Spot assigns participants, and User Spots and Actors handle game messages. A play node can request matchmaking or data reads and writes from an api node.",
        "The dashed line indicates endpoint lookup through the Location Store."
      ]
    }
  ]
