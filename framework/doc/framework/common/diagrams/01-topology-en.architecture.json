  "cards": [
    {
      "dot": "cyan",
      "title": "Layout",
      "items": [
        "Entry server: receives an external request over ASP.NET Core HTTP and delegates to the domain server",
        "Domain server: MeshNode channel membership + SPOT + session relay + stream node",
        "Client app: requests over HTTP, receives real-time state over stream"
      ]
    },
    {
      "dot": "slate",
      "title": "Location store = discovery only",
      "items": [
        "Manages only server address info — the dotted lines are connections that find an endpoint via a store lookup (not a data path)"
