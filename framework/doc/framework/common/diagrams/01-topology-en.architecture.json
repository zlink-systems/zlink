  "cards": [
    {
      "dot": "cyan",
      "title": "What leaves the API server",
      "items": [
        "channel client — calls by name. A ClientServer channel when one handler settles it, a RouteMesh channel when a unit of state must take it",
        "spot client — calls a Spot by id",
        "actor client — calls an Actor by id"
      ]
    },
    {
      "dot": "amber",
      "title": "The session server",
      "items": [
        "The STREAM node takes the client connection, relays the session, and passes it to a spot's actor over a RouteMesh channel",
        "It can live in the domain server, but that is not the usual shape — connection count and state throughput grow separately"
      ]
    },
    {
      "dot": "slate",
      "title": "Location store = discovery only",
      "items": [
        "It keeps server addresses only. The dashed lines are store lookups that find an endpoint, not a data path"
      ]
    }
  ]
}
