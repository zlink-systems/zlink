{"schema_version":1,"diagram_type":"architecture","meta":{"title":"C++ coroutine 실행과 재개","subtitle":"HTTP work scheduler와 continuation scheduler를 분리","output":"http-client-cpp-coroutines.html","legend":{"mode":"hidden"}},"layout":{"mode":"grid","origin":[50,150],"cols":5,"gapX":90,"gapY":82,"cellW":120,"cellH":60},"components":[{"id":"request","type":"frontend","label":"terminator","sublabel":"request builder","row":0,"col":0},{"id":"execute","type":"backend","label":"execute scheduler","sublabel":"HTTP work","row":0,"col":1},{"id":"response","type":"external","label":"HTTP response","row":0,"col":2},{"id":"resume","type":"backend","label":"resume scheduler","sublabel":"continuation","row":0,"col":3},{"id":"caller","type":"frontend","label":"co_await caller","row":0,"col":4}],"connections":[{"from":"request","to":"execute","variant":"default"},{"from":"execute","to":"response","variant":"default"},{"from":"response","to":"resume","variant":"default"},{"from":"resume","to":"caller","variant":"default"}],"cards":[{"dot":"cyan","title":"두 scheduler의 역할","items":["request builder terminator가 HTTP 작업을 execute scheduler에 등록하고, 응답이 준비되면 resume scheduler가 co_await caller의 continuation을 재개한다."]}]}
