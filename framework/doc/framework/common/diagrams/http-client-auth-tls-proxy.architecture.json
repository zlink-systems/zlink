{"schema_version":1,"diagram_type":"architecture","meta":{"title":"인증·TLS·proxy 경로","subtitle":"대상 인증과 proxy 인증을 분리하고 HTTPS는 target까지 TLS","output":"http-client-auth-tls-proxy.html","legend":{"mode":"hidden"}},"layout":{"mode":"grid","origin":[50,150],"cols":5,"gapX":110,"gapY":82,"cellW":120,"cellH":60},"components":[{"id":"request","type":"frontend","label":"request builder","row":0,"col":0},{"id":"auth","type":"frontend","label":"Authorization","sublabel":"target 인증","row":0,"col":1},{"id":"client","type":"backend","label":"HTTP client","row":0,"col":2},{"id":"proxyAuth","type":"frontend","label":"Proxy-Authorization","row":2,"col":0},{"id":"proxy","type":"external","label":"HTTP proxy","row":2,"col":2},{"id":"ca","type":"frontend","label":"trusted certs","row":2,"col":3},{"id":"mtls","type":"frontend","label":"mTLS client cert","row":1,"col":4},{"id":"tls","type":"backend","label":"TLS to target","row":1,"col":3},{"id":"api","type":"external","label":"target HTTP API","row":0,"col":4}],"connections":[{"from":"request","to":"auth","variant":"default"},{"from":"auth","to":"client","variant":"default"},{"from":"client","to":"api","variant":"default","label":"direct HTTP"},{"from":"client","to":"tls","variant":"default","label":"direct HTTPS"},{"from":"client","to":"proxy","variant":"default","label":"proxy","labelDy":24},{"from":"proxyAuth","to":"proxy","variant":"dashed"},{"from":"proxy","to":"api","variant":"default","label":"HTTP target","fromSide":"right","toSide":"bottom"},{"from":"proxy","to":"tls","variant":"default","label":"CONNECT"},{"from":"ca","to":"tls","variant":"dashed"},{"from":"mtls","to":"tls","variant":"dashed"},{"from":"tls","to":"api","variant":"default"}],"cards":[{"dot":"cyan","title":"인증과 암호화 경계","items":["Authorization은 target에, Proxy-Authorization은 HTTP proxy에만 전달된다.","HTTPS direct 연결과 proxy CONNECT 뒤 연결은 모두 target까지 TLS를 사용하며 trusted certificate와 mTLS client certificate가 이 경로에 적용된다."]}]}
