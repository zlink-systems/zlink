{
  "samples": {
    "Bingo": {
      "routeMeshes": ["bingo.matchmaking", "bingo.play"],
      "clientServer": ["bingo.api"],
      "objectRoles": {
        "Api": {
          "bingo.matchmaking": "Client",
          "bingo.play": "Client"
        },
        "Matchmaking": {
          "bingo.matchmaking": "Server"
        },
        "Session": {
          "bingo.play": "Client"
        },
        "Play": {
          "bingo.play": "Server"
        }
      },
      "instanceSpots": {
        "bingo.matchmaker": {
          "mesh": "bingo.matchmaking",
          "callers": ["Api"],
          "providers": ["Matchmaking"]
        }
      },
      "channels": {
        "bingo.api": {"clients": ["Session", "Play"], "servers": ["Api"]},
        "bingo.room": {"clients": [], "servers": ["Play"]}
      },
      "channelKinds": {
        "bingo.api": "ClientServer",
        "bingo.room": "RouteMesh"
      }
    },
    "TicTacToe": {
      "routeMeshes": ["tictactoe"],
      "clientServer": ["tictactoe.api"],
      "objectRoles": {
        "ApiA": {"tictactoe": "Client"},
        "ApiB": {"tictactoe": "Client"},
        "PlayA": {"tictactoe": "Server"},
        "PlayB": {"tictactoe": "Server"}
      },
      "manualPeerInitiators": {
        "ApiA": ["PlayA", "PlayB"],
        "ApiB": ["PlayA", "PlayB"],
        "PlayA": ["PlayB"]
      },
      "channels": {
        "tictactoe.api": {"clients": ["PlayA", "PlayB"], "servers": ["ApiA", "ApiB"]},
        "tictactoe.player.milestone.channel": {
          "clients": [],
          "servers": ["PlayA", "PlayB"]
        }
      },
      "channelKinds": {
        "tictactoe.api": "ClientServer",
        "tictactoe.player.milestone.channel": "RouteMesh"
      }
    },
