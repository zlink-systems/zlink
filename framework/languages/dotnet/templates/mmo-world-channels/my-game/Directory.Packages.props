    <PackageVersion Include="Zlink.Framework.Locations.Redis" Version="0.30.1" />
    <PackageVersion Include="Zlink.Stream.Connector" Version="0.30.1" />
    <PackageVersion Include="StackExchange.Redis" Version="2.8.31" />
  </ItemGroup>
</Project>
