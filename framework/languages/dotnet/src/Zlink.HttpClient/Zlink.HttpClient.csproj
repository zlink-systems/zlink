<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ZLinkFrameworkTargetFrameworks)</TargetFrameworks>
        <AssemblyName>Zlink.HttpClient</AssemblyName>
        <PackageId>Zlink.HttpClient</PackageId>
        <RootNamespace>Zlink.HttpClient</RootNamespace>
        <Description>ZLink-style fluent HTTP client wrapping System.Net.Http for the ZLink framework.</Description>
        <IsPackable>true</IsPackable>
        <PackageLicenseFile></PackageLicenseFile>
        <!-- Overrides Directory.Build.props: this package wraps System.Net.Http rather
             than any zlink-original transport, so it ships under Apache-2.0 instead of
             the framework-wide FSL. -->
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <Authors>zlink</Authors>
        <RepositoryUrl>https://github.com/zlink-systems/zlink</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/zlink-systems/zlink</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
        <ProjectReference Include="../Zlink.Framework.Contracts/Zlink.Framework.Contracts.csproj"/>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Zlink.HttpClient.UnitTests"/>
    </ItemGroup>
</Project>
