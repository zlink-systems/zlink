        <Compile Include="Handlers/HandlerContracts.cs"/>
        <Compile Include="Eventing/EventingContracts.cs"/>
        <Compile Include="Errors/ErrorContracts.cs"/>
        <Compile Include="Spots/InstanceSpotContracts.cs"/>
