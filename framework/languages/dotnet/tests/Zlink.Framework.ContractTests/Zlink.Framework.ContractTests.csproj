        <ProjectReference Include="../../src/Zlink.Framework.Provider.Abstractions/Zlink.Framework.Provider.Abstractions.csproj"/>
        <ProjectReference Include="../../src/Zlink.HttpClient/Zlink.HttpClient.csproj"/>
        <ProjectReference Include="../../src/Systems.Zlink.Stream.Connector/Systems.Zlink.Stream.Connector.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="AssemblyInfo.cs"/>
        <Compile Include="Actors/ActorContracts.cs"/>
        <Compile Include="Actors/ActorFactoryContracts.cs"/>
        <Compile Include="Channels/ChannelContracts.cs"/>
        <Compile Include="Codecs/CodecContracts.cs"/>
