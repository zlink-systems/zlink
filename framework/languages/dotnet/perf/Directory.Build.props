<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ZLinkSampleFrameworkVersion>$(ZLINK_PERF_FRAMEWORK_VERSION)</ZLinkSampleFrameworkVersion>
    <ZLinkSampleUseLocalSource Condition="'$(ZLINK_PERF_PACKAGE_SOURCE)' == 'local'">true</ZLinkSampleUseLocalSource>
    <ZLinkSampleUseLocalSource Condition="'$(ZLINK_PERF_PACKAGE_SOURCE)' != 'local'">false</ZLinkSampleUseLocalSource>
    <ZLinkPropsDir>$(MSBuildThisFileDirectory)../props/</ZLinkPropsDir>
    <!-- The repository's local package feed must not satisfy a published-package restore. -->
    <RestoreAdditionalProjectSources Condition="'$(ZLinkSampleUseLocalSource)' != 'true'"></RestoreAdditionalProjectSources>
    <_ZLinkPerfFrameworkProjects>;ZLink.Framework.Perf.ServerSupport;</_ZLinkPerfFrameworkProjects>
    <_ZLinkPerfContractsProjects>;ZLink.Framework.Perf.Shared;</_ZLinkPerfContractsProjects>
    <_ZLinkPerfAspNetCoreProjects>;ZLink.Framework.Perf.ServerSupport;</_ZLinkPerfAspNetCoreProjects>
    <_ZLinkPerfRedisProjects>;ZLink.Framework.Perf.ServerSupport;</_ZLinkPerfRedisProjects>
    <_ZLinkPerfConnectorProjects>;ZLink.Framework.Perf.Shared;ZLink.Framework.Perf.Client;</_ZLinkPerfConnectorProjects>
  </PropertyGroup>
  <ItemGroup>
    <ZLinkFrameworkReference Include="Zlink.Framework" Condition="$(_ZLinkPerfFrameworkProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.Framework.AspNetCore" Condition="$(_ZLinkPerfAspNetCoreProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.Framework.Locations.Redis" Condition="$(_ZLinkPerfRedisProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.Framework.Contracts" Condition="$(_ZLinkPerfContractsProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.Stream.Connector" Condition="$(_ZLinkPerfConnectorProjects.Contains(';$(MSBuildProjectName);'))" />
  </ItemGroup>
  <Import Project="$(ZLinkPropsDir)ZLink.FrameworkReference.props" />
  <Target Name="ValidateZLinkPerfBuildInputs" BeforeTargets="Restore;CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(ZLINK_PERF_FRAMEWORK_VERSION)' == ''"
           Text="ZLINK_PERF_FRAMEWORK_VERSION is required for .NET perf builds." />
    <Error Condition="'$(ZLINK_PERF_PACKAGE_SOURCE)' != '' and '$(ZLINK_PERF_PACKAGE_SOURCE)' != 'published' and '$(ZLINK_PERF_PACKAGE_SOURCE)' != 'local'"
           Text="ZLINK_PERF_PACKAGE_SOURCE must be 'published' or 'local'." />
  </Target>
</Project>
