<Project>
  <Import Project="../Directory.Packages.props"
          Condition="Exists('$(MSBuildThisFileDirectory)../src/Zlink.Framework/Zlink.Framework.csproj') and Exists('$(MSBuildThisFileDirectory)../Directory.Packages.props')" />

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <ZLinkSampleRepositoryDetected Condition="Exists('$(MSBuildThisFileDirectory)../src/Zlink.Framework/Zlink.Framework.csproj')">true</ZLinkSampleRepositoryDetected>
    <ZLinkSampleRepositoryDetected Condition="'$(ZLinkSampleRepositoryDetected)' == ''">false</ZLinkSampleRepositoryDetected>
    <ZLinkSampleFrameworkVersionFile Condition="'$(ZLinkSampleRepositoryDetected)' == 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../VERSION'))</ZLinkSampleFrameworkVersionFile>
    <ZLinkSampleBindingsVersionFile Condition="'$(ZLinkSampleRepositoryDetected)' == 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../bindings/dotnet/VERSION'))</ZLinkSampleBindingsVersionFile>
    <ZLinkSampleFrameworkVersion Condition="'$(ZLinkSampleFrameworkVersion)' == '' and '$(ZLinkSampleRepositoryDetected)' == 'true' and Exists('$(ZLinkSampleFrameworkVersionFile)')">$([System.IO.File]::ReadAllText('$(ZLinkSampleFrameworkVersionFile)').Trim().Replace('ZLINK_FRAMEWORK_VERSION=', ''))</ZLinkSampleFrameworkVersion>
    <ZLinkBindingsPackageVersion Condition="'$(ZLinkBindingsPackageVersion)' == '' and '$(ZLinkSampleRepositoryDetected)' == 'true' and Exists('$(ZLinkSampleBindingsVersionFile)')">$([System.IO.File]::ReadAllText('$(ZLinkSampleBindingsVersionFile)').Trim().Replace('ZLINK_BINDING_VERSION=', ''))</ZLinkBindingsPackageVersion>
    <ZLinkBindingsPackageVersion Condition="'$(ZLinkBindingsPackageVersion)' == ''">0.18.0</ZLinkBindingsPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Zlink.Framework" Version="$(ZLinkSampleFrameworkVersion)" />
    <PackageVersion Include="Zlink.Framework.AspNetCore" Version="$(ZLinkSampleFrameworkVersion)" />
    <PackageVersion Include="Zlink.Framework.Locations.Redis" Version="$(ZLinkSampleFrameworkVersion)" />
    <PackageVersion Include="Zlink.Framework.Codecs.Protobuf" Version="$(ZLinkSampleFrameworkVersion)" />
    <PackageVersion Include="Zlink.Stream.Connector" Version="$(ZLinkSampleFrameworkVersion)" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)../src/Zlink.Framework/Zlink.Framework.csproj')">
    <PackageVersion Include="Zlink" Version="$(ZLinkBindingsPackageVersion)" />
    <PackageVersion Include="Zlink.HttpClient" Version="$(ZLinkSampleFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.29.1" />
    <PackageVersion Include="Grpc.Tools" Version="2.62.0" />
    <PackageVersion Include="StackExchange.Redis" Version="2.8.31" />
  </ItemGroup>
</Project>
