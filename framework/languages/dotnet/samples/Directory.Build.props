<Project>
  <Import Project="../Directory.Build.props"
          Condition="Exists('$(MSBuildThisFileDirectory)../src/Zlink.Framework/Zlink.Framework.csproj') and Exists('$(MSBuildThisFileDirectory)../Directory.Build.props')" />

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ZLinkPropsDir Condition="Exists('$(MSBuildThisFileDirectory)props/ZLink.FrameworkReference.props')">$(MSBuildThisFileDirectory)props/</ZLinkPropsDir>
    <ZLinkPropsDir Condition="'$(ZLinkPropsDir)' == ''">$(MSBuildThisFileDirectory)../props/</ZLinkPropsDir>

    <_ZLinkSampleStreamConnectorProjects>;Bingo.Client;DeliveryDispatch.Client;DeliveryDispatch.Server.CourierSession;DeliveryDispatch.Server.CustomerGateway;GameQuest.Client;GameQuest.GameApi;ShoppingMall.Client;SupportChat.Client;SupportChat.Server.Session;TicTacToe.Client;TicTacToe.Server.Configuration;ZoneWorld.Client;</_ZLinkSampleStreamConnectorProjects>
    <_ZLinkSampleFrameworkProjects>;Bingo.Server.Api;Bingo.Server.Configuration;Bingo.Server.Matchmaking;Bingo.Server.Play;Bingo.Server.Session;DeliveryDispatch.Client;DeliveryDispatch.Server.Configuration;DeliveryDispatch.Server.CourierActorNode;DeliveryDispatch.Server.CourierSession;DeliveryDispatch.Server.CustomerGateway;DeliveryDispatch.Server.Dispatch;DeliveryDispatch.Server.Tracking;DeliveryDispatch.Shared;GameQuest.Client;GameQuest.GameApi;GameQuest.QuestMission;GameQuest.Server.Configuration;ShoppingMall.Client;ShoppingMall.CommerceApi;ShoppingMall.OrderWorkflow;ShoppingMall.Server.Configuration;SupportChat.Server.Api;SupportChat.Server.Configuration;SupportChat.Server.Session;SupportChat.Server.Support;TicTacToe.Client;TicTacToe.Server.Configuration;ZoneWorld.Server.Gateway;ZoneWorld.Server.Ops;ZoneWorld.Server.ZoneNode;</_ZLinkSampleFrameworkProjects>
    <_ZLinkSampleServerIntegrationProjects>;Bingo.Server.Api;Bingo.Server.Matchmaking;Bingo.Server.Play;Bingo.Server.Session;DeliveryDispatch.Server.CourierActorNode;DeliveryDispatch.Server.CourierSession;DeliveryDispatch.Server.CustomerGateway;DeliveryDispatch.Server.Dispatch;DeliveryDispatch.Server.Tracking;GameQuest.GameApi;GameQuest.QuestMission;ShoppingMall.CommerceApi;ShoppingMall.OrderWorkflow;SupportChat.Server.Api;SupportChat.Server.Session;SupportChat.Server.Support;TicTacToe.Server.Configuration;ZoneWorld.Server.Gateway;ZoneWorld.Server.Ops;ZoneWorld.Server.ZoneNode;</_ZLinkSampleServerIntegrationProjects>
    <_ZLinkSampleProtobufProjects>;Bingo.Client;Bingo.Server.Api;Bingo.Server.Matchmaking;Bingo.Server.Play;Bingo.Server.Session;</_ZLinkSampleProtobufProjects>
    <_ZLinkSampleHttpClientProjects>;DeliveryDispatch.Client;GameQuest.Client;ShoppingMall.Client;ShoppingMall.CommerceApi;TicTacToe.Client;</_ZLinkSampleHttpClientProjects>
  </PropertyGroup>

  <ItemGroup>
    <ZLinkFrameworkReference Include="Zlink.Stream.Connector" Condition="$(_ZLinkSampleStreamConnectorProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.Framework" Condition="$(_ZLinkSampleFrameworkProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.Framework.AspNetCore" Condition="$(_ZLinkSampleServerIntegrationProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.Framework.Locations.Redis" Condition="$(_ZLinkSampleServerIntegrationProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.Framework.Codecs.Protobuf" Condition="$(_ZLinkSampleProtobufProjects.Contains(';$(MSBuildProjectName);'))" />
    <ZLinkFrameworkReference Include="Zlink.HttpClient" Condition="$(_ZLinkSampleHttpClientProjects.Contains(';$(MSBuildProjectName);'))" />
  </ItemGroup>

  <!-- Package-or-source decision and the published versions: one shared device with perf. -->
  <Import Project="$(ZLinkPropsDir)ZLink.FrameworkReference.props" />
</Project>
