        {
          "path": "raw/b8-reference/logs/session-route-proxy-gateway.log",
          "selector": "blocked-command-44"
        }
      ],
      "typed_or_state_oracle": {
        "kind": "typed-state",
        "assert": "reconnect JoinWorldRes reports target zone for same actor"
      }
    }
  ]
}
