{
  "name": "@zlink-systems/sample-deliverydispatch-ts",
  "version": "0.10.0",
  "private": true,
  "main": "dist/Client/main.js",
  "scripts": {
    "prebuild": "node scripts/prepare-dependencies.mjs",
    "sample": "node scripts/run-sample.mjs Runner/sample-runner.mjs",
    "browser:install": "playwright install chromium",
    "generate:framework-json": "node scripts/generate-framework-json.mjs --project tsconfig.json --source Shared/Contracts --out dist/.zlink-framework-json-schemas.cjs --browser-out dist/browser/.zlink-framework-json-schemas.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.browser.json && npm run generate:framework-json && esbuild Client/main.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/browser/client.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.22",
    "@zlink-systems/framework": "0.11.0",
    "@zlink-systems/framework-locations-redis": "0.11.0",
    "@zlink-systems/nestjs": "0.11.0",
    "@zlink-systems/stream-connector": "0.11.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.25.6",
    "playwright": "^1.61.1",
    "typescript": "^5.8.3"
  }
}
