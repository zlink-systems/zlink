{
  "version": 1,
  "id": "board-tables",
  "name": "my-game",
  "language": "node",
  "run": {
    "commands": {
      "sh": ["./run-e2e.sh --build-only", "./run-e2e.sh", "./run-e2e.sh --scenario table,reconnect"],
      "powershell": [
        "pwsh -NoProfile -File ./run-e2e.ps1 -BuildOnly",
        "pwsh -NoProfile -File ./run-e2e.ps1",
        "pwsh -NoProfile -File ./run-e2e.ps1 -Scenario table,reconnect"
      ]
    },
    "scenarios": ["table", "reconnect", "update"]
  },
  "nodes": [
    {
      "id": "players",
      "role": "external",
      "title": "Players",
      "config": null
    },
    {
      "id": "session",
      "role": "session",
      "title": "Session server",
      "config": "server/config/session.json"
    },
    {
      "id": "playA",
      "role": "table",
      "title": "Play server A",
      "config": "server/config/play-a.json"
    },
    {
      "id": "playB",
      "role": "table",
      "title": "Play server B",
      "config": "server/config/play-b.json"
    },
    {
      "id": "location",
      "role": "location-store",
      "title": "Location Store",
      "config": "docker-compose.yml"
    }
  ],
  "channels": [],
  "spots": [
    {
      "id": "table-entry-a",
      "kind": "entry",
      "type": null,
      "owner": "playA"
    },
    {
      "id": "table-entry-b",
      "kind": "entry",
      "type": null,
      "owner": "playB"
    },
    {
      "id": "table",
      "kind": "user",
      "type": "Table",
      "owner": "playA",
      "dynamic": true
    }
  ],
  "edges": [
    {
      "to": "session",
      "label": "STREAM",
      "from": "players"
    },
    {
      "to": "playA",
      "label": "relay",
      "from": "session"
    },
    {
      "to": "location",
      "label": "Location / lease",
      "semantic": "location-authority",
      "from": "playA"
    }
  ]
}
