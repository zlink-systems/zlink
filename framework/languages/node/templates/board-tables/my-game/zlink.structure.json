{
  "version": 1,
  "id": "board-tables",
  "name": "my-game",
  "language": "node",
  "run": {
    "commands": {
      "sh": [
        "./run-server.sh",
        "./run-e2e.sh --build-only",
        "./run-e2e.sh",
        "./run-e2e.sh --scenario match,match-cancel"
      ],
      "powershell": [
        ".\\run-server.cmd",
        ".\\run-e2e.cmd -BuildOnly",
        ".\\run-e2e.cmd",
        ".\\run-e2e.cmd -Scenario match,match-cancel"
      ]
    },
    "scenarios": ["table", "reconnect", "match", "match-cancel", "update", "persist"]
  },
  "nodes": [
    {
      "id": "players",
      "role": "external",
      "title": "Players",
      "config": null
    },
    {
      "id": "session",
      "role": "session",
      "title": "Session node",
      "config": "server/config/session.json"
    },
    {
      "id": "tableA",
      "role": "table",
      "title": "Table node A",
      "config": "server/config/table-a.json"
    },
    {
      "id": "tableB",
      "role": "table",
      "title": "Table node B",
      "config": "server/config/table-b.json"
    },
    {
      "id": "matchmaker",
      "role": "matchmaker",
      "title": "Matchmaker node",
      "config": "server/config/matchmaker.json"
    },
    {
      "id": "api",
      "role": "api",
      "title": "API node (Actor DB)",
      "config": "server/config/api.json"
    },
    {
      "id": "location",
      "role": "location-store",
      "title": "Location Store",
      "config": "docker-compose.yml"
    }
  ],
  "channels": [
    {
      "name": "my-game-player-records",
      "kind": "clientServer",
      "owner": "api",
      "clients": ["tableA", "tableB"]
    }
  ],
  "spots": [
    {
      "id": "table-entry-a",
      "kind": "entry",
      "type": null,
      "owner": "tableA"
    },
    {
      "id": "table-entry-b",
      "kind": "entry",
      "type": null,
      "owner": "tableB"
    },
    {
      "id": "table",
      "kind": "user",
      "type": "Table",
      "owner": "tableA",
      "dynamic": true
    },
    {
      "id": "pool",
      "kind": "instance",
      "type": "Pool",
      "owner": "matchmaker",
      "logicalId": "pool-board"
    }
  ],
  "edges": [
    {
      "to": "session",
      "label": "STREAM",
      "from": "players"
    },
    {
      "to": "tableA",
      "label": "relay",
      "from": "session"
    },
    {
      "to": "matchmaker",
      "label": "MatchRequest",
      "from": "tableA"
    },
    {
      "to": "tableA",
      "label": "PrepareRoom",
      "from": "matchmaker"
    },
    {
      "to": "location",
      "label": "Location / lease",
      "semantic": "location-authority",
      "from": "tableA"
    },
    {
      "to": "api",
      "label": "LoadPlayer / CommitRound",
      "from": "tableA"
    },
    {
      "to": "api",
      "label": "LoadPlayer / CommitRound",
      "from": "tableB"
    },
    {
      "from": "api",
      "to": "location",
      "label": "Player records"
    }
  ]
}
