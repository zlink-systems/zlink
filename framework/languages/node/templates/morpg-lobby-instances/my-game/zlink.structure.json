{
  "version": 1,
  "id": "morpg-lobby-instances",
  "name": "my-game",
  "language": "node",
  "run": {
    "commands": {
      "sh": [
        "./run-server.sh",
        "./run-e2e.sh --build-only",
        "./run-e2e.sh",
        "./run-e2e.sh --scenario lobby,party,reconnect,update"
      ],
      "powershell": [
        ".\\run-server.cmd",
        ".\\run-e2e.cmd -BuildOnly",
        ".\\run-e2e.cmd",
        ".\\run-e2e.cmd -Scenario lobby,party,reconnect,update"
      ]
    },
    "scenarios": ["lobby", "party", "reconnect", "update", "dungeon-leave"]
  },
  "nodes": [
    {
      "id": "players",
      "role": "external",
      "title": "Players",
      "config": null
    },
    {
      "id": "session",
      "role": "session",
      "title": "Session node",
      "config": "server/config/session.json"
    },
    {
      "id": "lobby",
      "role": "lobby",
      "title": "Play node (party lobby)",
      "config": "server/config/lobby.json"
    },
    {
      "id": "instanceA",
      "role": "instance",
      "title": "Play node A (dungeon)",
      "config": "server/config/instanceA.json"
    },
    {
      "id": "instanceB",
      "role": "instance",
      "title": "Play node B (dungeon)",
      "config": "server/config/instanceB.json"
    },
    {
      "id": "location",
      "role": "location-store",
      "title": "Redis",
      "config": "docker-compose.yml"
    }
  ],
  "channels": [],
  "spots": [
    {
      "id": "entry",
      "kind": "entry",
      "type": null,
      "owner": "lobby"
    },
    {
      "id": "instanceA-entry",
      "kind": "entry",
      "type": null,
      "owner": "instanceA"
    },
    {
      "id": "instanceB-entry",
      "kind": "entry",
      "type": null,
      "owner": "instanceB"
    },
    {
      "id": "party",
      "kind": "user",
      "type": "Party",
      "owner": "lobby",
      "dynamic": true
    },
    {
      "id": "dungeon",
      "kind": "user",
      "type": "Dungeon",
      "owner": "instanceA",
      "dynamic": true
    }
  ],
  "edges": [
    {
      "from": "players",
      "to": "session",
      "label": "STREAM"
    },
    {
      "from": "session",
      "to": "lobby",
      "label": "relay"
    },
    {
      "from": "lobby",
      "to": "instanceA",
      "label": "GetOrCreate"
    },
    {
      "from": "lobby",
      "to": "location",
      "label": "Location / lease",
      "semantic": "location-authority"
    }
  ]
}
