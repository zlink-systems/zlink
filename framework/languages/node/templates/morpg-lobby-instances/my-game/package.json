{
  "name": "my-game",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/generate-framework-json-schemas.mjs --project tsconfig.json --source server/shared --out dist/.zlink-framework-json-schemas.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node dist/e2e/runner.js",
    "test": "node --test dist/e2e/party-state.test.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@zlink-systems/framework": "0.30.1",
    "@zlink-systems/framework-locations-redis": "0.30.1",
    "@zlink-systems/nestjs": "0.30.1",
    "@zlink-systems/stream-connector": "0.30.1",
    "@zlink-systems/zlink": "1.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/sdk-logs": "0.221.0"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.1",
    "prettier": "3.6.2"
  }
}
