{
  "version": 1,
  "id": "board-tables",
  "name": "my-game",
  "language": "cpp",
  "run": {
    "commands": {
      "sh": [
        "./run-server.sh",
        "./run-e2e.sh --build-only",
        "./run-e2e.sh",
        "./run-e2e.sh --scenario table,reconnect,update",
        "./run-e2e.sh --scenario match,match-cancel,persist"
      ],
      "powershell": [
        "pwsh -NoProfile -File ./run-server.ps1",
        "pwsh -NoProfile -File ./run-e2e.ps1 -BuildOnly",
        "pwsh -NoProfile -File ./run-e2e.ps1",
        "pwsh -NoProfile -File ./run-e2e.ps1 -Scenario table,reconnect,update",
        "pwsh -NoProfile -File ./run-e2e.ps1 -Scenario match,match-cancel,persist"
      ],
      "cmd": [
        ".\\run-server.cmd",
        ".\\run-e2e.cmd",
        ".\\run-e2e.cmd -Scenario match,match-cancel,persist"
      ]
    },
    "scenarios": [
      "table",
      "reconnect",
      "match",
      "match-cancel",
      "persist",
      "update"
    ]
  },
  "nodes": [
    {
      "id": "players",
      "role": "external",
      "title": "Players",
      "config": null
    },
    {
      "id": "session",
      "role": "session",
      "title": "Session node",
      "config": "server/config/session.json"
    },
    {
      "id": "tableA",
      "role": "table",
      "title": "Play node A (table)",
      "config": "server/config/table-a.json"
    },
    {
      "id": "tableB",
      "role": "table",
      "title": "Play node B (table)",
      "config": "server/config/table-b.json"
    },
    {
      "id": "matchmaker",
      "role": "matchmaker",
      "title": "Matchmaker node",
      "config": "server/config/matchmaker.json"
    },
    {
      "id": "api",
      "role": "api",
      "title": "API node (player records)",
      "config": "server/config/api.json"
    },
    {
      "id": "location",
      "role": "location-store",
      "title": "Location Store",
      "config": "docker-compose.yml"
    }
  ],
  "channels": [
    {
      "name": "my-game-player-records",
      "owner": "tableA",
      "kind": "client-server",
      "role": "client"
    },
    {
      "name": "my-game-player-records",
      "owner": "tableB",
      "kind": "client-server",
      "role": "client"
    },
    {
      "name": "my-game-player-records",
      "owner": "api",
      "kind": "client-server",
      "role": "server"
    }
  ],
  "spots": [
    {
      "id": "table-entry-a",
      "kind": "entry",
      "type": null,
      "owner": "tableA"
    },
    {
      "id": "table-entry-b",
      "kind": "entry",
      "type": null,
      "owner": "tableB"
    },
    {
      "id": "table",
      "kind": "user",
      "type": "Table",
      "owner": "tableA",
      "dynamic": true
    },
    {
      "id": "board-pool",
      "kind": "instance",
      "type": "Pool",
      "owner": "matchmaker",
      "logicalId": "pool-board"
    },
    {
      "id": "room-provisioner",
      "kind": "instance",
      "type": "RoomProvisioner",
      "owner": "tableA",
      "logicalId": "room-provisioner-board"
    }
  ],
  "edges": [
    {
      "from": "players",
      "to": "session",
      "label": "STREAM"
    },
    {
      "from": "session",
      "to": "tableA",
      "label": "relay"
    },
    {
      "from": "tableA",
      "to": "location",
      "label": "Location / lease",
      "semantic": "location-authority"
    },
    {
      "from": "tableA",
      "to": "matchmaker",
      "label": "MatchRequest / EnterReport"
    },
    {
      "from": "matchmaker",
      "to": "tableA",
      "label": "PrepareRoom / CommitRoom"
    },
    {
      "from": "matchmaker",
      "to": "location",
      "label": "Location / lease",
      "semantic": "location-authority"
    },
    {
      "from": "tableA",
      "to": "matchmaker",
      "label": "RoomPrepared"
    },
    {
      "from": "tableA",
      "to": "api",
      "label": "loadPlayer / commitRound"
    },
    {
      "from": "tableB",
      "to": "api",
      "label": "loadPlayer / commitRound"
    },
    {
      "from": "api",
      "to": "location",
      "label": "Player records"
    }
  ]
}
