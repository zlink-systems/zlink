{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/.zlink/manifest",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.zlink/vcpkg_installed",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.zlink/install"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja, Release)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos",
      "displayName": "macOS (Ninja, Release)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64, Release)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_CXX_FLAGS": "/EHsc /utf-8 /bigobj /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_WIN32_WINNT=0x0A00",
        "CMAKE_CXX_FLAGS_RELEASE": "/MD /Od /DNDEBUG"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Release" }
  ]
}
