@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(zlink @ZLINK_FRAMEWORK_CPP_ZLINK_CORE_VERSION@ EXACT CONFIG
  PATHS "${CMAKE_CURRENT_LIST_DIR}/../zlink" NO_DEFAULT_PATH)
if(NOT TARGET zlink::cpp)
  include("${CMAKE_CURRENT_LIST_DIR}/../zlink_cpp/zlink_cppTargets.cmake")
  if(TARGET libzlink)
    set(_zlink_cpp_core_target libzlink)
  elseif(TARGET libzlink-static)
    set(_zlink_cpp_core_target libzlink-static)
  else()
    message(FATAL_ERROR "The bundled zlink package exports no supported Core target")
  endif()
  set_property(TARGET zlink::cpp APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES "${_zlink_cpp_core_target}")
  unset(_zlink_cpp_core_target)
endif()
find_dependency(Threads)
find_dependency(nlohmann_json)
find_dependency(Boost)
@ZLINK_STREAM_CONNECTOR_EXPORT_OPENSSL_DEPENDENCY@
set(_zlink_saved_module_path "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
@ZLINK_STREAM_CONNECTOR_EXPORT_LZ4_DEPENDENCY@
set(CMAKE_MODULE_PATH "${_zlink_saved_module_path}")
unset(_zlink_saved_module_path)
include("${CMAKE_CURRENT_LIST_DIR}/zlink_stream_connector_cppTargets.cmake")
