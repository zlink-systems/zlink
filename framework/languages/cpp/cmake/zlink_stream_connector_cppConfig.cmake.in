@PACKAGE_INIT@

get_filename_component(
  ZLINK_STREAM_CONNECTOR_CPP_PACKAGE_PREFIX
  "${CMAKE_CURRENT_LIST_DIR}/../../../"
  ABSOLUTE)

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(nlohmann_json)
@ZLINK_STREAM_CONNECTOR_EXPORT_OPENSSL_DEPENDENCY@

if(NOT TARGET libzlink)
  if(WIN32)
    set(ZLINK_STREAM_CONNECTOR_CPP_CORE_IMPORT_LIBRARY
      "${ZLINK_STREAM_CONNECTOR_CPP_PACKAGE_PREFIX}/lib/zlink.lib")
    if(NOT EXISTS "${ZLINK_STREAM_CONNECTOR_CPP_CORE_IMPORT_LIBRARY}")
      set(ZLINK_STREAM_CONNECTOR_CPP_CORE_IMPORT_LIBRARY
        "${ZLINK_STREAM_CONNECTOR_CPP_PACKAGE_PREFIX}/lib/libzlink.lib")
    endif()
    if(NOT EXISTS "${ZLINK_STREAM_CONNECTOR_CPP_CORE_IMPORT_LIBRARY}")
      set(ZLINK_STREAM_CONNECTOR_CPP_CORE_IMPORT_LIBRARY
        "${ZLINK_STREAM_CONNECTOR_CPP_PACKAGE_PREFIX}/lib/libzlink.dll.a")
    endif()
    if(NOT EXISTS "${ZLINK_STREAM_CONNECTOR_CPP_CORE_IMPORT_LIBRARY}")
      message(FATAL_ERROR
        "The installed stream connector package has no Core import library")
    endif()
    add_library(libzlink SHARED IMPORTED)
    set_target_properties(libzlink PROPERTIES
      IMPORTED_LOCATION "${ZLINK_STREAM_CONNECTOR_CPP_PACKAGE_PREFIX}/bin/zlink.dll"
      IMPORTED_IMPLIB "${ZLINK_STREAM_CONNECTOR_CPP_CORE_IMPORT_LIBRARY}")
  elseif(APPLE)
    add_library(libzlink SHARED IMPORTED)
    set_target_properties(libzlink PROPERTIES
      IMPORTED_LOCATION "${ZLINK_STREAM_CONNECTOR_CPP_PACKAGE_PREFIX}/lib/libzlink.dylib")
  else()
    add_library(libzlink SHARED IMPORTED)
    set_target_properties(libzlink PROPERTIES
      IMPORTED_LOCATION "${ZLINK_STREAM_CONNECTOR_CPP_PACKAGE_PREFIX}/lib/libzlink.so")
  endif()
endif()
if(NOT TARGET zlink::cpp)
  include("${CMAKE_CURRENT_LIST_DIR}/../zlink_cpp/zlink_cppTargets.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/zlink_stream_connector_cppTargets.cmake")
if(TARGET zlink::stream_connector_cpp_lz4)
  set_property(TARGET zlink::stream_connector_cpp_lz4 PROPERTY
    INTERFACE_LINK_LIBRARIES
    "${ZLINK_STREAM_CONNECTOR_CPP_PACKAGE_PREFIX}/@CMAKE_INSTALL_LIBDIR@/@ZLINK_LZ4_LIBRARY_NAME@")
endif()
