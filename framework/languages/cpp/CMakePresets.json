    {
      "name": "vs2022",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Debug"
    },
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "linux-ninja-debug",
      "configurePreset": "linux-ninja-debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-ninja-release",
      "configurePreset": "linux-ninja-release",
      "configuration": "Release"
    },
    {
      "name": "linux-ninja-vcpkg-debug",
      "configurePreset": "linux-ninja-vcpkg-debug",
      "configuration": "Debug"
    },
    {
      "name": "macos-ninja-debug",
      "configurePreset": "macos-ninja-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-vcpkg-debug",
      "configurePreset": "windows-msvc-vcpkg-debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "linux-ninja",
      "configurePreset": "linux-ninja",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja",
