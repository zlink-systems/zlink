{
  "version": 1,
  "id": "board-tables",
  "name": "my-game",
  "language": "java",
  "run": {
    "commands": {
      "sh": [
        "./run-server.sh",
        "./run-e2e.sh --build-only",
        "./run-e2e.sh",
        "./run-e2e.sh --scenario table,reconnect,match,match-cancel,persist,update"
      ],
      "powershell": [
        ".\\run-server.cmd",
        ".\\run-e2e.cmd -BuildOnly",
        ".\\run-e2e.cmd",
        ".\\run-e2e.cmd -Scenario table,reconnect,match,match-cancel,persist,update"
      ]
    },
    "scenarios": [
      "table",
      "reconnect",
      "match",
      "match-cancel",
      "persist",
      "update"
    ]
  },
  "nodes": [
    {
      "id": "players",
      "role": "external",
      "title": "Players",
      "config": null
    },
    {
      "id": "session",
      "role": "session",
      "title": "Session node",
      "config": "server/config/session.json"
    },
    {
      "id": "playA",
      "role": "table",
      "title": "Play node A",
      "config": "server/config/play-a.json"
    },
    {
      "id": "playB",
      "role": "table",
      "title": "Play node B",
      "config": "server/config/play-b.json"
    },
    {
      "id": "matchmaker",
      "role": "matchmaker",
      "title": "Matchmaker node",
      "config": "server/config/matchmaker.json"
    },
    {
      "id": "api",
      "role": "api",
      "title": "API node (Actor DB)",
      "config": "server/config/api.json"
    },
    {
      "id": "location",
      "role": "location-store",
      "title": "Redis",
      "config": "docker-compose.yml"
    }
  ],
  "channels": [
    {
      "name": "player-api",
      "owner": "playA",
      "kind": "client-server",
      "role": "client"
    },
    {
      "name": "player-api",
      "owner": "playB",
      "kind": "client-server",
      "role": "client"
    },
    {
      "name": "player-api",
      "owner": "api",
      "kind": "client-server",
      "role": "server"
    }
  ],
  "spots": [
    {
      "id": "table-entry-a",
      "kind": "entry",
      "type": null,
      "owner": "playA"
    },
    {
      "id": "table-entry-b",
      "kind": "entry",
      "type": null,
      "owner": "playB"
    },
    {
      "id": "table",
      "kind": "user",
      "type": "Table",
      "owner": "playA",
      "dynamic": true
    },
    {
      "id": "pool",
      "kind": "instance",
      "type": "Pool",
      "owner": "matchmaker",
      "logicalId": "pool-board"
    }
  ],
  "edges": [
    {
      "from": "players",
      "to": "session",
      "label": "STREAM"
    },
    {
      "from": "session",
      "to": "playA",
      "label": "relay"
    },
    {
      "from": "playA",
      "to": "location",
      "label": "Location / lease",
      "semantic": "location-authority"
    },
    {
      "from": "playA",
      "to": "matchmaker",
      "label": "match requests"
    },
    {
      "from": "matchmaker",
      "to": "playA",
      "label": "room preparation"
    },
    {
      "from": "playA",
      "to": "api",
      "label": "loadPlayer / commitRound"
    },
    {
      "from": "playB",
      "to": "api",
      "label": "loadPlayer / commitRound"
    },
    {
      "from": "api",
      "to": "location",
      "label": "Player records / round results"
    }
  ]
}
