{
  "version": 1,
  "id": "board-tables",
  "name": "my-game",
  "language": "java",
  "run": {
    "commands": {
      "sh": [
        "./run-server.sh",
        "./run-e2e.sh --build-only",
        "./run-e2e.sh",
        "./run-e2e.sh --scenario table,reconnect,match,match-cancel,update"
      ],
      "powershell": [
        "pwsh -NoProfile -ExecutionPolicy Bypass -File ./run-server.ps1",
        "pwsh -NoProfile -ExecutionPolicy Bypass -File ./run-e2e.ps1 -BuildOnly",
        "pwsh -NoProfile -ExecutionPolicy Bypass -File ./run-e2e.ps1",
        "pwsh -NoProfile -ExecutionPolicy Bypass -File ./run-e2e.ps1 -Scenario table,reconnect,match,match-cancel,update"
      ]
    },
    "scenarios": [
      "table",
      "reconnect",
      "match",
      "match-cancel",
      "update"
    ]
  },
  "nodes": [
    {
      "id": "players",
      "role": "external",
      "title": "Players",
      "config": null
    },
    {
      "id": "session",
      "role": "session",
      "title": "Session node",
      "config": "server/config/session.json"
    },
    {
      "id": "playA",
      "role": "table",
      "title": "Play node A",
      "config": "server/config/play-a.json"
    },
    {
      "id": "playB",
      "role": "table",
      "title": "Play node B",
      "config": "server/config/play-b.json"
    },
    {
      "id": "matchmaker",
      "role": "matchmaker",
      "title": "Matchmaker node",
      "config": "server/config/matchmaker.json"
    },
    {
      "id": "location",
      "role": "location-store",
      "title": "Location Store",
      "config": "docker-compose.yml"
    }
  ],
  "channels": [],
  "spots": [
    {
      "id": "table-entry-a",
      "kind": "entry",
      "type": null,
      "owner": "playA"
    },
    {
      "id": "table-entry-b",
      "kind": "entry",
      "type": null,
      "owner": "playB"
    },
    {
      "id": "table",
      "kind": "user",
      "type": "Table",
      "owner": "playA",
      "dynamic": true
    },
    {
      "id": "pool",
      "kind": "user",
      "type": "Pool",
      "owner": "matchmaker",
      "logicalId": "pool-board"
    }
  ],
  "edges": [
    {
      "from": "players",
      "to": "session",
      "label": "STREAM"
    },
    {
      "from": "session",
      "to": "playA",
      "label": "relay"
    },
    {
      "from": "playA",
      "to": "location",
      "label": "Location / lease",
      "semantic": "location-authority"
    },
    {
      "from": "playA",
      "to": "matchmaker",
      "label": "match requests"
    },
    {
      "from": "matchmaker",
      "to": "playA",
      "label": "room preparation"
    }
  ]
}
