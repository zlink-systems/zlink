{
  "version": 1,
  "id": "mmo-megaserver",
  "name": "my-game",
  "language": "kotlin",
  "run": {
    "commands": {
      "sh": [
        "./gradlew --no-daemon installDist",
        "./run-e2e.sh",
        "./run-e2e.sh --scenario region,dungeon,reconnect,update"
      ],
      "powershell": [
        "./gradlew.bat --no-daemon installDist",
        "pwsh -NoProfile -File ./run-e2e.ps1",
        "pwsh -NoProfile -File ./run-e2e.ps1 -Scenario region,dungeon,reconnect,update"
      ]
    },
    "scenarios": [
      "region",
      "dungeon",
      "reconnect",
      "update"
    ]
  },
  "nodes": [
    {
      "id": "players",
      "role": "external",
      "title": "Players",
      "config": null
    },
    {
      "id": "session",
      "role": "session",
      "title": "Session",
      "config": "server/config/session.json"
    },
    {
      "id": "regionA",
      "role": "region",
      "title": "Region A",
      "config": "server/config/regionA.json"
    },
    {
      "id": "regionB",
      "role": "region",
      "title": "Region B",
      "config": "server/config/regionB.json"
    },
    {
      "id": "instance",
      "role": "instance",
      "title": "Dungeon",
      "config": "server/config/instance.json"
    },
    {
      "id": "location",
      "role": "location-store",
      "title": "Redis",
      "config": "docker-compose.yml"
    }
  ],
  "channels": [],
  "spots": [
    {
      "id": "entryA",
      "kind": "entry",
      "type": null,
      "owner": "regionA"
    },
    {
      "id": "entryB",
      "kind": "entry",
      "type": null,
      "owner": "regionB"
    },
    {
      "id": "entryInstance",
      "kind": "entry",
      "type": null,
      "owner": "instance"
    },
    {
      "id": "region",
      "kind": "user",
      "type": "Region",
      "owner": "regionA",
      "dynamic": true
    },
    {
      "id": "dungeon",
      "kind": "user",
      "type": "Dungeon",
      "owner": "instance",
      "dynamic": true
    }
  ],
  "edges": [
    {
      "from": "players",
      "to": "session",
      "label": "STREAM"
    },
    {
      "from": "session",
      "to": "regionA",
      "label": "relay"
    },
    {
      "from": "regionA",
      "to": "instance",
      "label": "GetOrCreate"
    },
    {
      "from": "regionA",
      "to": "location",
      "label": "Location / lease",
      "semantic": "location-authority"
    }
  ]
}
