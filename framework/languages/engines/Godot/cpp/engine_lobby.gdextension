[configuration]
entry_symbol = "engine_lobby_library_init"
compatibility_minimum = "4.4"

[libraries]
linux.debug.x86_64 = "res://bin/libengine_lobby_godot.so"
linux.release.x86_64 = "res://bin/libengine_lobby_godot.so"
windows.debug.x86_64 = "res://bin/engine_lobby_godot.dll"
windows.release.x86_64 = "res://bin/engine_lobby_godot.dll"
