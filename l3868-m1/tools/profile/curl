#!/usr/bin/env bash
set -euo pipefail
args=("$@")
data=""; url=""
for ((i=0;i<${#args[@]};i++)); do
  case "${args[i]}" in
    -d|--data|--data-raw|--data-binary) ((i+=1)); data="${args[i]}" ;;
    http://*|https://*) url="${args[i]}" ;;
  esac
done
phase=""
if [[ "$url" == */bench/start && -n "$data" ]]; then
  phase="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("phase",""))' "$data")"
fi
if [[ "$phase" == active ]]; then
  mkdir -p "$LADDER_CAPTURE_DIR"
  perf record -e cpu-clock -F 199 --call-graph dwarf -p "$LADDER_SOURCE_PID,$LADDER_TARGET_PID" \
    -o "$LADDER_CAPTURE_DIR/perf.data" -- sleep 5.3 >"$LADDER_CAPTURE_DIR/perf.log" 2>&1 &
  profile_pid=$!
  /root/jobs/fx/cx/v21/s033/r4190m/tools/curl "${args[@]}"
  wait "$profile_pid"
else
  exec /root/jobs/fx/cx/v21/s033/r4190m/tools/curl "${args[@]}"
fi
