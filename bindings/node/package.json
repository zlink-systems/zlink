{
  "name": "@zlink-systems/zlink",
  "version": "11.2.0",
  "description": "zlink Node.js bindings \u2014 high-performance async messaging library",
  "license": "MPL-2.0",
  "author": "Zlink Systems",
  "repository": {
    "type": "git",
    "url": "https://github.com/ulala-x/zlink.git",
    "directory": "bindings/node"
  },
  "homepage": "https://zlink.systems/",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "prebuilds/**/*",
    "provenance/**/*",
    "native/src/**/*",
    "scripts/verify_prebuilds.js",
    "scripts/install.js",
    "binding.gyp",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "gypfile": true,
  "scripts": {
    "install": "node scripts/install.js",
    "clean": "rm -rf dist dist-tools",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/generate_esm_wrapper.js && tsc -p tsconfig.tools.json && ln -sfn ../dist dist-tools/dist",
    "verify:prebuilds": "node scripts/verify_prebuilds.js",
    "rebuild-native": "node-gyp configure build",
    "perf:single": "./perf/single/run_benchmarks.sh",
    "perf:multi": "./perf/multi/run_benchmarks.sh",
    "perf": "./perf/run_benchmarks.sh",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:src-review": "tsc -p tsconfig.src-review.json",
    "prepare": "npm run build",
    "pretest": "npm run build && npm run typecheck && npm run rebuild-native",
    "test": "./tests/run_tests.sh",
    "presamples": "npm run build && npm run rebuild-native",
    "samples": "./samples/run_samples.sh"
  },
  "dependencies": {
    "@types/node": "^22.15.30"
  },
  "devDependencies": {
    "node-gyp": "^12.4.0",
    "typescript": "^5.8.3"
  }
}
