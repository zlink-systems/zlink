# Doxygen configuration for zlink C++ binding

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "zlink C++ Binding"
PROJECT_BRIEF          = "Header-only C++ wrapper API for libzlink"
PROJECT_NUMBER         = master
OUTPUT_DIRECTORY       = doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = NO

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
SHOW_INCLUDE_FILES     = YES

INPUT                  = include/zlink.hpp \
                         include/zlink \
                         README.doxygen.md
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXCLUDE                = include/zlink.h
EXCLUDE_PATTERNS       = */build/*
USE_MDFILE_AS_MAINPAGE = README.doxygen.md
INPUT_ENCODING         = UTF-8
INCLUDE_PATH           = include

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
HAVE_DOT               = NO
