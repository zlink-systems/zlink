@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(zlink @ZLINK_CPP_CORE_VERSION@ EXACT CONFIG)

if(NOT TARGET zlink::cpp)
  if(TARGET libzlink)
    set(_zlink_cpp_core_target libzlink)
  elseif(TARGET libzlink-static)
    set(_zlink_cpp_core_target libzlink-static)
  else()
    set(zlink_cpp_FOUND FALSE)
    set(zlink_cpp_NOT_FOUND_MESSAGE "The zlink package exports no supported Core target")
    return()
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/zlink_cppTargets.cmake")
  set_property(TARGET zlink::cpp APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES "${_zlink_cpp_core_target}")
  unset(_zlink_cpp_core_target)
endif()
check_required_components(zlink_cpp)
