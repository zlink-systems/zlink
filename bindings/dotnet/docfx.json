{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/Zlink/Zlink.csproj"],
          "src": "."
        }
      ],
      "dest": "api",
      "filter": "docfx-filter.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["toc.yml", "*.md"]
      }
    ],
    "dest": "_site",
    "template": ["default"]
  }
}
