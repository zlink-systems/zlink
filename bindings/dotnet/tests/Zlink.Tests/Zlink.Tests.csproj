<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>Systems.Zlink.Tests</AssemblyName>
    <RootNamespace>Systems.Zlink.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Zlink/Zlink.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the exact perf coordinator primitive into the test assembly so
         its wake-up races can be tested without exposing a benchmark-internal
         type through the binding's public surface. -->
    <Compile Include="../../perf/multi/Zlink.BindingBench.Multi/src/PerfMultiAdmissionSignal.cs"
             Link="Perf/PerfMultiAdmissionSignal.cs" />
  </ItemGroup>
</Project>
