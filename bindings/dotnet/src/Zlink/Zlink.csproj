<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ZLinkBindingVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../VERSION'))</ZLinkBindingVersionFile>
        <Version Condition="'$(Version)' == '' and Exists('$(ZLinkBindingVersionFile)')">$([System.IO.File]::ReadAllText('$(ZLinkBindingVersionFile)').Trim().Replace('ZLINK_BINDING_VERSION=', ''))</Version>
        <AssemblyName>Systems.Zlink</AssemblyName>
        <PackageId>Zlink</PackageId>
        <RootNamespace>Systems.Zlink</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>zlink .NET bindings - high-performance async messaging library</Description>
    </PropertyGroup>
    <Target Name="ValidateZLinkBindingVersionFile" BeforeTargets="PrepareForBuild">
        <Error Condition="!Exists('$(ZLinkBindingVersionFile)')"
               Text="Zlink .NET binding version file was not found: $(ZLinkBindingVersionFile)" />
    </Target>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup Condition="'$(ZLinkLinuxX64NativeRoot)' != ''">
        <None Include="$(ZLinkLinuxX64NativeRoot)\libzlink.so;$(ZLinkLinuxX64NativeRoot)\libzlink.so.0;$(ZLinkLinuxX64NativeRoot)\libzlink.so.$(ZLinkCoreVersion)">
            <Pack>true</Pack>
            <PackagePath>runtimes\linux-x64\native\%(Filename)%(Extension)</PackagePath>
            <Link>runtimes\linux-x64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="'$(ZLinkWindowsX64NativeRoot)' != ''">
        <None Include="$(ZLinkWindowsX64NativeRoot)\zlink.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes\win-x64\native\zlink.dll</PackagePath>
            <Link>runtimes\win-x64\native\zlink.dll</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="'$(ZLinkWindowsArm64NativeRoot)' != ''">
        <None Include="$(ZLinkWindowsArm64NativeRoot)\zlink.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes\win-arm64\native\zlink.dll</PackagePath>
            <Link>runtimes\win-arm64\native\zlink.dll</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="'$(ZLinkCoreProvenancePath)' != ''">
        <None Include="$(ZLinkCoreProvenancePath)">
            <Pack>true</Pack>
            <PackagePath>provenance\core-package-provenance.json</PackagePath>
            <Link>provenance\core-package-provenance.json</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <Target Name="ValidateCorePackageInput" BeforeTargets="Pack">
        <Error Condition="'$(ZLinkLinuxX64NativeRoot)' == '' And '$(ZLinkWindowsX64NativeRoot)' == '' And '$(ZLinkWindowsArm64NativeRoot)' == ''"
               Text="ZLinkLinuxX64NativeRoot, ZLinkWindowsX64NativeRoot, or ZLinkWindowsArm64NativeRoot must identify the approved Core 0.18.0 package runtime directory." />
        <Error Condition="('$(ZLinkLinuxX64NativeRoot)' != '' And '$(ZLinkWindowsX64NativeRoot)' != '') Or ('$(ZLinkLinuxX64NativeRoot)' != '' And '$(ZLinkWindowsArm64NativeRoot)' != '') Or ('$(ZLinkWindowsX64NativeRoot)' != '' And '$(ZLinkWindowsArm64NativeRoot)' != '')"
               Text="Exactly one Core native runtime root may be specified when packing Zlink." />
        <Error Condition="'$(ZLinkCoreVersion)' == ''"
               Text="ZLinkCoreVersion must identify the approved Core 0.18.0 package version." />
        <Error Condition="'$(ZLinkCoreSource)' != 'local' And ('$(ZLinkCoreProvenancePath)' == '' Or !Exists('$(ZLinkCoreProvenancePath)'))"
               Text="ZLinkCoreProvenancePath must identify the approved Core 0.18.0 package provenance." />
        <Error Condition="'$(ZLinkLinuxX64NativeRoot)' != '' And !Exists('$(ZLinkLinuxX64NativeRoot)\libzlink.so')"
               Text="The approved Core 0.18.0 package is missing libzlink.so." />
        <Error Condition="'$(ZLinkLinuxX64NativeRoot)' != '' And !Exists('$(ZLinkLinuxX64NativeRoot)\libzlink.so.0')"
               Text="The approved Core 0.18.0 package is missing libzlink.so.0." />
        <Error Condition="'$(ZLinkLinuxX64NativeRoot)' != '' And !Exists('$(ZLinkLinuxX64NativeRoot)\libzlink.so.$(ZLinkCoreVersion)')"
               Text="The approved Core 0.18.0 package is missing its exact versioned runtime." />
        <Error Condition="'$(ZLinkWindowsX64NativeRoot)' != '' And !Exists('$(ZLinkWindowsX64NativeRoot)\zlink.dll')"
               Text="The approved Core 0.18.0 package is missing win-x64 zlink.dll." />
        <Error Condition="'$(ZLinkWindowsArm64NativeRoot)' != '' And !Exists('$(ZLinkWindowsArm64NativeRoot)\zlink.dll')"
               Text="The approved Core 0.18.0 package is missing win-arm64 zlink.dll." />
    </Target>
</Project>
