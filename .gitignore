# /core/src
## Ignore generated files in configuration process
core/src/platform.hpp*
core/src/libzlink.pc

# /core/tools
## Executable binaries are ignored
core/tools/curve_keygen
core/tools/**/logs/
## Executable source files must be tracked
!core/tools/*.[ch]
!core/tools/*.[ch]pp

# /core/tests
## Test binaries and logs are ignored
core/tests/test*
core/tests/test*.log
core/tests/test*.trs
## Test source files must be tracked
!core/tests/test*.[ch]
!core/tests/test*.[ch]pp
## Build script and documentations must be tracked
!core/tests/CMakeLists.txt
!core/tests/README.md

# /core/unittests
## Unit test binaries and logs are ignored
core/unittests/unittest_*
core/unittests/unittest*.log
core/unittests/unittest*.trs
## Unit test source files must be tracked
!core/unittests/unittest*.[ch]
!core/unittests/unittest*.[ch]pp
## Build script and documentations must be tracked
!core/unittests/CMakeLists.txt
!core/unittests/README.md

# check test log files
test-suite*.log

# /core/perf
## Benchmarking binaries and result files are ignored
core/perf/*_lat
core/perf/*_thr
core/perf/benchmark_*
core/perf/results
## Benchmarking source files must be tracked
!core/perf/*.[ch]
!core/perf/*.[ch]pp
## Benchmarking tool scripts must be tracked
!core/perf/*.py
!core/perf/*.sh

# /doc
## Generated document files 
doc/*.[137]
doc/*.html
doc/*.xml

