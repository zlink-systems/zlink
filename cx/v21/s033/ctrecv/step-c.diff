+TEST (ReceiveHeaderCache, EvictsOldestAtSixtyFourAndPreservesRetainedHeaders)
+{
+    registry_t handlers;
+    std::optional<msg::envelope_header_t> rejection;
+    auto first = handlers.prepare_header (
+      msg::envelope_codec_t{}.encode_header (repeatable_header ()), "", false, &rejection);
+    ASSERT_TRUE (first);
+    auto retained = first.value ().cached ();
+    std::weak_ptr<const registry_t::cached_header_t> oldest = retained;
+    first = result_t<registry_t::prepared_header_t>::success ({});
+    for (int i = 0; i != 64; ++i) {
+        auto header = repeatable_header ();
+        header.topic = std::to_string (i);
+        ASSERT_TRUE (handlers.prepare_header (msg::envelope_codec_t{}.encode_header (header), "",
+                                              false, &rejection));
+        if (i == 62) {
+            auto still_cached = handlers.prepare_header (
+              msg::envelope_codec_t{}.encode_header (repeatable_header ()), "", false, &rejection);
+            ASSERT_TRUE (still_cached);
+            EXPECT_EQ (retained, still_cached.value ().cached ());
+        }
+    }
+    EXPECT_FALSE (oldest.expired ());
+    EXPECT_EQ ("packet", std::string (retained->header.message_name));
+    retained.reset ();
+    EXPECT_TRUE (oldest.expired ());
+}
