+TEST (ReceiveClaimContract, ConcurrentDuplicateCreditsSettleThePrefixOnce)
+{
+    namespace mesh = rt::mesh;
+    mesh::service_mailbox_t mailbox;
+    for (std::size_t i = 0; i != 130; ++i) {
+        mesh::service_mailbox_record_t record;
+        record.owner = "node";
+        record.domain = mesh::service_mailbox_domain_t::application;
+        record.parts.push_back (zlink::message_t::from ("value"));
+        ASSERT_TRUE (mailbox.try_enqueue (std::move (record)));
+    }
+    // A byte budget truncates the requested prefix before the next bitmap word.
+    const auto bytes = mailbox.pending_bytes (mesh::service_mailbox_domain_t::application) / 130;
+    auto claim = mailbox.try_claim (mesh::service_mailbox_domain_t::application, 130, bytes * 65);
+    ASSERT_TRUE (claim);
+    ASSERT_EQ (65u, claim->claimed_messages);
+    std::vector<mesh::service_mailbox_settlement_t> credits;
+    for (std::size_t i = 0; i != claim->claimed_messages; ++i) {
+        auto record = mailbox.take ({claim, i});
+        ASSERT_TRUE (record);
+        credits.push_back (std::move (record->transferred));
+    }
+    std::atomic_size_t settled{0};
+    std::vector<std::jthread> workers;
+    for (std::size_t worker = 0; worker != 8; ++worker)
+        workers.emplace_back ([&] {
+            for (const auto &credit : credits)
+                if (credit ())
+                    settled.fetch_add (1, std::memory_order_relaxed);
+        });
+    workers.clear ();
+    EXPECT_EQ (65u, settled.load ());
+    EXPECT_EQ (0u, claim->outstanding ());
+    EXPECT_FALSE (mailbox.release (*claim));
+    auto next = mailbox.try_claim (mesh::service_mailbox_domain_t::application, 130, 1000000);
+    ASSERT_TRUE (next);
+    EXPECT_EQ (65u, next->claimed_messages);
+    EXPECT_TRUE (mailbox.release (*next));
+}
