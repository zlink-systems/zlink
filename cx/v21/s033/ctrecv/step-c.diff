+          zlink::message_t::from (std::to_string (id)), std::move (context), {}, {},
+          std::move (terminal)));
+        EXPECT_FALSE (pending.back ().await_ready ());
+    }
+    EXPECT_EQ (2, state.constructed);
+    EXPECT_EQ (0, state.destroyed.load ());
+    EXPECT_EQ (0, state.terminals.load ());
+    EXPECT_EQ (0u, state.jobs->snapshot ().permits_in_use);
+    state.resume.complete (result_t<void>::success ());
+    for (auto &task : pending)
+        ASSERT_TRUE (task.result ());
+    EXPECT_EQ (2, state.destroyed.load ());
+    EXPECT_EQ (2, state.terminals.load ());
+    EXPECT_EQ ((std::vector<int>{1, 2}), state.entered);
+}
