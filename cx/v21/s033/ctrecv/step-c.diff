+TEST (ReceiveHeaderCache, PerMessageFieldsAndLargeHeadersNeverEnterCache)
+{
+    registry_t handlers;
+    std::optional<msg::envelope_header_t> rejection;
+    for (int mode = 0; mode != 5; ++mode) {
+        SCOPED_TRACE (mode);
+        auto header = repeatable_header ();
+        if (mode == 0)
+            header.correlation_id = "correlation";
+        if (mode == 1)
+            header.deadline = "2030-01-01T00:00:00.000Z";
+        if (mode == 2) {
+            header.flow_id = "01890a5d-ac96-774b-bcce-b302099a8057";
+            header.flow_origin = flow_origin_t::inbound;
+        }
+        if (mode == 3)
+            header.metadata["per-message"] = "value";
+        if (mode == 4)
+            header.topic = std::string (1100, 'x');
+        auto bytes = msg::envelope_codec_t{}.encode_header (header);
+        for (bool capture : {false, true}) {
+            auto decoded = handlers.prepare_header (bytes, "", capture, &rejection);
+            ASSERT_TRUE (decoded);
+            EXPECT_FALSE (decoded.value ().cached ());
+            EXPECT_EQ (capture ? header.flow_id : std::nullopt, decoded.value ().header ().flow_id);
+        }
+    }
+    auto malformed = handlers.prepare_header (zlink::message_t::from ("{}"), "", false, &rejection);
+    EXPECT_FALSE (malformed);
+    EXPECT_EQ (framework_error_kind_t::protocol_error, malformed.error_kind ());
+}
