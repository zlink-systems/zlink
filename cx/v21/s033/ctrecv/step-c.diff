+TEST (ReceiveClaimContract, CreditBitsPreserveOwnerReadinessAcrossWordBoundaries)
+{
+    namespace mesh = rt::mesh;
+    for (const std::size_t count : {63u, 64u, 65u, 128u, 129u}) {
+        SCOPED_TRACE (count);
+        mesh::service_mailbox_t mailbox;
+        const auto enqueue = [&] (std::string value) {
+            mesh::service_mailbox_record_t record;
+            record.owner = "node";
+            record.domain = mesh::service_mailbox_domain_t::application;
+            record.parts.push_back (zlink::message_t::from (value));
+            ASSERT_TRUE (mailbox.try_enqueue (std::move (record)));
+        };
+        for (std::size_t i = 0; i < count; ++i)
+            enqueue (std::to_string (i));
+        struct storage_t { mesh::service_mailbox_claim_t claim; };
+        auto storage = std::make_shared<storage_t> ();
+        auto supplied = std::shared_ptr<mesh::service_mailbox_claim_t> (storage, &storage->claim);
+        auto claim = mailbox.try_claim (mesh::service_mailbox_domain_t::application, count,
+                                         std::numeric_limits<std::size_t>::max (), {}, supplied);
+        ASSERT_TRUE (claim);
+        EXPECT_EQ (supplied.get (), claim.get ());
+        ASSERT_EQ (count, claim->claimed_messages);
+        std::vector<mesh::service_mailbox_settlement_t> credits;
+        for (std::size_t i = 0; i < count; ++i) {
+            auto record = mailbox.take ({claim, i});
+            ASSERT_TRUE (record);
+            EXPECT_EQ (std::to_string (i), record->parts.front ().to_string ());
+            credits.push_back (std::move (record->transferred));
+        }
+        enqueue ("next");
+        EXPECT_FALSE (mailbox.try_claim (mesh::service_mailbox_domain_t::application, 1, 10000));
+        if (count % 2 == 0) {
+            for (std::size_t i = 0; i < count / 2; ++i) {
+                EXPECT_TRUE (credits[i] ());
+                EXPECT_FALSE (credits[i] ());
+            }
+            EXPECT_EQ (count - count / 2, claim->outstanding ());
+            EXPECT_FALSE (mailbox.try_claim (mesh::service_mailbox_domain_t::application, 1, 10000));
+            EXPECT_TRUE (mailbox.release (*claim));
+        } else {
+            for (std::size_t i = count; i > 1; --i) {
+                EXPECT_TRUE (credits[i - 1] ());
+                EXPECT_FALSE (credits[i - 1] ());
+            }
+            EXPECT_EQ (1u, claim->outstanding ());
+            EXPECT_FALSE (mailbox.try_claim (mesh::service_mailbox_domain_t::application, 1, 10000));
+            EXPECT_TRUE (credits[0] ());
+        }
+        EXPECT_EQ (0u, claim->outstanding ());
+        for (const auto &credit : credits)
+            EXPECT_FALSE (credit ());
+        EXPECT_FALSE (mailbox.release (*claim));
+        auto next = mailbox.try_claim (mesh::service_mailbox_domain_t::application, 1, 10000);
+        ASSERT_TRUE (next);
+        auto next_record = mailbox.take ({next, 0});
+        ASSERT_TRUE (next_record);
+        EXPECT_EQ ("next", next_record->parts.front ().to_string ());
+        EXPECT_TRUE (next_record->transferred ());
+        EXPECT_FALSE (next_record->transferred ());
+    }
+}
