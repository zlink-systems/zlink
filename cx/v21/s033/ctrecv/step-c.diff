+TEST (ReceiveHeaderCache, SharesImmutableHeaderAndPreparedRouteAfterByteComparison)
+{
+    registry_t handlers;
+    handlers.on_send<cache_handler_t, int> ("budget-mesh", "packet", &cache_handler_t::send);
+    std::optional<msg::envelope_header_t> rejection;
+    auto bytes = msg::envelope_codec_t{}.encode_header (repeatable_header ());
+    auto first = handlers.prepare_header (bytes, "", false, &rejection);
+    ASSERT_TRUE (first);
+    ASSERT_TRUE (first.value ().cached ());
+    ASSERT_NE (nullptr, first.value ().handler);
+    auto same = handlers.prepare_header (bytes, "", true, &rejection);
+    ASSERT_TRUE (same);
+    EXPECT_EQ (first.value ().cached (), same.value ().cached ());
+    EXPECT_EQ (first.value ().handler, same.value ().handler);
+    EXPECT_FALSE (rejection);
+    bytes = {};
+    EXPECT_EQ ("packet", std::string (same.value ().header ().message_name));
+    EXPECT_EQ ("budget-mesh", first.value ().handler->descriptor.router_channel_id);
+    auto changed = repeatable_header ();
+    changed.topic = "different bytes";
+    auto miss = handlers.prepare_header (msg::envelope_codec_t{}.encode_header (changed), "", false,
+                                         &rejection);
+    ASSERT_TRUE (miss);
+    EXPECT_NE (first.value ().cached (), miss.value ().cached ());
+    auto same_width = repeatable_header ();
+    same_width.message_name = "packex";
+    auto altered_bytes = msg::envelope_codec_t{}.encode_header (same_width);
+    EXPECT_EQ (altered_bytes.size (),
+               msg::envelope_codec_t{}.encode_header (repeatable_header ()).size ());
+    auto altered = handlers.prepare_header (altered_bytes, "", false, &rejection);
+    ASSERT_TRUE (altered);
+    EXPECT_NE (first.value ().cached (), altered.value ().cached ());
+    EXPECT_EQ ("packex", std::string (altered.value ().header ().message_name));
+    EXPECT_EQ (nullptr, altered.value ().handler);
+    registry_t other;
+    other.on_send<cache_handler_t, int> ("budget-mesh", "packet", &cache_handler_t::send);
+    auto separate = other.prepare_header (
+      msg::envelope_codec_t{}.encode_header (repeatable_header ()), "", false, &rejection);
+    ASSERT_TRUE (separate);
+    EXPECT_NE (first.value ().handler, separate.value ().handler);
+    // A later registration changes the published table, including cached misses.
+    auto missing = repeatable_header ();
+    missing.message_name = "later";
+    auto missing_bytes = msg::envelope_codec_t{}.encode_header (missing);
+    auto before = handlers.prepare_header (missing_bytes, "", false, &rejection);
+    ASSERT_TRUE (before);
+    EXPECT_EQ (nullptr, before.value ().handler);
+    handlers.on_send<cache_handler_t, int> ("budget-mesh", "later", &cache_handler_t::send);
+    auto after = handlers.prepare_header (missing_bytes, "", false, &rejection);
+    ASSERT_TRUE (after);
+    EXPECT_NE (nullptr, after.value ().handler);
+    EXPECT_NE (before.value ().cached (), after.value ().cached ());
+    EXPECT_EQ ("packet", first.value ().handler->descriptor.packet_name);
+}
