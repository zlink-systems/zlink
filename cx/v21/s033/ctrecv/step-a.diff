+struct invocation_state_t
+{
+    std::shared_ptr<rt::application_job_queue_t> jobs =
+      std::make_shared<rt::application_job_queue_t> (rt::application_job_queue_configuration_t{
+        application_job_queue_profile_t::balanced, std::uint32_t{1}, 1, 1});
+    task_completion_source_t<void> resume;
+    int mode = 0;
+    int constructed = 0;
+    std::atomic_int destroyed{0};
+    int filter_scope = 0;
+    int before = 0;
+    std::atomic_int terminals{0};
+    std::vector<int> entered;
+    std::vector<int> completed;
+};
+
+struct invocation_dependency_t
+{
+    invocation_state_t &state;
+    int id;
+    explicit invocation_dependency_t (invocation_state_t &value) :
+        state (value), id (++value.constructed)
+    {
+    }
+    ~invocation_dependency_t () { ++state.destroyed; }
+};
+
+struct budget_handler_t
+{
+    invocation_dependency_t &dependency;
+    void enter (int value)
+    {
+        auto &state = dependency.state;
+        EXPECT_EQ (0u, state.jobs->snapshot ().permits_in_use);
+        EXPECT_EQ (dependency.id, state.filter_scope);
+        EXPECT_EQ (value, dependency.id);
+        EXPECT_EQ (value, state.before);
+        state.entered.push_back (value);
+    }
+    void sync (const int &value, const route_message_context_t &)
+    {
+        enter (value);
+        auto &state = dependency.state;
+        if (state.mode == 1)
+            throw framework_exception_t (framework_error_kind_t::unavailable,
+                                         "synchronous failure");
+        if (state.mode == 6)
+            throw std::runtime_error ("untyped synchronous failure");
+        state.completed.push_back (value);
+    }
+    task_t<void> async (const int &value, const route_message_context_t &)
+    {
+        enter (value);
+        auto &state = dependency.state;
+        if (state.mode == 7)
+            throw std::runtime_error ("untyped task factory failure");
+        if (state.mode == 2)
+            return task_t<void> (result_t<void>::success ());
+        if (state.mode == 3)
+            return task_t<void> (
+              result_t<void>::failure (framework_error_kind_t::unavailable, "ready task failure"));
+        return state.resume.task ();
+    }
+};
+
+TEST (ReceiveInvocationContract,
+      FreshScopePermitExceptionAndExactlyOnceTerminalForReadyAndSuspended)
+{
+    for (int mode = 0; mode != 8; ++mode) {
+        SCOPED_TRACE (mode);
+        invocation_state_t state;
+        state.mode = mode;
+        service_collection_t services;
+        services.add_factory<invocation_dependency_t> (
+          [&] (service_provider_t &) { return std::make_unique<invocation_dependency_t> (state); },
+          service_lifetime_t::scoped);
+        services.add_factory<budget_handler_t> (
+          [] (service_provider_t &provider) {
+              return std::make_unique<budget_handler_t> (
+                budget_handler_t{provider.get_required<invocation_dependency_t> ()});
+          },
+          service_lifetime_t::scoped);
+        auto provider = services.build_provider ();
+        serializer_registry_t serializers;
+        registry_t handlers;
+        if (mode < 2 || mode == 6)
+            handlers.on_send<budget_handler_t, int> ("budget-mesh", "packet",
+                                                     &budget_handler_t::sync);
+        else
+            handlers.on_send<budget_handler_t, int> ("budget-mesh", "packet",
+                                                     &budget_handler_t::async);
+        handlers.bind_codecs (serializers);
+        handler_registry_t filters;
+        filters.add_filter ([&] (service_provider_t &scope, serializer_registry_t &,
+                                 const handler_filter_context_t &, handler_next_t next) {
+            state.filter_scope = scope.get_required<invocation_dependency_t> ().id;
+            return next ();
+        });
+        const auto *handler =
+          handlers.resolve ("budget-mesh", msg::message_kind_t::command, "packet");
+        ASSERT_NE (nullptr, handler);
+        for (int dispatch = 1; dispatch != 3; ++dispatch) {
+            std::promise<void> settled;
+            auto terminal_done = settled.get_future ();
+            auto permit = state.jobs->try_reserve_supply ();
+            ASSERT_TRUE (permit);
+            permit->mark_queued ();
+            rt::application_dispatch_terminal_owner_t terminal (
+              {},
+              [&] {
+                  ++state.terminals;
+                  settled.set_value ();
+              },
+              {}, rt::handler_entry_t ([&] { ++state.before; }, std::move (*permit)));
+            route_message_context_t context{.source_node_rid =
+                                              zlink::routing_id_t::from ("source")};
+            context.channel_name = "budget-mesh";
+            context.content_type = "application/json";
+            auto pending = detail::route_handler_invoker_t::invoke (
+              *handler, filters, handler_dispatch_kind_t::channel_send, provider, serializers,
+              zlink::message_t::from (std::to_string (dispatch)), std::move (context), {}, {},
+              std::move (terminal));
+            if ((mode == 4 || mode == 5) && dispatch == 1) {
+                ASSERT_FALSE (pending.await_ready ());
+                EXPECT_EQ (0, state.terminals.load ());
+                EXPECT_EQ (0, state.destroyed.load ());
+                EXPECT_EQ (0u, state.jobs->snapshot ().permits_in_use);
+                if (mode == 5)
+                    state.resume.complete (result_t<void>::failure (
+                      framework_error_kind_t::unavailable, "suspended failure"));
+                else
+                    state.resume.complete (result_t<void>::success ());
+            }
+            auto result = pending.result ();
+            EXPECT_EQ (mode == 0 || mode == 2 || mode == 4, static_cast<bool> (result));
+            if (!result && mode >= 6) {
+                EXPECT_EQ (nullptr, result.error ());
+                ASSERT_TRUE (result.exception ());
+                try {
+                    std::rethrow_exception (result.exception ());
+                }
+                catch (const std::runtime_error &error) {
+                    EXPECT_STREQ (mode == 6 ? "untyped synchronous failure"
+                                            : "untyped task factory failure",
+                                  error.what ());
+                }
+            } else if (!result) {
+                EXPECT_EQ (framework_error_kind_t::unavailable, result.error_kind ());
+                EXPECT_STREQ (mode == 1   ? "synchronous failure"
+                              : mode == 3 ? "ready task failure"
+                                          : "suspended failure",
+                              result.error ()->what ());
+            }
+            ASSERT_EQ (std::future_status::ready,
+                       terminal_done.wait_for (std::chrono::seconds (5)));
+            EXPECT_EQ (dispatch, state.terminals.load ());
+            EXPECT_EQ (dispatch, state.constructed);
+            EXPECT_EQ (dispatch, state.destroyed.load ());
+            EXPECT_EQ (0u, state.jobs->snapshot ().permits_in_use);
+        }
+        EXPECT_EQ ((std::vector<int>{1, 2}), state.entered);
+        if (mode == 0)
+            EXPECT_EQ ((std::vector<int>{1, 2}), state.completed);
+        EXPECT_EQ (2, state.before);
+    }
+}
