@@ -0,0 +1,381 @@
+/* SPDX-License-Identifier: LicenseRef-zlink-License-1.0 */
+#include <gtest/gtest.h>
+#include <zlink/framework.hpp>
+#include "runtime/channels/route_handler_invoker.hpp"
