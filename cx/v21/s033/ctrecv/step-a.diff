+TEST (ReceiveHeaderCache, MaximumCacheableHeaderIsExactly1024Bytes)
+{
+    registry_t handlers;
+    std::optional<msg::envelope_header_t> rejection;
+    auto header = repeatable_header ();
+    const auto base_size = msg::envelope_codec_t{}.encode_header (header).size ();
+    header.topic = std::string (1026 - base_size, 'x');
+    auto boundary = msg::envelope_codec_t{}.encode_header (header);
+    ASSERT_EQ (1024u, boundary.size ());
+    auto cached = handlers.prepare_header (boundary, "", false, &rejection);
+    ASSERT_TRUE (cached);
+    EXPECT_TRUE (cached.value ().cached ());
+    header.topic->push_back ('x');
+    auto oversized = msg::envelope_codec_t{}.encode_header (header);
+    ASSERT_EQ (1025u, oversized.size ());
+    auto skipped = handlers.prepare_header (oversized, "", false, &rejection);
+    ASSERT_TRUE (skipped);
+    EXPECT_FALSE (skipped.value ().cached ());
+}
