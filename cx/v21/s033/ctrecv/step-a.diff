+TEST (ReceiveHeaderCache, DisabledFlowCannotMakeInvalidFlowReusable)
+{
+    registry_t handlers;
+    std::optional<msg::envelope_header_t> rejection;
+    for (const auto *field : {"flowId", "flowOrigin"}) {
+        auto bytes = msg::envelope_codec_t{}.encode_header (repeatable_header ()).to_string ();
+        const auto key = std::string ("\"") + field + "\":null";
+        const auto position = bytes.find (key);
+        ASSERT_NE (std::string::npos, position);
+        bytes.replace (position, key.size (), std::string ("\"") + field + "\":true");
+        auto message = zlink::message_t::from (bytes);
+        auto ignored = handlers.prepare_header (message, "", false, &rejection);
+        ASSERT_TRUE (ignored);
+        EXPECT_FALSE (ignored.value ().cached ());
+        auto validated = handlers.prepare_header (message, "", true, &rejection);
+        EXPECT_FALSE (validated);
+        EXPECT_EQ (framework_error_kind_t::protocol_error, validated.error_kind ());
+    }
+}
