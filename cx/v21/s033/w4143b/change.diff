diff --git a/framework/languages/cpp/CMakeLists.txt b/framework/languages/cpp/CMakeLists.txt
index 80c6dc5137..7591d842b9 100644
--- a/framework/languages/cpp/CMakeLists.txt
+++ b/framework/languages/cpp/CMakeLists.txt
@@ -920,6 +920,17 @@ function(zlink_framework_cpp_add_test)
   if(TARGET "${command_target}")
     zlink_framework_cpp_enable_test_assertions("${command_target}")
     zlink_framework_cpp_enable_test_unused_result_errors("${command_target}")
+    if(MSVC)
+      # Keep allocation-test behavior optimized while emitting symbols and PDBs.
+      target_compile_options("${command_target}" PRIVATE
+        "$<$<CONFIG:Release>:/O2>"
+        "$<$<CONFIG:Release>:/Zi>")
+      target_link_options("${command_target}" PRIVATE
+        "$<$<CONFIG:Release>:/DEBUG>"
+        "$<$<CONFIG:Release>:/OPT:REF>"
+        "$<$<CONFIG:Release>:/OPT:ICF>")
+      target_link_libraries("${command_target}" PRIVATE dbghelp)
+    endif()
   endif()
   add_test(NAME "${ZLINK_TEST_NAME}" COMMAND ${ZLINK_TEST_COMMAND})
   set(test_environment ${ZLINK_TEST_ENVIRONMENT})
