+{
+bool verify_race (bool destructor_only, int iteration, bool controlled = true,
+                  bool close_before_native = false)
+{
+    hold_reply = controlled;
+    hold_native = !close_before_native;
+    raw_reply_probe_reset ();
+    allocated_messages = released_messages = 0;
+    reply_left = false;
+    close_attempts = 0;
+    busy_attempts = 0;
+    reply_socket = nullptr;
+    submit_entered = false;
+    allow_native_entry = false;
+    held_submit_result = -1;
+    busy_return_ns = 0;
+    retry_gap_ns = 0;
+    zlink::context_t context;
+    context.options ().auto_hwm_enabled (false);
+    zlink::router_socket_t source (context);
+    auto target = std::make_unique<zlink::router_socket_t> (context);
+    const auto source_id = zlink::routing_id_t::from ("reply-close-source");
+    const auto target_id = zlink::routing_id_t::from ("reply-close-target");
+    source.set_routing_id (source_id);
+    target->set_routing_id (target_id);
+    source.options ().linger (0ms);
+    target->options ().linger (0ms);
+    target->options ().send_timeout (2s);
+    source.options ().recv_hwm (zlink::byte_count_t::bytes (1024));
+    target->options ().send_hwm (zlink::byte_count_t::bytes (1024));
+    target->bind ("inproc://framework-reply-close");
+    auto monitor = source.monitor_open (zlink::monitor_event::connection_ready);
+    source.connect ("inproc://framework-reply-close");
+    zlink::poller_t events;
+    events.add (monitor, zlink::poll_event_flag_t::pollin, 1);
+    assert (until ([&] {
+        zlink::poll_event_t event;
+        (void) events.wait (&event, 1, 1ms);
+        const auto value = monitor.recv (zlink::recv_flags_t::dontwait);
+        return value && value->event == zlink::monitor_event::connection_ready;
+    }));
+    events.remove (monitor);
+    monitor.close ();
+    events.add (source, zlink::poll_event_flag_t::pollcompletion, 1);
+    backend::raw_route_port_t port (*target);
+    constexpr int count = 64;
+    std::vector<backend::raw_received_t> requests;
+    for (int index = 0; index < count; ++index) {
+        auto part = zlink::message_t::from ("request");
+        const auto submitted = source.request (target_id).message (part).timeout (3s).async ();
+        assert (submitted.result == ZLINK_SUBMIT_OK);
+        assert (until ([&] {
+            auto request = port.try_receive ();
+            if (!request)
+                return false;
+            requests.push_back (std::move (*request));
+            return true;
+        }));
+    }
+    if (controlled)
+        source.set_receive_flow_state (zlink::receive_flow_state_t::paused);
+    caller = &source;
+    std::exception_ptr reply_failure;
+    std::thread sender ([&] {
+        try {
+            for (const auto &request : requests) {
+                if (!port.reply (request, reply_messages ()))
+                    break;
+            }
+        }
+        catch (...) { reply_failure = std::current_exception (); }
+        reply_left = true;
+    });
+    const bool submitting = until ([] { return submit_entered.load (); });
+    if (!submitting) {
+        allow_native_entry = true;
+        raw_reply_probe_release ();
+        sender.join ();
+        assert (submitting);
+    }
+    // A captured operation can enter Core after the port seals its pointer.
+    // Detach the poller before holding Core's native send admission.
+    port.close ();
+    if (close_before_native)
+        backend::close_route_socket (target);
+    allow_native_entry = true;
+    const bool held = close_before_native || !controlled || until ([] { return raw_reply_probe_entered (); });
+    if (!held) {
+        raw_reply_probe_release ();
+        sender.join ();
+        std::fprintf (stderr, "reply never held in native submit, iteration=%d\n", iteration);
+        assert (held);
+    }
+    const auto native = reply_socket.load ();
+    if (destructor_only) {
+        // Mutation control: the prototype's RAII borrower destroys the binding
+        // wrapper while the admitted submit is still held. Both destructor close
+        // calls ignore BUSY, including socket.cpp:53.
+        target.reset ();
+        raw_reply_probe_release ();
+        source.set_receive_flow_state (zlink::receive_flow_state_t::running);
+    } else if (!close_before_native) {
+        release_on_busy = controlled;
+        backend::close_route_socket (target);
+    }
+    sender.join ();
+    assert (!reply_failure);
+    const auto native_calls = submit_codes;
+    assert (!port.reply (requests.front (), reply_messages ()));
+    assert (submit_codes == native_calls);
+    assert (!target);
+    // A public close probe also cleans a leaked handle so failed controls finish.
+    const auto after = __real_zlink_close (native);
+    std::printf ("iteration=%d close_attempts=%d busy=%d native_after_close=%d retry_gap_ns=%lld\n",
+                 iteration, close_attempts.load (), busy_attempts.load (), static_cast<int> (after),
+                 static_cast<long long> (retry_gap_ns.load ()));
+    std::fflush (stdout);
+    const bool closed = after == ZLINK_CLOSE_SHUTDOWN;
+    if (!destructor_only) {
+        assert (closed);
+        if (controlled && !close_before_native) {
+            assert (busy_attempts == 1);
+            assert (close_attempts == 2);
+            assert (held_submit_result >= 0);
+            assert (retry_gap_ns >= 1'000'000);
+        }
+    }
+    events.close ();
+    source.close ();
+    context.term ();
+    assert (allocated_messages == released_messages);
+    return closed;
+}
+void verify_failure_retention ()
+{
+    zlink::context_t context;
+    auto socket = std::make_unique<zlink::router_socket_t> (context);
+    reply_socket = last_socket;
+    close_attempts = 0;
+    injected_failures = -1;
+    const auto started = std::chrono::steady_clock::now ();
+    const auto deadline = started + 20ms;
+    bool failed = false;
+    try { backend::close_route_socket (socket, deadline); }
+    catch (const zlink::close_error_t &error) {
+        failed = error.result () == zlink::close_result_t::busy;
+    }
+    assert (failed && socket && socket->valid () && close_attempts >= 1);
+    assert (std::chrono::steady_clock::now () >= deadline);
+    const auto attempts = close_attempts.load ();
+    injected_failures = 0;
+    backend::close_route_socket (socket);
+    assert (!socket && close_attempts == attempts + 1);
+
+    // The same expired deadline is not renewed for the next socket.
+    reply_socket = nullptr;
+    auto second = std::make_unique<zlink::router_socket_t> (context);
+    reply_socket = last_socket;
+    close_attempts = 0;
+    injected_failures = -1;
+    failed = false;
+    try { backend::close_route_socket (second, deadline); }
+    catch (const zlink::close_error_t &error) {
+        failed = error.result () == zlink::close_result_t::busy;
+    }
+    assert (failed && second && second->valid () && close_attempts == 1);
+    injected_failures = 0;
+    backend::close_route_socket (second);
+    assert (!second && close_attempts == 2);
+
+    reply_socket = nullptr;
+    socket = std::make_unique<zlink::router_socket_t> (context);
+    reply_socket = last_socket;
+    close_attempts = 0;
+    injected_failures = 1;
+    injected_result = ZLINK_CLOSE_INTERNAL_ERROR;
+    failed = false;
+    try { backend::close_route_socket (socket); }
+    catch (const zlink::close_error_t &error) {
+        failed = error.result () == zlink::close_result_t::internal_error;
+    }
+    assert (failed && socket && socket->valid () && close_attempts == 1);
+    backend::close_route_socket (socket);
+    assert (!socket && close_attempts == 2);
+    injected_result = ZLINK_CLOSE_BUSY;
+    socket = std::make_unique<zlink::router_socket_t> (context);
+    reply_socket = last_socket;
+    close_attempts = 0;
+    busy_until = std::chrono::steady_clock::now () + 25ms;
+    backend::close_route_socket (socket);
+    assert (!socket && std::chrono::steady_clock::now () >= busy_until);
+    std::printf ("BUSY lasting 25 ms: close succeeded, attempts=%d\n", close_attempts.load ());
+    std::printf ("BUSY deadline: 20 ms, attempts=%d, retained then cleaned; "
+                 "shared expired deadline: one attempt; non-BUSY: no retry\n", attempts);
+}
+
+}
+int main (int argc, char **argv)
+{
+    const std::string_view mode = argc > 1 ? argv[1] : "deterministic";
+    const int repetitions = argc > 2 ? std::atoi (argv[2])
+      : mode == "race" || mode == "destructor-control" ? 100 : 1;
+    assert (repetitions > 0);
+    int leaks = 0;
+    for (int iteration = 0; iteration < repetitions; ++iteration)
+        leaks += !verify_race (mode == "destructor-control", iteration, mode != "race");
+    if (mode == "deterministic")
+        leaks += !verify_race (false, 1, true, true);
+    for (const auto &[code, count] : submit_codes)
+        std::printf ("submit_result=%d count=%llu\n", code,
+                     static_cast<unsigned long long> (count));
+    std::printf ("message ownership: all %d iterations consumed or released\n",
+                 repetitions + (mode == "deterministic" ? 1 : 0));
+    if (leaks) {
+        std::fprintf (stderr, "native sockets left open through binding destruction: %d/%d\n",
+                      leaks, repetitions);
+        return 1;
+    }
+    verify_failure_retention ();
+}
