+/* SPDX-License-Identifier: LicenseRef-zlink-License-1.0 */
+// Linux test interposition: stop a backpressured reply before its native wait
+// releases admission. The test verifies BUSY through the real public close API.
+#include <atomic>
+#include <ctime>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <sched.h>
+
+namespace
+{
+thread_local int reply_clocks = -1;
+std::atomic_bool entered{false};
+std::atomic_bool released{false};
+}
+#define PROBE_EXPORT extern "C" __attribute__((visibility("default")))
+PROBE_EXPORT void raw_reply_probe_arm () { reply_clocks = 0; }
+PROBE_EXPORT void raw_reply_probe_disarm () { reply_clocks = -1; }
+PROBE_EXPORT void raw_reply_probe_reset () { entered = false; released = false; }
+PROBE_EXPORT bool raw_reply_probe_entered () { return entered.load (std::memory_order_acquire); }
+PROBE_EXPORT void raw_reply_probe_release () { released.store (true, std::memory_order_release); }
+PROBE_EXPORT int clock_gettime (clockid_t clock, timespec *value) noexcept
+{
+    if (clock == CLOCK_MONOTONIC && reply_clocks >= 0 && ++reply_clocks == 2) {
+        entered.store (true, std::memory_order_release);
+        while (!released.load (std::memory_order_acquire))
+            sched_yield ();
+    }
+    return static_cast<int> (syscall (SYS_clock_gettime, clock, value));
+}
