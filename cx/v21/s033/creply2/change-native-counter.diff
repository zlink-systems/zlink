+/* SPDX-License-Identifier: LicenseRef-zlink-License-1.0 */
+#include "runtime/backend/raw_route_port.hpp"
+#include <zlink.hpp>
+#include <atomic>
+#include <cassert>
+#include <cerrno>
+#include <chrono>
+#include <cstdio>
+#include <future>
+#include <memory>
+#include <map>
+#include <cstdlib>
+#include <string_view>
+#include <thread>
+
+using namespace std::chrono_literals;
+namespace backend = zlink::framework::detail::backend;
+extern "C" void raw_reply_probe_arm ();
+extern "C" void raw_reply_probe_disarm ();
+extern "C" void raw_reply_probe_reset ();
+extern "C" bool raw_reply_probe_entered ();
+extern "C" void raw_reply_probe_release ();
+extern "C" zlink_submit_result_t __real_zlink_reply (
+  void *, const zlink_routing_id_t *, zlink_reply_token_t, zlink_msg_t *, size_t);
+extern "C" zlink_close_result_t __real_zlink_close (void *);
+extern "C" void *__real_zlink_socket (void *, zlink_socket_type_t);
+namespace
+{
+std::atomic<void *> reply_socket{nullptr};
+std::atomic_int close_attempts{0}, busy_attempts{0};
+std::atomic_bool reply_left{false}, release_on_busy{false};
+std::atomic_bool submit_entered{false}, allow_native_entry{false};
+std::atomic_int injected_failures{0};
+std::atomic_int injected_result{ZLINK_CLOSE_BUSY};
+std::atomic_int held_submit_result{-1};
+std::atomic<std::int64_t> busy_return_ns{0}, retry_gap_ns{0};
+zlink::router_socket_t *caller = nullptr;
+void *last_socket = nullptr;
+bool hold_reply = true;
+bool hold_native = true;
+std::map<int, std::uint64_t> submit_codes;
+std::chrono::steady_clock::time_point busy_until{};
+std::atomic_int allocated_messages{0}, released_messages{0};
+
+std::vector<zlink::message_t> reply_messages ()
+{
+    auto *data = new std::uint8_t[256]{};
+    ++allocated_messages;
+    std::vector<zlink::message_t> parts;
+    parts.push_back (zlink::advanced::external_message_t::from (
+      std::span<std::uint8_t> (data, 256), [] (void *data, void *) {
+          delete[] static_cast<std::uint8_t *> (data);
+          ++released_messages;
+      }));
+    return parts;
+}
+
+bool until (auto predicate)
+{
+    const auto end = std::chrono::steady_clock::now () + 3s;
+    while (std::chrono::steady_clock::now () < end) {
+        if (predicate ())
+            return true;
+        std::this_thread::yield ();
+    }
+    return predicate ();
+}
+}
+extern "C" void *__wrap_zlink_socket (void *context, zlink_socket_type_t type)
+{
+    last_socket = __real_zlink_socket (context, type);
+    return last_socket;
+}
+extern "C" zlink_submit_result_t __wrap_zlink_reply (
+  void *socket, const zlink_routing_id_t *rid, zlink_reply_token_t token,
+  zlink_msg_t *parts, size_t count)
+{
+    reply_socket = socket;
+    submit_entered.store (true, std::memory_order_release);
+    if (hold_reply) {
+        while (!allow_native_entry.load (std::memory_order_acquire))
+            std::this_thread::yield ();
+        if (hold_native)
+            raw_reply_probe_arm ();
+    }
+    const auto result = __real_zlink_reply (socket, rid, token, parts, count);
+    if (raw_reply_probe_entered ())
+        held_submit_result = static_cast<int> (result);
+    raw_reply_probe_disarm ();
+    ++submit_codes[static_cast<int> (result)];
+    return result;
+}
+extern "C" zlink_close_result_t __wrap_zlink_close (void *socket)
+{
+    if (socket != reply_socket.load ())
+        return __real_zlink_close (socket);
+    if (const auto previous = busy_return_ns.load (); previous != 0)
+        retry_gap_ns = std::chrono::duration_cast<std::chrono::nanoseconds> (
+                         std::chrono::steady_clock::now ().time_since_epoch ()).count () - previous;
+    ++close_attempts;
+    if (std::chrono::steady_clock::now () < busy_until) {
+        errno = EBUSY;
+        return ZLINK_CLOSE_BUSY;
+    }
+    if (injected_failures.load () != 0) {
+        if (injected_failures > 0)
+            --injected_failures;
+        errno = injected_result == ZLINK_CLOSE_BUSY ? EBUSY : EIO;
+        return static_cast<zlink_close_result_t> (injected_result.load ());
+    }
+    const auto result = __real_zlink_close (socket);
+    const int close_errno = errno;
+    if (result == ZLINK_CLOSE_BUSY) {
+        assert (close_errno == EBUSY);
+        ++busy_attempts;
+        if (release_on_busy.exchange (false)) {
+            // Leave the real admitted submit only after observing real Core BUSY.
+            raw_reply_probe_release ();
+            caller->set_receive_flow_state (zlink::receive_flow_state_t::running);
+            assert (until ([] { return reply_left.load (); }));
+        }
+        busy_return_ns = std::chrono::duration_cast<std::chrono::nanoseconds> (
+                           std::chrono::steady_clock::now ().time_since_epoch ()).count ();
+    }
+    errno = close_errno;
+    return result;
+}
