diff --git a/framework/bench/grpc/cpp/measurement/prototype_close_compat.cpp b/framework/bench/grpc/cpp/measurement/prototype_close_compat.cpp
new file mode 100644
index 0000000000..e43ac77e4c
--- /dev/null
+++ b/framework/bench/grpc/cpp/measurement/prototype_close_compat.cpp
@@ -0,0 +1,14 @@
+// Measurement-only link compatibility for the unselected positive test branch.
+// The negative control uses binding destruction, not this function.
+#include "runtime/backend/raw_route_port.hpp"
+#include <zlink.hpp>
+namespace zlink::framework::detail::backend {
+void close_route_socket (std::unique_ptr<zlink::router_socket_t> &socket,
+                         std::chrono::steady_clock::time_point)
+{
+    if (socket) {
+        socket->close ();
+        socket.reset ();
+    }
+}
+}
