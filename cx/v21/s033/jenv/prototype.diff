+        if (header.isError()) {
+            flags |= 2;
+            errorCode = (header.errorCode() == null ? "" : header.errorCode()).getBytes(StandardCharsets.UTF_8);
+            errorMessage = (header.errorMessage() == null ? "" : header.errorMessage()).getBytes(StandardCharsets.UTF_8);
+        }
+        ByteBuffer b = ByteBuffer.allocate(24 + channel.length + name.length
+                + ((flags & 1) == 0 ? 0 : 8) + ((flags & 2) == 0 ? 0 : 8 + errorCode.length + errorMessage.length));
