+                        + " rounds="
+                        + rounds
+                        + " submissions="
+                        + (rounds * submitters)
+                        + " outcomes="
+                        + outcomes
+                        + " closes="
+                        + closes);
+        assertNull(firstFailure, () -> "unexpected submit outcome: " + outcomes);
+    }
