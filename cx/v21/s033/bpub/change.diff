-                ZlinkSubmitException.class, () -> owner.withNativeCall(() -> {
+                ZlinkSubmitException.class, () -> core.withNativeCall(() -> {
                     fail("closed socket must not enter the native action");
                     return null;
                 }));
diff --git a/bindings/java/src/test/java/systems/zlink/runtime/sockets/PublishCloseAdmissionContractTest.java b/bindings/java/src/test/java/systems/zlink/runtime/sockets/PublishCloseAdmissionContractTest.java
