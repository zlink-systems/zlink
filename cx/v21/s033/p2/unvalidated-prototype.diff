+TEST (QueueHead, SpotAndActorGatesHoldUntilHandlerTerminal)
+{
+    using namespace std::chrono_literals;
+    const auto *negative = std::getenv ("ZLINK_QUEUE_HEAD_NEGATIVE");
+    const std::string_view fault = negative ? negative : "";
+    for (const bool actor : {false, true}) {
+        rt::offload_executor_t executor (2);
+        rt::serial_execution_queue_t gate (executor, {}, {},
+                                           actor ? rt::serial_lane_policy_t::actor_delivery ()
+                                                 : rt::serial_lane_policy_t::spot_wide ());
+        std::promise<void> entered, second;
+        auto started = entered.get_future ();
+        auto proceeded = second.get_future ();
+        rt::serial_execution_queue_t::async_completion_t finish;
+        ASSERT_TRUE (gate.try_post_async ("first", [&] (auto complete) {
+            finish = std::move (complete);
+            entered.set_value ();
+        }));
+        ASSERT_EQ (started.wait_for (2s), std::future_status::ready);
+        const auto sibling = [&] { second.set_value (); };
+        if (fault == (actor ? "actor-gate" : "spot-gate"))
+            ASSERT_TRUE (executor.try_submit_internal (sibling));
+        else
+            ASSERT_TRUE (gate.try_post ("second", sibling));
+        EXPECT_EQ (proceeded.wait_for (20ms), std::future_status::timeout)
+          << (actor ? "Actor gate removed" : "Spot gate removed");
+        finish ([] {});
+        EXPECT_EQ (proceeded.wait_for (2s), std::future_status::ready);
+        gate.drain ();
+    }
+}
