+    EXPECT_EQ (queued.front ().source_node_generation, 2u);
+    EXPECT_TRUE (mailbox.take_application_head ("node").empty ());
+    rt::application_dispatch_terminal_owner_t terminal;
+    terminal.retain_record (std::move (running));
+    terminal.settle ();
+    terminal.settle ();
+    EXPECT_EQ (scope.probe.commits, 2u);
+    EXPECT_EQ (scope.probe.takes, 2u);
+    EXPECT_EQ (scope.probe.settlement_rmws, 0u);
+}
