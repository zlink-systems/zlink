+service_mailbox_t::head_t service_mailbox_t::take_application_head ()
+{
+    std::unique_lock lock (_state->mutex);
+    const auto &ready = _state->application.ready;
+    if (ready.empty () || !concurrent_owner (ready.front ()))
+        return {};
+    // Preserve the existing ready-owner order for standalone callers.
+    const auto owner = ready.front ();
+    return take_application_head_locked (owner, lock);
+}
+
+service_mailbox_t::head_t
+service_mailbox_t::take_application_head (const std::string &owner,
+                                          application_ready_batch_t *ready)
+{
+    std::unique_lock lock (_state->mutex);
+    return take_application_head_locked (owner, lock, ready);
+}
