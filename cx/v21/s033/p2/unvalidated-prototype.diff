+service_mailbox_t::head_t
+service_mailbox_t::take_application_head_locked (const std::string &owner,
+                                                 std::unique_lock<std::mutex> &lock,
+                                                 application_ready_batch_t *publication)
+{
+#if defined(ZLINK_FRAMEWORK_TEST_CREATION_PROBE)
+    if (concurrent_owner (owner))
+        if (auto *probe = mailbox_path_probe.load (std::memory_order_acquire))
+            ++probe->take_calls;
+#endif
+    head_t head;
+    auto &source = _state->application;
+    const auto found = source.owners.find (owner);
+    if (!concurrent_owner (owner) || found == source.owners.end ()
+        || found->second.records.empty ())
+        return head;
+    auto &queue = found->second;
+    const auto bytes = retained_bytes (queue.records.front ());
+    // Prepare any allocating publication storage before detaching the original.
+    const auto membership = std::find (source.ready.begin (), source.ready.end (), owner);
+    if (queue.records.size () > 1) {
+        if (membership == source.ready.end ())
+            source.ready.push_back (owner);
+    } else if (membership != source.ready.end ())
+        source.ready.erase (membership);
+    auto ready = take_application_ready_locked (*_state);
+    head.splice (head.end (), queue.records, queue.records.begin ());
+#if defined(ZLINK_FRAMEWORK_TEST_CREATION_PROBE)
+    if (auto *probe = mailbox_path_probe.load (std::memory_order_acquire)) {
+        ++probe->takes;
+        if (probe->taken)
+            probe->taken (probe->context, head.front ());
+    }
+#endif
+    --queue.messages;
+    --source.messages;
+    queue.bytes -= bytes;
+    source.bytes -= bytes;
+    if (queue.records.empty ())
+        source.owners.erase (found);
