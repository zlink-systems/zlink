+TEST (QueueHead, NodeAndChannelHaveOneCommitOneTakeAndNoClaimOrSettlement)
+{
+    const auto *negative = std::getenv ("ZLINK_QUEUE_HEAD_NEGATIVE");
+    const std::string_view fault = negative ? negative : "";
+    for (const auto *owner : {"node", "channel:test"}) {
+        mailbox_t mailbox;
+        mailbox_t negative_mailbox;
+        std::shared_ptr<mesh::service_mailbox_claim_t> old;
+        std::shared_ptr<mesh::service_mailbox_claim_t> extra_allocation;
+        if (fault == "settlement") {
+            ASSERT_TRUE (negative_mailbox.try_enqueue (record (0, owner)));
+            old =
+              negative_mailbox.try_claim_owner (mesh::service_mailbox_domain_t::application, owner,
+                                                1, std::numeric_limits<std::size_t>::max ());
+            ASSERT_TRUE (old);
+        }
+        probe_scope_t scope;
+        ASSERT_TRUE (mailbox.try_enqueue (record (1, owner)));
+        if (fault == "claim") {
+            auto extra =
+              mailbox.try_claim_owner (mesh::service_mailbox_domain_t::application, owner, 1,
+                                       std::numeric_limits<std::size_t>::max ());
+            ASSERT_TRUE (extra);
+            EXPECT_EQ (scope.probe.prefix_claims, 0u) << "prefix claim allocation";
+            mailbox.release (*extra);
+            continue;
+        }
+        if (old)
+            EXPECT_TRUE (mesh::service_mailbox_test_access_t::settle_once (*old));
+        mailbox_t::head_t head;
+        const auto take_allocations = zlink::framework::tests::measure_allocations ([&] {
+            if (fault == "allocation")
+                extra_allocation = std::make_shared<mesh::service_mailbox_claim_t> ();
+            head = mailbox.take_application_head (owner);
+        });
+        EXPECT_EQ (take_allocations.count, 0u) << "queue head take allocated";
+        ASSERT_EQ (head.size (), 1u);
+        EXPECT_FALSE (head.front ().transferred);
+        if (fault == "take")
+            (void) mailbox.take_application_head (owner);
+        const auto allocations = zlink::framework::tests::measure_allocations ([&] {
+            rt::application_dispatch_terminal_owner_t terminal;
+            terminal.retain_record (std::move (head));
+        });
+        EXPECT_EQ (allocations.count, 0u) << "terminal allocated an ownership wrapper";
+        EXPECT_EQ (scope.probe.prefix_claims, 0u) << "prefix claim allocation";
+        EXPECT_EQ (scope.probe.settlement_rmws, 0u) << "settlement RMW";
+        EXPECT_EQ (scope.probe.commits, 1u) << "queue commit";
+        EXPECT_EQ (scope.probe.takes, 1u) << "queue transfer";
+        EXPECT_EQ (scope.probe.take_calls, 1u) << "queue take";
+    }
+}
+TEST (QueueHead, ApplicationViewsUseTheCanonicalPayloadWithoutAnotherOwner)
+{
+    namespace wire = rt::protocol;
+    std::vector<zlink::message_t> inner;
+    inner.push_back (zlink::message_t::from ("header"));
+    inner.push_back (zlink::message_t::from (std::string (1024, 'b')));
+    auto payload = wire::application_payload_t::from_parts (std::move (inner));
+    auto encoded = wire::encode_application_payload_message (payload);
+    const auto bytes = wire::message_bytes (encoded);
+    std::vector<zlink::message_t> views;
+    const auto *negative = std::getenv ("ZLINK_QUEUE_HEAD_NEGATIVE");
+    const auto allocations = zlink::framework::tests::measure_allocations ([&] {
+        views = negative && std::string_view (negative) == "payload-wrapper"
+                  ? wire::decode_application_parts (encoded.copy (), false)
+                  : wire::borrow_application_parts (bytes, false);
+    });
+    ASSERT_EQ (views.size (), 2u);
+    // The one vector stores the two native view handles. No retained-message owner.
+    EXPECT_EQ (allocations.count, 1u) << "extra payload owner allocation";
+    const auto begin = reinterpret_cast<std::uintptr_t> (encoded.data ());
+    const auto end = begin + encoded.size ();
+    for (const auto &part : views) {
+        const auto address = reinterpret_cast<std::uintptr_t> (part.data ());
+        EXPECT_GE (address, begin);
+        EXPECT_LE (address + part.size (), end);
+    }
+    EXPECT_EQ (views[1].size (), 1024u);
+}
+TEST (QueueHead, ConcurrentWorkersTakeFIFOWithoutWaitingForTerminals)
+{
+    mailbox_t mailbox;
+    constexpr std::size_t count = 1024;
+    for (std::size_t index = 0; index != count; ++index)
+        ASSERT_TRUE (mailbox.try_enqueue (record (index)));
+    struct observations_t
+    {
+        std::array<std::uint64_t, count> sequence{};
+        std::size_t seen = 0;
+    } observed;
+    probe_scope_t scope;
+    scope.probe.context = &observed;
+    scope.probe.taken = [] (void *context, const record_t &record) noexcept {
+        auto &value = *static_cast<observations_t *> (context);
+        value.sequence[value.seen++] = record.source_node_generation;
+    };
+    std::array<std::thread, 4> workers;
+    std::barrier held (4);
+    for (auto &worker : workers)
+        worker = std::thread ([&] {
+            auto first = mailbox.take_application_head ("node");
+            held.arrive_and_wait ();
+            for (;;) {
+                auto head = mailbox.take_application_head ("node");
+                if (head.empty ())
+                    break;
+                std::this_thread::yield ();
+            }
+        });
+    for (auto &worker : workers)
+        worker.join ();
+    ASSERT_EQ (observed.seen, count);
+    for (std::size_t index = 0; index != count; ++index)
+        EXPECT_EQ (observed.sequence[index], index);
+    EXPECT_EQ (scope.probe.takes, count);
+    EXPECT_EQ (scope.probe.settlement_rmws, 0u);
+}
+TEST (QueueHead, SuccessorIsReadyWhileTheFirstHeadIsStillOwned)
+{
+    mailbox_t mailbox;
+    std::size_t notifications = 0;
+    mailbox.bind_application_dispatch ({}, [&] (const auto &) { ++notifications; });
+    ASSERT_TRUE (mailbox.try_enqueue (record (1)));
+    ASSERT_TRUE (mailbox.try_enqueue (record (2)));
+    const auto before = notifications;
+    mailbox_t::application_ready_batch_t ready;
+    auto first = mailbox.take_application_head ("node", &ready);
+    ASSERT_EQ (first.size (), 1u);
+    EXPECT_EQ (notifications, before);
+    mailbox_t::notify_application_ready (ready);
+    EXPECT_EQ (notifications, before + 1);
+    auto next = mailbox.take_application_head ("node");
+    ASSERT_EQ (next.size (), 1u);
+    EXPECT_EQ (first.front ().source_node_generation, 1u);
+    EXPECT_EQ (next.front ().source_node_generation, 2u);
+}
+TEST (QueueHead, LastTakeAndEnqueueShareTheReadyBoundary)
+{
+    mailbox_t mailbox;
+    std::atomic_size_t notifications{0};
+    mailbox.bind_application_dispatch ({}, [&] (const auto &) { ++notifications; });
+    constexpr std::size_t rounds = 1000;
+    std::barrier boundary (2);
+    std::atomic_bool correct{true};
+    std::thread producer ([&] {
+        for (std::size_t index = 0; index != rounds; ++index) {
+            boundary.arrive_and_wait ();
+            if (!mailbox.try_enqueue (record (2 * index + 1)))
+                correct = false;
+            boundary.arrive_and_wait ();
+        }
+    });
+    for (std::size_t index = 0; index != rounds; ++index) {
+        ASSERT_TRUE (mailbox.try_enqueue (record (2 * index)));
+        const auto before = notifications.load ();
+        boundary.arrive_and_wait ();
+        auto first = mailbox.take_application_head ("node");
+        boundary.arrive_and_wait ();
+        auto second = mailbox.take_application_head ("node");
+        EXPECT_EQ (first.size (), 1u);
+        EXPECT_EQ (second.size (), 1u);
+        if (!first.empty () && !second.empty ()) {
+            EXPECT_EQ (first.front ().source_node_generation, 2 * index);
+            EXPECT_EQ (second.front ().source_node_generation, 2 * index + 1);
+        }
+        EXPECT_GT (notifications.load (), before);
+        EXPECT_TRUE (mailbox.take_application_head ("node").empty ());
+    }
+    producer.join ();
+    EXPECT_TRUE (correct);
+}
+TEST (QueueHead, CloseKeepsQueuedAndTakenRecordsButRejectsNewCommits)
+{
+    mailbox_t mailbox;
+    probe_scope_t scope;
+    ASSERT_TRUE (mailbox.try_enqueue (record (1)));
