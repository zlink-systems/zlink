+namespace
+{
+namespace fw = zlink::framework;
+struct suspension_t
+{
+    fw::task_completion_source_t<void> resume;
+    const void *body = nullptr;
+    std::weak_ptr<mesh::request_source_lookup_state_t> record_lifetime;
+    bool completed = false;
+};
+fw::task_t<zlink::message_t> suspended_invocation (suspension_t &state,
+                                                   const zlink::message_t &message,
+                                                   const fw::route_message_context_t &context,
+                                                   fw::detail::handler_start_callback_ref_t before)
+{
+    before ();
+    EXPECT_EQ (message.data (), state.body);
+    EXPECT_FALSE (state.record_lifetime.expired ());
+    co_await state.resume.task ();
+    EXPECT_EQ (message.data (), state.body);
+    EXPECT_FALSE (state.record_lifetime.expired ());
+    EXPECT_EQ (context.mesh_name, "retained-context");
+    EXPECT_EQ (context.packet_name, "retained-packet");
+    state.completed = true;
+    co_return zlink::message_t{};
+}
+}
+TEST (QueueHead, ExistingInvokerRetainsCanonicalRecordAcrossSuspensionAndShutdown)
+{
+    mailbox_t mailbox;
+    auto original = record (1);
+    original.replace_parts ({zlink::message_t::from (std::string (1024, 'r'))});
+    suspension_t state;
+    state.body = original.parts ().front ().data ();
+    {
+        auto lifetime = std::make_shared<mesh::request_source_lookup_state_t> ();
+        state.record_lifetime = lifetime;
+        original.source_original = mesh::request_source_t{std::move (lifetime)};
+    }
+    ASSERT_TRUE (mailbox.try_enqueue (std::move (original)));
+    auto head = mailbox.take_application_head ("node");
+    ASSERT_EQ (head.size (), 1u);
+    auto body = head.front ().parts ().front ().copy ();
+    rt::application_dispatch_terminal_owner_t terminal;
+    const auto *negative = std::getenv ("ZLINK_QUEUE_HEAD_NEGATIVE");
+    if (negative && std::string_view (negative) == "drop-record")
+        head.clear ();
+    else
+        terminal.retain_record (std::move (head));
+    fw::service_collection_t services;
+    auto provider = services.build_provider ();
+    fw::serializer_registry_t serializers;
+    fw::handler_registry_t filters;
+    fw::detail::route_handler_registry_t::entry_t handler{
+      {rt::messaging::message_kind_t::command, "retained-context", "retained-packet", typeid (void),
+       typeid (void), typeid (void)},
+      [&state] (auto &, auto &, const auto &message, const auto &context, auto before) {
+          return suspended_invocation (state, message, context, before);
+      },
+      {}};
+    fw::route_message_context_t context;
+    context.mesh_name = "retained-context";
+    context.packet_name = "retained-packet";
+    auto pending = fw::detail::route_handler_invoker_t::invoke (
+      handler, filters, fw::handler_dispatch_kind_t::node_direct_send, provider, serializers,
+      std::move (body), std::move (context), {}, {}, std::move (terminal));
+    EXPECT_FALSE (pending.await_ready ());
+    EXPECT_FALSE (state.record_lifetime.expired ());
+    mailbox.close ();
+    EXPECT_FALSE (state.record_lifetime.expired ());
+    state.resume.complete (fw::result_t<void>::success ());
+    EXPECT_TRUE (pending.result ());
+    EXPECT_TRUE (state.completed);
+    EXPECT_TRUE (state.record_lifetime.expired ());
+}
