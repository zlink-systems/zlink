+record_t record (std::uint64_t sequence, std::string owner = "node")
+{
+    auto value =
+      record_t::from_parts (std::move (owner), mesh::service_mailbox_domain_t::application,
+                            std::vector<zlink::message_t> (1));
+    value.source_node_generation = sequence;
+    return value;
+}
+struct probe_scope_t
+{
+    mesh::mailbox_path_probe_t probe;
+    probe_scope_t () { mesh::mailbox_path_probe = &probe; }
+    ~probe_scope_t () { mesh::mailbox_path_probe = nullptr; }
+};
