+test('outgoing multipart application frame writes into allocated Message storage', async () => {
+  const originalFrom = Message.from;
+  try {
+    Message.from = () => {
+      throw new Error('outgoing frame must not materialize through Message.from');
+    };
+    const message = encodeMultipartApplicationMessage(
+      [Buffer.from('header'), Buffer.from('body')],
+      'ZLinkFrameworkMultipart',
+      'application/x-zlink-multipart'
+    );
+    const host = new ZLinkNodeRawBindingPort().createHost();
+    const router = host.createRouter();
+    router.setRoutingId('native-frame-router');
+    const endpoint = `inproc://native-frame-${process.pid}`;
+    router.bind(endpoint);
+    const dealer = host.createDealer();
+    dealer.setRoutingId('native-frame-dealer');
+    dealer.connect(endpoint);
+    try {
+      const decoded = decodeApplicationPayload(message.data());
+      assert.equal(decoded.packetName, 'ZLinkFrameworkMultipart');
+      assert.equal(decoded.contentType, 'application/x-zlink-multipart');
+      assert.deepEqual(
+        decoded.payload,
+        encodeMultipartPayload([Buffer.from('header'), Buffer.from('body')])
+      );
+      await dealer.send([message]);
+      assert.equal(message.refCount(), 0);
+    } finally {
+      host.close();
+    }
+  } finally {
+    Message.from = originalFrom;
+  }
+});
+
+test('closing an allocated outgoing frame releases its payload', () => {
+  const message = Message.allocate(4);
+  message.data().set([1, 2, 3, 4]);
+  let closed = false;
+  const close = message.close.bind(message);
+  message.close = () => {
+    closed = true;
+    close();
+  };
+  message.close();
+  assert.equal(closed, true);
+});
+
+test('failed submit closes an allocated outgoing Message', () => {
+  const message = Message.allocate(4);
+  let closed = false;
+  const close = message.close.bind(message);
+  message.close = () => {
+    closed = true;
