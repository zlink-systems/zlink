diff --git a/bindings/dotnet/tests/Zlink.Tests/test_closed_submit_ownership.cs b/bindings/dotnet/tests/Zlink.Tests/test_closed_submit_ownership.cs
new file mode 100644
index 0000000000..a741cc3097
--- /dev/null
+++ b/bindings/dotnet/tests/Zlink.Tests/test_closed_submit_ownership.cs
@@ -0,0 +1,99 @@
+using Xunit;
+
+namespace Systems.Zlink.Tests;
+
+public sealed class test_closed_submit_ownership
+{
+    public static IEnumerable<object[]> Cases()
+    {
+        foreach (string kind in new[] { "send", "send-async", "request",
+                     "request-async", "reply", "received-reply", "publish", "try-publish" })
+            foreach (int count in new[] { 1, 2, 9 })
+                yield return new object[] { kind, count };
+    }
+
+    [Theory]
+    [MemberData(nameof(Cases))]
+    public void refused_submit_preserves_every_message(string kind, int count)
+    {
+        Assert.True(CoreTestSupport.IsNativeAvailable());
+        using var context = Zlink.CreateContext();
+        using var dealer = context.CreateDealerSocket();
+        using var router = context.CreateRouterSocket();
+        using var publisher = context.CreatePubSocket();
+        using var received = Received.Create();
+        using var poller = Zlink.CreatePoller();
+        Task<IReadOnlyList<Message>>? pending = null;
+        if (kind is "reply" or "received-reply")
+        {
+            string endpoint = CoreTestSupport.NewEndpoint("inproc", "closed-reply");
+            router.Bind(endpoint);
+            dealer.Connect(endpoint);
+            using (Message handshake = Message.From("ready"))
+                dealer.Send().Message(handshake).Submit();
+            Assert.True(router.Recv(received));
+            poller.Add(dealer, PollEventFlags.PollCompletion, 1);
+            using Message request = Message.From("request");
+            pending = dealer.Request().Message(request)
+                .Timeout(TimeSpan.FromSeconds(30)).Async().Reply;
+            Assert.True(router.Recv(received));
+        }
+
+        ISocket subject = kind is "reply" or "received-reply" ? router
+            : kind is "publish" or "try-publish" ? publisher : dealer;
+        subject.Close();
+        Message[] parts = Enumerable.Range(0, count)
+            .Select(index => Message.From($"part-{index}")).ToArray();
+        try
+        {
+            ZlinkSubmitException error = Assert.Throws<ZlinkSubmitException>(() =>
+            {
+                switch (kind)
+                {
+                    case "send":
+                        dealer.Send().Messages(parts).Submit();
+                        break;
+                    case "send-async":
+                        dealer.Send().Messages(parts).Async();
+                        break;
+                    case "request":
+                        Zlink.MultipartClose(dealer.Request().Messages(parts)
+                            .Timeout(TimeSpan.FromSeconds(3)).Submit());
+                        break;
+                    case "request-async":
+                        dealer.Request().Messages(parts)
+                            .Timeout(TimeSpan.FromSeconds(3)).Async();
+                        break;
+                    case "reply":
+                        router.Reply(received.RoutingId!.Value, received.ReplyToken!)
+                            .Messages(parts).Submit();
+                        break;
+                    case "received-reply":
+                        received.Reply().Messages(parts).Submit();
+                        break;
+                    case "publish":
+                        publisher.Publish("topic").Messages(parts).Submit();
+                        break;
+                    case "try-publish":
+                        TryPublishSubmitOperation operation = publisher.TryPublish("topic")
+                            .Message(parts[0]);
+                        for (var index = 1; index < parts.Length; index++)
+                            operation = operation.Message(parts[index]);
+                        operation.Submit();
+                        break;
+                }
+            });
+            Assert.Equal(ZlinkSubmitException.ErrorCode.Terminated, error.Result);
+            Assert.Equal(CoreTestSupport.Errno("ESHUTDOWN"), error.NativeErrno);
+            for (var index = 0; index < parts.Length; index++)
+                Assert.Equal($"part-{index}", parts[index].GetString());
+        }
+        finally
+        {
+            Zlink.MultipartClose(parts);
+            dealer.Close();
+            if (pending is not null)
+                Assert.Throws<ZlinkRequestException>(() => pending.GetAwaiter().GetResult());
+        }
+    }
+}
diff --git a/bindings/dotnet/tests/Zlink.Tests/test_socket_handle_reservation.cs b/bindings/dotnet/tests/Zlink.Tests/test_socket_handle_reservation.cs
new file mode 100644
index 0000000000..61a29b880f
--- /dev/null
+++ b/bindings/dotnet/tests/Zlink.Tests/test_socket_handle_reservation.cs
@@ -0,0 +1,117 @@
+using System.Runtime.InteropServices;
+using System.Runtime.CompilerServices;
+using Xunit;
+
+namespace Systems.Zlink.Tests;
+
+public sealed class test_socket_handle_reservation
+{
+    [Fact]
+    public void reservation_roots_the_finalizing_kernel()
+    {
+        Assert.True(CoreTestSupport.IsNativeAvailable());
+        using var context = Zlink.CreateContext();
+        (object handle, IDisposable call, WeakReference<object> owner) =
+            CreateReservationWithoutSocketRoot(context);
+        try
+        {
+            GC.Collect();
+            GC.WaitForPendingFinalizers();
+            GC.Collect();
+            Assert.True(owner.TryGetTarget(out _));
+        }
+        finally
+        {
+            call.Dispose();
+            CompletionOwnerTestAccess.Invoke(handle, "Dispose");
+        }
+    }
+
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    private static (object, IDisposable, WeakReference<object>)
+        CreateReservationWithoutSocketRoot(IContext context)
+    {
+        IPairSocket socket = context.CreatePairSocket();
+        object kernel = CompletionOwnerTestAccess.Property(socket, "Kernel");
+        object handle = Handle(socket);
+        return (handle, Reserve(handle), new WeakReference<object>(kernel));
+    }
+
+    [Fact]
+    public async Task reservations_overlap_and_close_is_busy_until_the_last_release()
+    {
+        Assert.True(CoreTestSupport.IsNativeAvailable());
+        using var context = Zlink.CreateContext();
+        using var socket = context.CreatePairSocket();
+        object handle = Handle(socket);
+        IDisposable first = Reserve(handle);
+        IDisposable? second = null;
+        try
+        {
+            second = await Task.Run(() => Reserve(handle))
+                .WaitAsync(TimeSpan.FromSeconds(3));
+            AssertBusy(socket);
+            first.Dispose();
+            first = null!;
+            AssertBusy(socket);
+        }
+        finally
+        {
+            first?.Dispose();
+            second?.Dispose();
+        }
+        // A rejected close cannot disable reservations.
+        Reserve(handle).Dispose();
+        socket.Close();
+        ZlinkSubmitException error = Assert.Throws<ZlinkSubmitException>(
+            () => Reserve(handle));
+        Assert.Equal(ZlinkSubmitException.ErrorCode.Terminated, error.Result);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void safe_handle_defers_release_and_cannot_return_close_failure(bool releaseSucceeds)
+    {
+        var handle = new DeferredHandle(releaseSucceeds);
+        bool added = false;
+        handle.DangerousAddRef(ref added);
+        Assert.True(added);
+        handle.Dispose();
+        Assert.Equal(0, handle.ReleaseCount);
+        handle.DangerousRelease();
+        Assert.Equal(1, handle.ReleaseCount);
+        Assert.True(handle.IsClosed);
+        handle.Dispose();
+        Assert.Equal(1, handle.ReleaseCount);
+    }
+
+    private sealed class DeferredHandle(bool releaseSucceeds)
+        : SafeHandle(new IntPtr(1), ownsHandle: true)
+    {
+        internal int ReleaseCount;
+        public override bool IsInvalid => false;
+
+        protected override bool ReleaseHandle()
+        {
+            ReleaseCount++;
+            return releaseSucceeds;
+        }
+    }
+
+    private static object Handle(ISocket socket)
+    {
+        object kernel = CompletionOwnerTestAccess.Property(socket, "Kernel");
+        return CompletionOwnerTestAccess.Field(kernel, "_handle");
+    }
+
+    private static IDisposable Reserve(object handle) =>
+        (IDisposable)CompletionOwnerTestAccess.Invoke(handle, "Reserve", true)!;
+
+    private static void AssertBusy(ISocket socket)
+    {
+        ZlinkCloseException error = Assert.Throws<ZlinkCloseException>(socket.Close);
+        Assert.Equal(ZlinkCloseException.ErrorCode.Busy, error.Result);
+        Assert.Equal(CoreTestSupport.Errno("EBUSY"), error.NativeErrno);
+    }
+}
diff --git a/bindings/dotnet/tests/Zlink.Tests/test_submit_close_reservation.cs b/bindings/dotnet/tests/Zlink.Tests/test_submit_close_reservation.cs
new file mode 100644
index 0000000000..68ad08852f
--- /dev/null
+++ b/bindings/dotnet/tests/Zlink.Tests/test_submit_close_reservation.cs
@@ -0,0 +1,287 @@
+using System.Collections.Concurrent;
+using Xunit;
+using Xunit.Abstractions;
+
+namespace Systems.Zlink.Tests;
+
+public sealed class test_submit_close_reservation
+{
+    private const int Repetitions = 1000;
+    private readonly ITestOutputHelper _output;
+
+    public test_submit_close_reservation(ITestOutputHelper output)
+    {
+        _output = output;
+    }
+
+    [Theory]
+    [InlineData("send")]
+    [InlineData("request")]
+    [InlineData("reply")]
+    public void close_between_validation_and_native_submit(string kind)
+    {
+        Assert.True(CoreTestSupport.IsNativeAvailable());
+        using var context = Zlink.CreateContext();
+        using var router = context.CreateRouterSocket();
+        using var dealer = context.CreateDealerSocket();
+        string endpoint = CoreTestSupport.NewEndpoint("inproc", "close-window");
+        router.Bind(endpoint);
+        dealer.Connect(endpoint);
+        using (Message handshake = Message.From("ready"))
+            dealer.Send().Message(handshake).Submit();
+        using var received = Received.Create();
+        Assert.True(router.Recv(received));
+        using var poller = Zlink.CreatePoller();
+        poller.Add(dealer, PollEventFlags.PollCompletion, 1);
+        Task<IReadOnlyList<Message>>? pending = null;
+        if (kind == "reply")
+        {
+            using Message request = Message.From("request");
+            pending = dealer.Request().Message(request)
+                .Timeout(TimeSpan.FromSeconds(30)).Async().Reply;
+            Assert.True(router.Recv(received));
+        }
+        ISocket subject = kind == "reply" ? router : dealer;
+        object owner = CompletionOwnerTestAccess.Owner(subject);
+        bool acceptedClose = false;
+        using Message payload = Message.From("preserved");
+        var parts = new ClosingParts(payload, () =>
+        {
+            try
+            {
+                subject.Close();
+                acceptedClose = true;
+            }
+            catch (ZlinkCloseException error) when (
+                error.Result == ZlinkCloseException.ErrorCode.Busy)
+            {
+            }
+        });
+        Exception? failure = Record.Exception(() =>
+        {
+            switch (kind)
+            {
+                case "send":
+                    CompletionOwnerTestAccess.Invoke(owner, "Send", null, parts);
+                    break;
+                case "request":
+                    pending = ((RequestSubmission)CompletionOwnerTestAccess.Invoke(
+                        owner, "RequestAsync", null, parts, 30_000u,
+                        CancellationToken.None)!).Reply;
+                    break;
+                case "reply":
+                    CompletionOwnerTestAccess.Invoke(owner, "Reply",
+                        received.RoutingId!.Value, received.ReplyToken!, parts);
+                    break;
+            }
+        });
+        _output.WriteLine($"kind={kind} accepted_close={acceptedClose} failure={failure}");
+        subject.Close();
+        dealer.Close();
+        if (pending is not null)
+            Assert.Throws<ZlinkRequestException>(() => pending.GetAwaiter().GetResult());
+        if (acceptedClose)
+        {
+            var error = Assert.IsType<ZlinkSubmitException>(failure);
+            Assert.Equal(ZlinkSubmitException.ErrorCode.Terminated, error.Result);
+            Assert.Equal("preserved", payload.GetString());
+        }
+        else
+            Assert.Null(failure);
+    }
+
+    private sealed class ClosingParts : IReadOnlyList<Message>
+    {
+        private readonly Message _part;
+        private Action? _close;
+
+        internal ClosingParts(Message part, Action close)
+        {
+            _part = part;
+            _close = close;
+        }
+
+        public int Count => 1;
+
+        public Message this[int index]
+        {
+            get
+            {
+                Action? close = _close;
+                _close = null;
+                close?.Invoke();
+                return index == 0 ? _part
+                    : throw new ArgumentOutOfRangeException(nameof(index));
+            }
+        }
+
+        public IEnumerator<Message> GetEnumerator()
+        {
+            yield return this[0];
+        }
+
+        System.Collections.IEnumerator System.Collections.IEnumerable.GetEnumerator() =>
+            GetEnumerator();
+    }
+
+    [Theory]
+    [InlineData("send")]
+    [InlineData("request")]
+    [InlineData("reply")]
+    [InlineData("publish")]
+    public void same_handle_submit_races_close(string kind)
+    {
+        Assert.True(CoreTestSupport.IsNativeAvailable());
+        using var context = Zlink.CreateContext();
+        var outcomes = new ConcurrentDictionary<string, int>();
+        var closedOutcomes = new ConcurrentDictionary<string, int>();
+        var closeBusy = 0;
+
+        for (var repetition = 0; repetition < Repetitions; repetition++)
+        {
+            using var router = context.CreateRouterSocket();
+            using var dealer = context.CreateDealerSocket();
+            using var publisher = context.CreatePubSocket();
+            router.Options.Linger = TimeSpan.Zero;
+            dealer.Options.Linger = TimeSpan.Zero;
+            publisher.Options.Linger = TimeSpan.Zero;
+            string endpoint = CoreTestSupport.NewEndpoint("inproc",
+                $"submit-close-{kind}-{repetition}");
+            router.Bind(endpoint);
+            dealer.Connect(endpoint);
+            using (Message handshake = Message.From("ready"))
+                dealer.Send().Message(handshake).Submit();
+            using var received = Received.Create();
+            Assert.True(router.Recv(received));
+            using var poller = Zlink.CreatePoller();
+            poller.Add(dealer, PollEventFlags.PollCompletion, 1);
+
+            Task<IReadOnlyList<Message>>? pending = null;
+            Task? admitted = null;
+            if (kind == "reply")
+            {
+                using Message request = Message.From("request");
+                pending = dealer.Request().Message(request)
+                    .Timeout(TimeSpan.FromSeconds(30)).Async().Reply;
+                Assert.True(router.Recv(received));
+            }
+
+            ISocket subject = kind == "reply" ? router
+                : kind == "publish" ? publisher : dealer;
+            using var start = new Barrier(2);
+            Exception? failure = null;
+            int delay = repetition % 3;
+            var submitter = new Thread(() =>
+            {
+                start.SignalAndWait();
+                if (delay == 0)
+                    Thread.Yield();
+                try
+                {
+                    Submit();
+                }
+                catch (Exception exception)
+                {
+                    failure = exception;
+                }
+            })
+            { IsBackground = true };
+            submitter.Start();
+            start.SignalAndWait();
+            if (delay == 1)
+                Thread.Yield();
+            else if (delay == 2)
+                Thread.SpinWait(100);
+            try
+            {
+                subject.Close();
+            }
+            catch (ZlinkCloseException exception) when (
+                exception.Result == ZlinkCloseException.ErrorCode.Busy)
+            {
+                closeBusy++;
+            }
+            Assert.True(submitter.Join(TimeSpan.FromSeconds(10)));
+            Count(outcomes, failure);
+            subject.Close();
+
+            failure = Record.Exception(Submit);
+            Count(closedOutcomes, failure);
+            dealer.Close();
+            if (pending is not null)
+            {
+                ZlinkRequestException terminated = Assert.Throws<ZlinkRequestException>(
+                    () => pending.GetAwaiter().GetResult());
+                Assert.Equal(ZlinkRequestException.ErrorCode.Terminated,
+                    terminated.Result);
+                if (admitted is { IsCompletedSuccessfully: false })
+                {
+                    ZlinkRequestException admissionError = Assert.Throws<ZlinkRequestException>(
+                        () => admitted.GetAwaiter().GetResult());
+                    Assert.Same(terminated, admissionError);
+                }
+            }
+
+            void Submit()
+            {
+                using Message part = Message.From("payload");
+                switch (kind)
+                {
+                    case "send":
+                        dealer.Send().Message(part).Submit();
+                        break;
+                    case "request":
+                        RequestSubmission submission = dealer.Request().Message(part)
+                            .Timeout(TimeSpan.FromSeconds(30)).Async();
+                        pending = submission.Reply;
+                        admitted = submission.Admitted;
+                        Assert.Equal(SubmitResult.Ok, submission.Result);
+                        break;
+                    case "reply":
+                        received.Reply().Message(part).Submit();
+                        break;
+                    case "publish":
+                        publisher.Publish("topic").Message(part).Submit();
+                        break;
+                    default:
+                        throw new ArgumentOutOfRangeException(nameof(kind));
+                }
+            }
+        }
+
+        _output.WriteLine($"kind={kind} repetitions={Repetitions} close_busy={closeBusy}");
+        Print("race", outcomes);
+        Print("closed", closedOutcomes);
+        Assert.Equal(Repetitions, outcomes.Values.Sum());
+        Assert.All(outcomes.Keys, outcome =>
+            Assert.Contains(outcome, new[] { "success", "TERMINATED" }));
+        Assert.Equal(Repetitions, closedOutcomes.GetValueOrDefault("TERMINATED"));
+    }
+
+    private void Print(string phase, ConcurrentDictionary<string, int> outcomes)
+    {
+        foreach (var pair in outcomes.OrderBy(pair => pair.Key))
+            _output.WriteLine($"phase={phase} outcome={pair.Key} count={pair.Value}");
+    }
+
+    private static void Count(ConcurrentDictionary<string, int> outcomes,
+        Exception? exception)
+    {
+        string outcome = exception switch
+        {
+            null => "success",
+            ZlinkSubmitException submit when submit.Result ==
+                ZlinkSubmitException.ErrorCode.Terminated => "TERMINATED",
+            ZlinkException error when error.NativeErrno ==
+                CoreTestSupport.Errno("EFAULT") => "EFAULT",
+            ZlinkException error when error.NativeErrno ==
+                CoreTestSupport.Errno("ENOENT") => "ENOENT",
+            ZlinkSubmitException submit when submit.Result ==
+                ZlinkSubmitException.ErrorCode.InvalidHandle => "INVALID_HANDLE",
+            ZlinkSubmitException submit when submit.Result ==
+                ZlinkSubmitException.ErrorCode.NotFound => "NOT_FOUND",
+            _ => $"other:{exception.GetType().Name}:{exception.Message}"
+        };
+        outcomes.AddOrUpdate(outcome, 1, (_, count) => count + 1);
+    }
+}
