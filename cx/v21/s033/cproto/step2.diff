+        middle.append (",\"kind\":1,\"messageName\":");
+        middle.string (name);
+        middle.append (",\"metadata\":");
+    }
+    catch (const nlohmann::json::exception &) {
+        result.error = std::current_exception ();
+    }
+    return result;
+}
