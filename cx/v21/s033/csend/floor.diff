 namespace zlink::framework::detail::backend
 {
+
+namespace {
+struct csend_floor_state_t {
+    zlink::router_socket_t *socket = nullptr;
+    zlink::routing_id_t target = zlink::routing_id_t::from (std::string ("unset"));
+    std::vector<zlink::message_t> parts;
+    std::uint64_t sends = 0;
+    ~csend_floor_state_t () {
+        if (socket)
+            std::fprintf (stderr, "csend-floor final: sends=%llu parts=%zu\n",
+                          static_cast<unsigned long long> (sends), parts.size ());
+    }
+};
+thread_local csend_floor_state_t csend_floor_state;
+
+task_t<void> csend_floor_wait (zlink::async_result_t<void> admitted) {
+    co_await std::move (admitted);
+}
+}
+void csend_floor_reset () {
+    auto &s = csend_floor_state;
+    std::fprintf (stderr, "csend-floor reset: previous_sends=%llu parts=%zu\n",
+                  static_cast<unsigned long long> (s.sends), s.parts.size ());
+    s.socket = nullptr;
+    s.parts.clear ();
+    s.sends = 0;
+}
+bool csend_floor_ready () { return csend_floor_state.socket != nullptr; }
+task_t<void> csend_floor_send () {
+    auto &s = csend_floor_state;
+    auto op = s.socket->send (s.target).message (s.parts[0].copy ());
+    for (size_t i = 1; i < s.parts.size (); ++i)
+        op = std::move (op).message (s.parts[i].copy ());
+    auto submitted = std::move (op).async ();
+    ++s.sends;
+    if (submitted.result == ZLINK_SUBMIT_OK)
+        return task_t<void> (result_t<void>::success ());
+    if (submitted.result == ZLINK_SUBMIT_BACKPRESSURED)
+        return csend_floor_wait (std::move (submitted.admitted));
+    throw std::runtime_error ("unexpected floor submit result");
+}
