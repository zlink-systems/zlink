+#define _GNU_SOURCE
+#include <pthread.h>
+#include <stdatomic.h>
+#include <unistd.h>
+static pthread_mutex_t mutex=PTHREAD_MUTEX_INITIALIZER;
+static atomic_int ready;
+__attribute__((noinline)) void marked(void) {pthread_mutex_lock(&mutex);pthread_mutex_unlock(&mutex);}
+static void *holder(void *unused) {(void)unused;pthread_mutex_lock(&mutex);atomic_store(&ready,1);usleep(50000);pthread_mutex_unlock(&mutex);return 0;}
+int main(int argc,char **argv) {
+ (void)argv;for(int i=0;i<100;i++)marked();
+ if(argc>1){pthread_t t;pthread_create(&t,0,holder,0);while(!atomic_load(&ready)){}marked();pthread_join(t,0);}return 0;
+}
