+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <link.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <errno.h>
+/* Measurement interposer. Only direct lock call sites within reply's symbol range count.
+   EBUSY from trylock distinguishes contention before paying for a timestamp. */
+static int (*real_lock)(pthread_mutex_t *);
+static int (*real_trylock)(pthread_mutex_t *);
+static uintptr_t low,high,base;
+static atomic_ullong calls,contended,wait_ns,errors;
+static int image_base(struct dl_phdr_info *info,size_t size,void *data) {
+ (void)size;(void)data;if (!info->dlpi_name || !*info->dlpi_name) {base=info->dlpi_addr;return 1;}return 0;
+}
+__attribute__((constructor)) static void init(void) {
+ real_lock=dlsym(RTLD_NEXT,"pthread_mutex_lock");real_trylock=dlsym(RTLD_NEXT,"pthread_mutex_trylock");
+ const char *range=getenv("CREPLY_LOCK_RANGE");if (!range)return;
+ unsigned long long a,b;if(sscanf(range,"%llx-%llx",&a,&b)!=2)abort();
+ dl_iterate_phdr(image_base,NULL);low=base+a;high=base+b;
+}
+static uint64_t ns(void) {struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);return (uint64_t)t.tv_sec*1000000000+t.tv_nsec;}
+int pthread_mutex_lock(pthread_mutex_t *mutex) {
+ uintptr_t caller=(uintptr_t)__builtin_return_address(0);
+ if (!low || caller<low || caller>=high)return real_lock(mutex);
+ atomic_fetch_add_explicit(&calls,1,memory_order_relaxed);
+ int rc=real_trylock(mutex);
+ if(!rc)return 0;
+ if(rc!=EBUSY){atomic_fetch_add_explicit(&errors,1,memory_order_relaxed);return rc;}
+ uint64_t begin=ns();rc=real_lock(mutex);uint64_t end=ns();
+ atomic_fetch_add_explicit(&contended,1,memory_order_relaxed);
+ atomic_fetch_add_explicit(&wait_ns,end-begin,memory_order_relaxed);
+ if(rc)atomic_fetch_add_explicit(&errors,1,memory_order_relaxed);return rc;
+}
+__attribute__((destructor)) static void done(void) {
+ if(!low)return;
+ const char *path=getenv("CREPLY_LOCK_OUTPUT");FILE *f=path?fopen(path,"w"):stderr;if(!f)return;
+ fprintf(f,"{\"calls\":%llu,\"contended\":%llu,\"wait_ns\":%llu,\"errors\":%llu,\"low\":%llu,\"high\":%llu}\n",
+ atomic_load(&calls),atomic_load(&contended),atomic_load(&wait_ns),atomic_load(&errors),(unsigned long long)low,(unsigned long long)high);
+ if(path)fclose(f);
+}
