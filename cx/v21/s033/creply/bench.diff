+#include "runtime/backend/raw_route_port.hpp"
+#include <zlink.hpp>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdio>
+#include <memory>
+#include <stdexcept>
+#include <string_view>
+#include <thread>
+#include <vector>
+using namespace std::chrono_literals;
+namespace backend = zlink::framework::detail::backend;
+static std::atomic<bool> entered{false}, released{false};
+static std::atomic<int> native_result{-999}, native_errno{0};
+extern "C" zlink_submit_result_t __real_zlink_reply(void *, const zlink_routing_id_t *, zlink_reply_token_t, zlink_msg_t *, size_t);
+extern "C" zlink_submit_result_t __wrap_zlink_reply(void *s, const zlink_routing_id_t *rid, zlink_reply_token_t token, zlink_msg_t *parts, size_t n)
+{
+    entered.store(true, std::memory_order_release);
+    while (!released.load(std::memory_order_acquire)) std::this_thread::yield();
+    const auto rc = __real_zlink_reply(s, rid, token, parts, n);
+    native_result.store(static_cast<int>(rc)); native_errno.store(errno);
+    return rc;
+}
+static bool ready(zlink::socket_monitor_t &monitor)
+{
+    zlink::poller_t p; p.add(monitor,zlink::poll_event_flag_t::pollin,1);
+    const auto end=std::chrono::steady_clock::now()+2s;
+    while(std::chrono::steady_clock::now()<end) {
+        zlink::poll_event_t e; p.wait(&e,1,10ms);
+        const auto event=monitor.recv(zlink::recv_flags_t::dontwait);
+        if(event && event->event==zlink::monitor_event::connection_ready)return true;
+    }
+    return false;
+}
+static std::vector<zlink::message_t> body()
+{
+    std::vector<zlink::message_t> p; p.push_back(zlink::message_t::from("reply"));return p;
+}
+int main(int argc,char **argv)
+{
+    const bool direct=argc>1 && std::string_view(argv[1])=="direct";
+    try {
+        zlink::context_t context;
+        zlink::router_socket_t source(context);
+        auto target=std::make_unique<zlink::router_socket_t>(context);
+        const auto sr=zlink::routing_id_t::from("creply-source"),tr=zlink::routing_id_t::from("creply-target");
+        source.set_routing_id(sr); target->set_routing_id(tr);
+        source.options().linger(0ms);target->options().linger(0ms);
+        target->bind("inproc://creply-close-probe");
+        auto monitor=source.monitor_open(zlink::monitor_event::connection_ready);
+        source.options().connect_routing_id(tr);source.connect("inproc://creply-close-probe");
+        if(!ready(monitor))throw std::runtime_error("route readiness failed");
+        monitor.close();
+        zlink::poller_t source_poller;source_poller.add(source,zlink::poll_event_flag_t::pollcompletion,1);
+        backend::raw_route_port_t port(*target);
+        auto request_part=zlink::message_t::from("request");
+        auto submission=source.request(tr).message(request_part).timeout(2s).async();
+        if(submission.result!=ZLINK_SUBMIT_OK)throw std::runtime_error("initial request not admitted");
+        std::optional<backend::raw_received_t> received;
+        const auto deadline=std::chrono::steady_clock::now()+2s;
+        while(!received && std::chrono::steady_clock::now()<deadline)
+            received=port.receive_if_ready(port.poll(10ms).value_or(zlink::poll_event_flag_t::none));
+        if(!received || !received->reply_token)throw std::runtime_error("request context missing");
+        std::atomic<bool> reply_ok{false},closed{false},reply_error{false},close_error{false};
+        std::thread sender([&] {
+            try { reply_ok.store(port.reply(*received,body())); }
+            catch(const std::exception &e) { std::fprintf(stderr,"reply: %s\n",e.what());reply_error=true; }
+        });
+        while(!entered.load(std::memory_order_acquire) && std::chrono::steady_clock::now()<deadline)std::this_thread::yield();
+        if(!entered) { released=true;sender.join();throw std::runtime_error("native reply not reached"); }
+        std::thread closer([&] {
+            try { port.close();target->close();target.reset();closed=true; }
+            catch(const std::exception &e) { std::fprintf(stderr,"close: %s\n",e.what());close_error=true; }
+        });
+        const auto observation=std::chrono::steady_clock::now()+200ms;
+        while(!closed && !close_error && std::chrono::steady_clock::now()<observation)std::this_thread::yield();
+        const bool close_during_submit=closed.load();
+        released=true;sender.join();closer.join();
+        const bool closed_reply=port.reply(*received,body());
+        context.shutdown();source_poller.close();source.close();
+        std::printf("{\"mode\":\"%s\",\"close_during_submit\":%s,\"reply_ok\":%s,\"native_result\":%d,\"native_errno\":%d,\"reply_error\":%s,\"close_error\":%s,\"reply_after_close\":%s}\n",direct?"direct":"main",close_during_submit?"true":"false",reply_ok?"true":"false",native_result.load(),native_errno.load(),reply_error?"true":"false",close_error?"true":"false",closed_reply?"true":"false");
+        if(reply_error || close_error || closed_reply)return 2;
+        if(direct)return close_during_submit && !reply_ok && native_result==static_cast<int>(zlink::submit_result_t::terminated)?0:3;
+        return !close_during_submit && reply_ok && native_result==static_cast<int>(zlink::submit_result_t::ok)?0:4;
+    } catch(const std::exception &e) {std::fprintf(stderr,"fixture: %s\n",e.what());return 5;}
+}
