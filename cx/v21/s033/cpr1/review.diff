+/* SPDX-License-Identifier: FSL-1.1-ALv2 */
+#pragma once
+#include "runtime/mesh/mesh_node_runtime.hpp"
+#include "runtime/messaging/request_failure_mapper.hpp"
+#include "runtime/messaging/submit_result_mapper.hpp"
+
+namespace zlink::framework::test
+{
+// Synthetic admission and physical-host events for the existing task-facade
+// regression scenarios. Production node requests never compose these tasks.
+using host_reply_fixture_t = result_t<runtime::messaging::message_parts_t>;
+inline host_reply_fixture_t rejected_host_submission (zlink::submit_result_t submitted)
+{
+    return host_reply_fixture_t::failure (
+      runtime::messaging::map_submit_result_error_kind (submitted), "fixture submission rejected");
+}
+inline result_t<host_reply_fixture_t>
+host_reply_fixture (const result_t<runtime::host::operation_completion_t> &result)
+{
+    if (!result)
+        return result_t<host_reply_fixture_t>::success (
+          detail::result_access_t::failure<runtime::messaging::message_parts_t> (
+            result.exception ()));
+    const auto &value = result.value ();
+    if (value.record.terminal_result != static_cast<int> (zlink::request_result_t::ok))
+        return result_t<host_reply_fixture_t>::success (
+          detail::result_access_t::failure<runtime::messaging::message_parts_t> (
+            runtime::messaging::request_failure_mapper_t{}.reply_header_exception (
+              static_cast<std::uint32_t> (value.record.terminal_result),
+              static_cast<std::uint32_t> (value.record.failure_errno), "fixture reply")));
+    return result_t<host_reply_fixture_t>::success (
+      host_reply_fixture_t::success (runtime::messaging::message_parts_t::borrow (value.parts)));
+}
+template <typename TPrepare, typename TAccepted>
+void compose_host_submission_fixture (task_t<zlink::submit_result_t> submission,
+                                      detail::request_receiver_t<host_reply_fixture_t> receiver,
+                                      TPrepare prepare,
+                                      TAccepted accepted)
+{
+    const auto *immediate =
+      submission.await_ready () ? &detail::task_result_access_t::read (submission) : nullptr;
+    if (immediate && (!*immediate || immediate->value () != zlink::submit_result_t::ok)) {
+        auto failure = *immediate
+                         ? rejected_host_submission (immediate->value ())
+                         : detail::result_access_t::failure<runtime::messaging::message_parts_t> (
+                             immediate->exception ());
+        receiver.admitted->complete (detail::result_access_t::failure<void> (failure.exception ()));
+        receiver.complete (result_t<host_reply_fixture_t>::success (std::move (failure)));
+        return;
+    }
+    // Pending/accepted submissions retain the earlier physical-failure observation.
+    prepare ();
+    auto deliver = [receiver = std::move (receiver), accepted = std::move (accepted)] (
+                     const result_t<zlink::submit_result_t> &submitted) mutable {
+        if (!submitted) {
+            receiver.admitted->complete (
+              detail::result_access_t::failure<void> (submitted.exception ()));
+            receiver.complete (
+              detail::result_access_t::failure<host_reply_fixture_t> (submitted.exception ()));
+            return;
+        }
+        if (submitted.value () != zlink::submit_result_t::ok) {
+            auto failure = rejected_host_submission (submitted.value ());
+            receiver.admitted->complete (
+              detail::result_access_t::failure<void> (failure.exception ()));
+            receiver.complete (result_t<host_reply_fixture_t>::success (std::move (failure)));
+            return;
+        }
+        receiver.admitted->complete (result_t<void>::success ());
+        accepted (std::move (receiver));
+    };
+    if (immediate)
+        deliver (*immediate);
+    else
+        // Preserve the suspended admission's existing resume/cancellation owner.
+        detail::observe_task_completion (submission, std::move (deliver));
+}
+
+inline void compose_host_reply_fixture (detail::mesh_node_runtime_t &node,
+                                        runtime::host::pending_operation_t operation,
+                                        task_t<zlink::submit_result_t> submission,
+                                        detail::request_receiver_t<host_reply_fixture_t> receiver)
+{
+    const auto admitted = receiver.admitted;
+    compose_host_submission_fixture (
+      std::move (submission), std::move (receiver),
+      [&node, operation, admitted] {
+          node.observe_request_failure (operation, admitted, "MeshNode request");
+      },
+      [operation] (detail::request_receiver_t<host_reply_fixture_t> receiver) mutable {
+          auto completion = operation.completion->task ();
+          detail::observe_task_terminal (
+            completion, [receiver = std::move (receiver)] (const auto &result) mutable {
+                receiver.complete (host_reply_fixture (result));
+            });
+      });
+}
+
+} // namespace zlink::framework::test
