+        if (strong.fetch_sub (1, std::memory_order_acq_rel) == 1) {
+            destroy (this);
+            release_weak ();
+        }
+    }
+};
+
+template <typename T> class task_weak_t;
+template <typename T> class task_ptr_t
+{
+  public:
+    task_ptr_t () noexcept = default;
+    task_ptr_t (std::nullptr_t) noexcept {}
+    task_ptr_t (task_control_t *control, T *value) noexcept : _control (control), _value (value)
+    {
+        if (_control)
+            _control->retain ();
+    }
+    template <typename U>
+    task_ptr_t (const task_ptr_t<U> &owner, T *value) noexcept :
+        task_ptr_t (owner.control (), value)
+    {
+    }
+    task_ptr_t (const task_ptr_t &other) noexcept : task_ptr_t (other._control, other._value) {}
+    template <typename U>
+        requires std::is_convertible_v<U *, T *>
+    task_ptr_t (const task_ptr_t<U> &other) noexcept : task_ptr_t (other.control (), other.get ())
+    {
+    }
+    task_ptr_t (task_ptr_t &&other) noexcept :
+        _control (std::exchange (other._control, nullptr)),
+        _value (std::exchange (other._value, nullptr))
+    {
+    }
+    template <typename U>
+        requires std::is_convertible_v<U *, T *>
+    task_ptr_t (task_ptr_t<U> &&other) noexcept : _control (other.control ()), _value (other.get ())
+    {
+        other.detach ();
+    }
+    ~task_ptr_t ()
+    {
+        if (_control)
+            _control->release ();
+    }
+    task_ptr_t &operator= (task_ptr_t other) noexcept
+    {
+        std::swap (_control, other._control);
+        std::swap (_value, other._value);
+        return *this;
+    }
+    void reset () noexcept { *this = {}; }
+    T *get () const noexcept { return _value; }
+    T *operator->() const noexcept { return _value; }
+    std::add_lvalue_reference_t<T> operator* () const noexcept
+        requires (!std::is_void_v<T>)
+    {
+        return *_value;
+    }
+    explicit operator bool () const noexcept { return _value != nullptr; }
+    std::size_t use_count () const noexcept
+    {
+        return _control ? _control->strong.load (std::memory_order_relaxed) : 0;
+    }
+    task_control_t *control () const noexcept { return _control; }
+    void detach () noexcept
+    {
+        _control = nullptr;
+        _value = nullptr;
+    }
+    template <typename U> bool operator== (const task_ptr_t<U> &other) const noexcept
+    {
+        return _value == other.get ();
+    }
+    bool operator== (std::nullptr_t) const noexcept { return !_value; }
+
+  private:
+    task_control_t *_control = nullptr;
+    T *_value = nullptr;
+    friend class task_weak_t<T>;
+};
+
+template <typename T> class task_weak_t
+{
+  public:
+    task_weak_t () noexcept = default;
+    template <typename U>
+        requires std::is_convertible_v<U *, T *>
+    task_weak_t (const task_ptr_t<U> &owner) noexcept :
+        _control (owner.control ()), _value (owner.get ())
+    {
+        if (_control)
+            _control->retain_weak ();
+    }
+    task_weak_t (const task_weak_t &other) noexcept :
+        _control (other._control), _value (other._value)
+    {
+        if (_control)
+            _control->retain_weak ();
+    }
+    template <typename U>
+        requires std::is_convertible_v<U *, T *>
+    task_weak_t (const task_weak_t<U> &other) noexcept :
+        _control (other.control ()), _value (other.get ())
+    {
+        if (_control)
+            _control->retain_weak ();
+    }
+    task_weak_t (task_weak_t &&other) noexcept :
+        _control (std::exchange (other._control, nullptr)),
+        _value (std::exchange (other._value, nullptr))
+    {
+    }
+    ~task_weak_t ()
+    {
+        if (_control)
+            _control->release_weak ();
+    }
+    task_weak_t &operator= (task_weak_t other) noexcept
+    {
+        std::swap (_control, other._control);
+        std::swap (_value, other._value);
+        return *this;
+    }
+    task_ptr_t<T> lock () const noexcept
+    {
+        if (!_control || !_control->try_retain ())
+            return {};
+        task_ptr_t<T> result;
+        result._control = _control;
+        result._value = _value;
+        return result;
+    }
+    bool expired () const noexcept
+    {
+        return !_control || _control->strong.load (std::memory_order_acquire) == 0;
+    }
+    void reset () noexcept { *this = {}; }
+    task_control_t *control () const noexcept { return _control; }
+    T *get () const noexcept { return _value; }
+
+  private:
+    task_control_t *_control = nullptr;
+    T *_value = nullptr;
+};
