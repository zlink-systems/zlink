+// Native result ownership is created outside measurement. An empty ready reply
+// isolates the Framework observer frame and its final receiver from native payload allocation.
+class empty_reply_probe_t final
+    : public zlink::detail::async_result_state_t<std::vector<zlink::message_t>>
+{
+  public:
+    bool ready () const noexcept override { return true; }
+    bool suspend (std::coroutine_handle<>, zlink::detail::async_continuation_scheduler_t) override
+    {
+        return false;
+    }
+    std::vector<zlink::message_t> take () override
+    {
+        ++consumed;
+        return {};
+    }
+    void detach () noexcept override {}
+    void abandon (std::coroutine_handle<>) noexcept override {}
+    int consumed = 0;
+};
+
+class pending_reply_probe_t final
+    : public zlink::detail::async_result_state_t<std::vector<zlink::message_t>>
+{
+  public:
+    bool ready () const noexcept override { return false; }
+    bool suspend (std::coroutine_handle<> continuation,
+                  zlink::detail::async_continuation_scheduler_t) override
+    {
+        handle = continuation;
+        return true;
+    }
+    std::vector<zlink::message_t> take () override
+    {
+        ++consumed;
+        return {};
+    }
+    void detach () noexcept override {}
+    void abandon (std::coroutine_handle<>) noexcept override {}
+    void deliver () { std::exchange (handle, {}).resume (); }
+    std::coroutine_handle<> handle;
+    int consumed = 0;
+};
