+// The allocator replaces per-state make_shared storage. Growth is unbounded;
+// free storage is reusable only after strong and weak lifetime references end.
+inline std::pmr::synchronized_pool_resource &task_storage_pool ()
+{
+    // Larger allocations go to the resource's upstream allocator. This is an
+    // allocator size class boundary, never a limit on tasks or observers.
+    // Result views may remain in globals created before this allocator. The
+    // process owns the pool; host shutdown and static destruction cannot retire it.
+    static auto *storage = new std::pmr::synchronized_pool_resource (
+      std::pmr::pool_options{0, 65536}, std::pmr::new_delete_resource ());
+    return *storage;
+}
+
+// Codec views and public observer registration can allocate concurrently.
+// This lock protects allocation only; the task mutex alone publishes results
+// and links observers. Neither lock grants a handler execution turn.
+class task_memory_resource_t final : public std::pmr::memory_resource
+{
+  public:
+    task_memory_resource_t (void *buffer, std::size_t size) :
+        _arena (buffer, size, std::pmr::new_delete_resource ())
+    {
+    }
+
+  private:
+    void *do_allocate (std::size_t size, std::size_t alignment) override
+    {
+        std::lock_guard lock (_mutex);
+        return _arena.allocate (size, alignment);
+    }
+    void do_deallocate (void *, std::size_t, std::size_t) override {}
+    bool do_is_equal (const std::pmr::memory_resource &other) const noexcept override
+    {
+        return this == &other;
+    }
+    std::mutex _mutex;
+    std::pmr::monotonic_buffer_resource _arena;
+};
+
+template <typename T, std::size_t InlineBytes = 512> struct task_allocation_t final : task_control_t
+{
+    task_allocation_t () {}
+    std::pmr::memory_resource *allocation_resource;
+    task_synchronization_t sync;
+    alignas (std::max_align_t) std::array<std::byte, InlineBytes> buffer;
+    task_memory_resource_t arena{buffer.data (), buffer.size ()};
+    alignas (T) std::byte value[sizeof (T)];
+};
+
+template <typename T, std::size_t InlineBytes = 512, typename... Args>
+task_ptr_t<T> allocate_task_owner (std::pmr::memory_resource &memory, Args &&...args)
+{
+    using allocation_t = task_allocation_t<T, InlineBytes>;
+    auto &pool = memory;
+    auto *block =
+      static_cast<allocation_t *> (pool.allocate (sizeof (allocation_t), alignof (allocation_t)));
+    try {
+        std::construct_at (block);
+    }
+    catch (...) {
+        pool.deallocate (block, sizeof (allocation_t), alignof (allocation_t));
+        throw;
+    }
+    block->destroy = [] (task_control_t *owner) noexcept {
+        std::destroy_at (reinterpret_cast<T *> (static_cast<allocation_t *> (owner)->value));
+    };
+    block->deallocate = [] (task_control_t *owner) noexcept {
+        auto *block = static_cast<allocation_t *> (owner);
+        auto *resource = block->allocation_resource;
+        std::destroy_at (block);
+        resource->deallocate (block, sizeof (allocation_t), alignof (allocation_t));
+    };
+    block->allocation_resource = &memory;
+    block->synchronization = &block->sync;
+    block->resource = &block->arena;
+    T *value;
+    try {
+        value =
+          std::construct_at (reinterpret_cast<T *> (block->value), std::forward<Args> (args)...);
+    }
+    catch (...) {
+        block->deallocate (block);
+        throw;
+    }
+    if constexpr (requires { value->bind_task_owner (block); })
+        value->bind_task_owner (block);
+    task_ptr_t<T> result (block, value);
+    block->release ();
+    return result;
+}
+
+template <typename T, typename... Args> task_ptr_t<T> make_task_owner (Args &&...args)
+{
+    return allocate_task_owner<T> (*std::pmr::new_delete_resource (), std::forward<Args> (args)...);
+}
+
+// Public shared completion-source wrappers place their required standard
+// control block in the same allocation as their intrusive result owner.
+// Its weak allocator lifetime outlasts source disposal and every weak wrapper.
+template <typename T> struct task_arena_allocator_t
+{
+    using value_type = T;
+    explicit task_arena_allocator_t (task_control_t *owner) :
+        owner (task_ptr_t<void> (owner, nullptr))
+    {
+    }
+    template <typename U>
+    task_arena_allocator_t (const task_arena_allocator_t<U> &other) : owner (other.owner)
+    {
+    }
+    T *allocate (std::size_t count)
+    {
+        return static_cast<T *> (
+          owner.control ()->resource->allocate (count * sizeof (T), alignof (T)));
+    }
+    void deallocate (T *, std::size_t) noexcept {}
+    template <typename U> bool operator== (const task_arena_allocator_t<U> &other) const noexcept
+    {
+        return owner.control () == other.owner.control ();
+    }
+    task_weak_t<void> owner;
+};
+
+// Observer nodes use their task owner's arena. Their own references replace
+// the former observer control block; a weak parent keeps the arena allocated
+// without creating a state -> observer -> state ownership cycle.
+template <typename T> struct task_observer_allocation_t final : task_control_t
+{
+    task_observer_allocation_t () {}
+    task_weak_t<void> parent;
+    alignas (T) std::byte value[sizeof (T)];
+};
+template <typename T, typename... Args>
+task_ptr_t<T> make_task_observer (task_control_t *parent, Args &&...args)
+{
+    using allocation_t = task_observer_allocation_t<T>;
+    auto *block = static_cast<allocation_t *> (
+      parent->resource->allocate (sizeof (allocation_t), alignof (allocation_t)));
+    std::construct_at (block);
+    block->parent = task_ptr_t<void> (parent, nullptr);
+    block->synchronization = parent->synchronization;
+    block->resource = parent->resource;
+    block->destroy = [] (task_control_t *owner) noexcept {
+        std::destroy_at (reinterpret_cast<T *> (static_cast<allocation_t *> (owner)->value));
+    };
+    block->deallocate = [] (task_control_t *owner) noexcept {
+        std::destroy_at (static_cast<allocation_t *> (owner));
+    };
+    T *value;
+    try {
+        value =
+          std::construct_at (reinterpret_cast<T *> (block->value), std::forward<Args> (args)...);
+    }
+    catch (...) {
+        block->deallocate (block);
+        throw;
+    }
+    task_ptr_t<T> result (block, value);
+    block->release ();
+    return result;
+}
