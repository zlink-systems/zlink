+ try {
+  output->reply.emplace(co_await std::move(native));
+  if (output->reply->empty()) throw std::runtime_error("cfloor empty native reply");
+ } catch (...) {
+  output->failure = std::current_exception();
+ }
+ signal->notify(slot);
+}
+fw::detail::cfloor::detached_t cfloor_observe_admitted(
+  zlink::async_result_t<void> native,
+  std::shared_ptr<cfloor_admission_state_t> output,
+  std::shared_ptr<completion_signal_t> signal, size_t slot) {
+ try {
+  co_await std::move(native);
+ } catch (...) {
+  output->failure = std::current_exception();
+ }
+ output->ready.store(true, std::memory_order_release);
+ signal->notify(slot);
+}
