+                    preceding_admission->ready.store(false, std::memory_order_relaxed);
+                    cfloor_observe_admitted(std::move(submission.admitted), preceding_admission,
+                                            completion_signal, admission_notification);
+                } else if (submission.result == ZLINK_SUBMIT_OK) {
