--- /dev/null
+++ b/framework/languages/cpp/framework/include/zlink/framework/detail/cfloor_measurement.hpp
@@ -0,0 +1,55 @@
+#pragma once
+// Temporary caller-floor experiment. No production contract is preserved.
+#include <zlink.hpp>
+#include <zlink/framework/contracts/codecs/serializer.hpp>
+#include <zlink/framework/contracts/dispatch/request_task.hpp>
+#include <cstdlib>
+#include <cstdio>
+#include <atomic>
+#include <coroutine>
+#include <functional>
+namespace zlink::framework::detail::cfloor {
+inline const int variant = [] { const char *v = std::getenv("ZLINK_CFLOOR_VARIANT"); return v ? std::atoi(v) : 0; }();
+inline std::atomic<bool> enabled{false};
+inline std::atomic<bool> capture{false};
+inline std::function<zlink::request_submission_t ()> binding_request;
+struct native_request_t {
+ zlink::router_socket_t *socket;
+ zlink::routing_id_t target;
+ std::vector<zlink::message_t> prepared;
+ std::chrono::milliseconds timeout;
+ zlink::request_submission_t operator()() {
+  auto operation = socket->request(target).message(zlink::message_t(prepared.front()));
+  for (std::size_t index=1; index<prepared.size(); ++index)
+   operation = std::move(operation).message(zlink::message_t(prepared[index]));
+  return std::move(operation).timeout(timeout).async();
+ }
+};
+struct detached_t {
+ struct promise_type {
+  detached_t get_return_object() noexcept { return {}; }
+  std::suspend_never initial_suspend() noexcept { return {}; }
+  std::suspend_never final_suspend() noexcept { return {}; }
+  void return_void() noexcept {}
+  void unhandled_exception() noexcept { std::terminate(); }
+  task_scheduler_t zlink_continuation_scheduler() const { return {}; }
+ };
+};
+inline detached_t deliver_binding_reply(request_receiver_t<encoded_payload_t> receiver) {
+ try {
+  auto submission = binding_request();
+  if (submission.result == ZLINK_SUBMIT_BACKPRESSURED)
+   co_await std::move(submission.admitted);
+  else if (submission.result != ZLINK_SUBMIT_OK)
+   throw std::runtime_error("cfloor binding submission failed");
+  receiver.admitted->complete(result_t<void>::success());
+  auto parts = co_await std::move(submission.reply);
+  if (parts.empty()) throw std::runtime_error("cfloor empty native reply");
+  receiver.complete(result_t<encoded_payload_t>::success(encoded_payload_t{}));
+ } catch (...) {
+  auto failure = current_exception_result<encoded_payload_t>();
+  receiver.admitted->complete(result_access_t::failure<void>(failure.exception()));
+  receiver.complete(failure);
+ }
+}
