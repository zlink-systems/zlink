+// Temporary V2/V3 native observers. Results live in stable driver slots;
+// no Framework task state, request_task, or receiver is created.
+struct cfloor_admission_state_t {
+ std::atomic<bool> ready{true};
+ std::exception_ptr failure;
+};
+template <typename TSlot>
+fw::detail::cfloor::detached_t cfloor_observe_reply(
+  zlink::async_result_t<std::vector<zlink::message_t>> native, TSlot *output,
+  std::shared_ptr<void> slot_lifetime,
+  std::shared_ptr<completion_signal_t> signal, size_t slot) {
