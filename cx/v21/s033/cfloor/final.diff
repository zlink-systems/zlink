+                counters.enter ();
+                counters.submitted.fetch_add (1, std::memory_order_relaxed);
+                size_t slot = 0;
+                if (free_slots.empty ()) {
+                    slot = pending.size ();
+                    pending.emplace_back (std::nullopt);
+                } else {
+                    slot = free_slots.back ();
+                    free_slots.pop_back ();
+                }
+                auto submission = fw::detail::cfloor::variant == 2
+                  ? _client->request_to_node("bench", _target_node, std::move(payload))
+                      .timeout(std::chrono::milliseconds(_options.request_timeout_ms)).cfloor_async()
+                  : fw::detail::cfloor::binding_request();
