diff --git a/framework/languages/cpp/tests/Zlink.Framework.UnitTests/test_cpp_framework_independent_node_records.cpp b/framework/languages/cpp/tests/Zlink.Framework.UnitTests/test_cpp_framework_independent_node_records.cpp
new file mode 100644
--- /dev/null
+++ b/framework/languages/cpp/tests/Zlink.Framework.UnitTests/test_cpp_framework_independent_node_records.cpp
@@ -0,0 +1,172 @@
+/* SPDX-License-Identifier: LicenseRef-zlink-License-1.0 */
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "runtime/mesh/service_mailbox.hpp"
+#include "runtime/dispatch/offload_executor.hpp"
+#include <array>
+#include <barrier>
+#include <cassert>
+#include <cstring>
+#include <iostream>
+#include <future>
+#include <thread>
+
+namespace zlink::framework::runtime
+{
+struct offload_executor_test_access_t
+{
+    static bool idle (offload_executor_t &executor)
+    {
+        std::lock_guard lock (executor._mutex);
+        return executor._idle_workers == 2 && executor._queue.empty ();
+    }
+    static void publish_with_older_work (offload_executor_t &executor,
+                                         std::function<void ()> older,
+                                         std::atomic_size_t &pending)
+    {
+        {
+            std::lock_guard lock (executor._mutex);
+            executor._queue.push (offload_executor_t::work_item_t{std::move (older), std::nullopt});
+            pending = 1;
+            assert (executor.schedule_application_locked () == 0);
+        }
+        executor._ready.notify_one ();
+    }
+};
+}
+
+namespace mesh = zlink::framework::runtime::mesh;
+using domain_t = mesh::service_mailbox_domain_t;
+
+static void enqueue (mesh::service_mailbox_t &mailbox, const std::string &owner,
+                     std::uint32_t value)
+{
+    mesh::service_mailbox_record_t record;
+    record.owner = owner;
+    record.domain = domain_t::application;
+    record.parts.push_back (zlink::message_t::from (std::as_bytes (std::span (&value, 1))));
+    assert (mailbox.try_enqueue (std::move (record)));
+}
+
+static void verify_idle_worker_after_older_reservation ()
+{
+    namespace runtime = zlink::framework::runtime;
+    using namespace std::chrono_literals;
+    std::atomic_size_t pending{0};
+    std::promise<void> release, entered;
+    auto released = release.get_future ().share ();
+    auto node_entered = entered.get_future ();
+    runtime::offload_executor_t executor (2);
+    executor.bind_application_work ([&] (std::size_t reserved, bool) {
+        if (pending.load () <= reserved)
+            return std::function<void ()>{};
+        return std::function<void ()> ([&] {
+            if (pending.exchange (0) != 0)
+                entered.set_value ();
+        });
+    });
+    const auto deadline = std::chrono::steady_clock::now () + 5s;
+    while (!runtime::offload_executor_test_access_t::idle (executor)) {
+        assert (std::chrono::steady_clock::now () < deadline);
+        std::this_thread::yield ();
+    }
+    // The older reservation covers one idle worker when the Node is published.
+    // Once it is popped, the other idle worker must see the ready Node before
+    // the older handler returns. Waiting for handler completion would lose a wake.
+    runtime::offload_executor_test_access_t::publish_with_older_work (
+      executor, [released] { released.wait (); }, pending);
+    const bool independent = node_entered.wait_for (5s) == std::future_status::ready;
+    release.set_value ();
+    executor.drain ();
+    executor.bind_application_work ({});
+    std::cout << "idle_worker_progress_while_older_work_blocked=" << independent << std::endl;
+    assert (independent);
+}
+
+int main ()
+{
+    // Both workers retain their first record until both claims have been attempted.
+    // The serial implementation fails here without deadlocking the test.
+    mesh::service_mailbox_t mailbox;
+    enqueue (mailbox, "node", 0);
+    enqueue (mailbox, "node", 1);
+    std::barrier together (2);
+    std::array<std::shared_ptr<mesh::service_mailbox_claim_t>, 2> first;
+    std::array<std::thread, 2> pair;
+    for (std::size_t worker = 0; worker != pair.size (); ++worker)
+        pair[worker] = std::thread ([&, worker] {
+            first[worker] = mailbox.try_claim_owner (domain_t::application, "node", 1, 4096);
+            together.arrive_and_wait ();
+        });
+    for (auto &worker : pair)
+        worker.join ();
+    assert (first[0] && first[1]);
+    assert (first[0]->records.front () != first[1]->records.front ());
+    auto cut = mailbox.cut_owners ({"node"}, [] (const auto &) { return true; }, [] {});
+    assert (cut && cut->front ().empty ()); // Both originals have already left the FIFO.
+    // Out-of-order terminal and close must not erase another claim's FIFO nodes.
+    mailbox.close ();
+    auto second_record = mailbox.take ({first[1], 0});
+    assert (second_record && second_record->transferred ());
+    assert (!second_record->transferred ());
+    assert (mailbox.release (*first[0]));
+    assert (!mailbox.release (*first[0]));
+    assert (first[0]->outstanding () == 0 && first[1]->outstanding () == 0);
+
+    // An untaken original must not keep its owning claim alive through its own
+    // settlement callback, including after the mailbox has gone away.
+    std::weak_ptr<mesh::service_mailbox_claim_t> abandoned;
+    {
+        mesh::service_mailbox_t closing;
+        enqueue (closing, "node", 0);
+        auto claim = closing.try_claim_owner (domain_t::application, "node", 1, 4096);
+        abandoned = claim;
+        closing.close ();
+    }
+    assert (abandoned.expired ());
+
+    constexpr std::size_t records = 4096;
+    mesh::service_mailbox_t concurrent;
+    for (std::uint32_t value = 0; value != records; ++value)
+        enqueue (concurrent, "node", value);
+    std::array<std::atomic_uint, records> seen{};
+    std::array<std::thread, 4> workers;
+    for (auto &worker : workers)
+        worker = std::thread ([&] {
+            while (auto claim = concurrent.try_claim_owner (domain_t::application, "node", 1, 4096)) {
+                auto record = concurrent.take ({claim, 0});
+                assert (record);
+                std::uint32_t value;
+                std::memcpy (&value, record->parts.front ().data (), sizeof (value));
+                assert (value < records && seen[value].fetch_add (1) == 0);
+                assert (!concurrent.take ({claim, 0}));
+                assert (record->transferred ());
+            }
+        });
+    for (auto &worker : workers)
+        worker.join ();
+    for (const auto &count : seen)
+        assert (count.load () == 1);
+    assert (concurrent.pending_messages (domain_t::application) == 0);
+    assert (concurrent.pending_bytes (domain_t::application) == 0);
+
+    // A gated Actor retains the head claim through its terminal. The second
+    // application worker cannot enter the next record while that claim is live.
+    mesh::service_mailbox_t actor;
+    const auto owner = mesh::service_mailbox_t::application_owner (
+      zlink::framework::runtime::host::owner_kind_t::actor, "one");
+    enqueue (actor, owner, 0);
+    enqueue (actor, owner, 1);
+    auto active = actor.try_claim_owner (domain_t::application, owner, 1, 4096);
+    assert (active);
+    std::thread waiting ([&] {
+        assert (!actor.try_claim_owner (domain_t::application, owner, 1, 4096));
+    });
+    waiting.join ();
+    assert (actor.release (*active));
+    auto next = actor.try_claim_owner (domain_t::application, owner, 1, 4096);
+    assert (next && actor.release (*next));
+    verify_idle_worker_after_older_reservation ();
+    std::cout << "independent Node claims, 4096 exclusive records, close and gated Actor passed\n";
+}
