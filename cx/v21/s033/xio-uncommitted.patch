+class submission_pacer_t
+{
+  public:
+    explicit submission_pacer_t (double rate) : _rate (rate) {}
+
+    bool wait_until (clock_t_::time_point deadline)
+    {
+        if (_rate <= 0)
+            return clock_t_::now () < deadline;
+        const auto interval = std::chrono::duration_cast<clock_t_::duration> (
+          std::chrono::duration<double> (1.0 / _rate));
+        const auto now = clock_t_::now ();
+        const auto scheduled = std::max (now, _next);
+        if (scheduled >= deadline)
+            return false;
+        std::this_thread::sleep_until (scheduled);
+        if (clock_t_::now () >= deadline)
+            return false;
+        _next = scheduled + interval;
+        return true;
+    }
+
+  private:
+    double _rate;
+    clock_t_::time_point _next{};
+};
