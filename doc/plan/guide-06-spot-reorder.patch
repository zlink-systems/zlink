+    // 첫 인자가 대상 Spot instance다.
+    public final class JoinQueueHandler implements ZLinkSpotPacketHandler<Matchmaker, JoinQueue> {
+        @Override
+        public CompletionStage<Void> handle(Matchmaker spot, JoinQueue message) {
+            spot.enqueue(message.playerId()); // 락 없이 직접 만진다.
+            return CompletableFuture.completedFuture(null);
+        }
+    }
+    ```
+
