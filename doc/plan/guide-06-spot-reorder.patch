-## 1. 세 가지 Spot
+## 1. 먼저 하나 돌려본다
+
+Spot은 상태를 가진 실행 단위다. 그 Spot 앞으로 보낸 메시지는 **한 번에 하나씩 상태 옆에서**
+실행되므로, handler 안에서 상태를 락 없이 직접 고친다.
+
+제일 짧은 형태를 먼저 만든다. **클래스 하나 · 등록 한 번 · 메시지 한 번**이면 끝난다.
+lifecycle callback은 기본 구현이 있으므로 지금은 적지 않는다.
+
+### 1.1 Spot과 handler
+
+상태를 담을 클래스를 만들고, 구성 단계에서 이 Spot이 받을 handler를 등록한다.
+
+=== "C#/.NET"
+
+    ```csharp
+    public sealed class Matchmaker(IZLinkInstanceSpotContext context) : IZLinkInstanceSpot
+    {
+        private readonly List<string> _waiting = [];
+
+        public IZLinkInstanceSpotContext Context { get; } = context;
+
+        // 이 Spot이 받을 handler를 등록한다.
+        public void Configure() => Context.Handlers.AddPacket<JoinQueueHandler>();
+
+        public void Enqueue(string playerId) => _waiting.Add(playerId);
+    }
+
+    // 첫 인자가 대상 Spot instance다.
+    public sealed class JoinQueueHandler : IZLinkSpotPacketHandler<Matchmaker, JoinQueue>
+    {
+        public ValueTask HandleAsync(
+            Matchmaker spot,
+            JoinQueue message,
+            CancellationToken cancellationToken)
+        {
+            spot.Enqueue(message.PlayerId); // 락 없이 직접 만진다.
+            return ValueTask.CompletedTask;
+        }
+    }
+    ```
+
+=== "C++"
+
+    ```cpp
+    // C++은 handler class 대신 Spot member 함수를 등록한다.
+    class matchmaker_t : public instance_spot_t
+    {
+      public:
+        explicit matchmaker_t (instance_spot_context_t context)
+            : _context (std::move (context))
+        {
+        }
+
+        instance_spot_context_t &context () noexcept override { return _context; }
+        const instance_spot_context_t &context () const noexcept override { return _context; }
+
+        // 이 Spot이 받을 handler를 등록한다.
+        void configure () override
+        {
+            _context.handlers ().add_handler<&matchmaker_t::join_queue> ();
+        }
+
+        task_t<void> join_queue (const join_queue_t &message)
+        {
+            _waiting.push_back (message.player_id); // 락 없이 직접 만진다.
+            co_return;
+        }
+
+      private:
+        instance_spot_context_t _context;
+        std::vector<std::string> _waiting;
+    };
+    ```
+
+=== "Java"
+
+    ```java
+    public final class Matchmaker implements ZLinkInstanceSpot {
+        private final ZLinkInstanceSpotContext context;
+        private final List<String> waiting = new ArrayList<>();
+
+        public Matchmaker(ZLinkInstanceSpotContext context) {
+            this.context = context;
+        }
