<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../server/Server/Zlink.NetworkSync.Server.csproj" />
    <!-- Compile the UPM runtime sources against the same released connector the server uses. -->
    <Compile Include="../../connector/unity/com.zlink.network-sync/Runtime/*.cs" Link="Unity/%(Filename)%(Extension)" />
    <PackageReference Include="Zlink.Stream.Connector" Version="0.34.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Zlink.Framework.AspNetCore" Version="0.34.1" />
    <PackageReference Include="Zlink.Framework.Locations.Redis" Version="0.34.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" PrivateAssets="all" />
  </ItemGroup>
</Project>
