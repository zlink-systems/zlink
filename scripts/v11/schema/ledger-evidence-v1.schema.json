{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zlink-v11-ledger-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledgerId", "status", "sourceRevision", "candidateManifestSha256", "ownedPathManifestSha256", "commands", "completedAt"],
  "properties": {
    "schema": { "const": "zlink-v11-ledger-evidence-v1" },
    "ledgerId": { "type": "string", "minLength": 1 },
    "status": { "const": "passed" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
    "ownedPathManifestSha256": { "$ref": "#/$defs/sha256" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "exitCode", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "required": { "const": true }
        }
      }
    },
    "completedAt": { "type": "string", "format": "date-time" },
    "details": { "type": "object" },
    "issues": { "type": "array" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
